{%- comment -%}
  Combo PDP ingredients: one pill tab per entry.

  Data: product.metafields.custom.combo_ingredient_tabs → list of "Combo Ingredient Tab" metaobjects
    label   → single line text (pill text, e.g. "Face Wash")
    content → rich text; headings / bold = ingredient group name, paragraphs = details

  Falls back to the plain 'product-ingredients' list when the product has no tabs.

  {% render 'product-ingredients-tabs' %}
{%- endcomment -%}

{%- assign tabs = product.metafields.custom.combo_ingredient_tabs.value -%}

{%- if tabs == blank -%}
  {% render 'product-ingredients' %}
{%- else -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700&display=swap">

  <div class="ing-tabs" x-data="{ tab: 0 }">
    <div class="ing-tabs__nav" role="tablist">
      {%- for item in tabs -%}
        <button
          type="button"
          role="tab"
          class="ing-tabs__pill{% if forloop.first %} is-active{% endif %}"
          id="ing-tab-{{ item.id }}"
          aria-controls="ing-panel-{{ item.id }}"
          aria-selected="{{ forloop.first }}"
          :class="{ 'is-active': tab === {{ forloop.index0 }} }"
          :aria-selected="tab === {{ forloop.index0 }}"
          @click="tab = {{ forloop.index0 }}"
        >
          {{- item.label.value | default: forloop.index -}}
        </button>
      {%- endfor -%}
    </div>

    {%- for item in tabs -%}
      <div
        class="ing-tabs__panel"
        role="tabpanel"
        id="ing-panel-{{ item.id }}"
        aria-labelledby="ing-tab-{{ item.id }}"
        {% unless forloop.first %}hidden{% endunless %}
        :hidden="tab !== {{ forloop.index0 }}"
      >
        {{ item.content | metafield_tag }}
      </div>
    {%- endfor -%}
  </div>

  <style>
    .ing-tabs__nav { display: flex; gap: 6px; margin-bottom: 14px; overflow-x: auto; scrollbar-width: none; }
    .ing-tabs__nav::-webkit-scrollbar { display: none; }
    .ing-tabs__pill {
      flex: 0 0 auto; min-width: 110px; height: 30px; margin: 0; padding: 5px 14px;
      border: 1px solid #28201f; border-radius: 30px; background: #fff; color: #78563d;
      font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: -0.24px;
      line-height: 1; text-transform: uppercase; white-space: nowrap; cursor: pointer; transition: background .2s, color .2s;
    }
    .ing-tabs__pill.is-active { border-color: #78563d; background: #78563d; color: #fff; font-weight: 500; }
    .ing-tabs__panel[hidden] { display: none; }

    /* rich text: paragraphs = details, headings / bold = group names */
    .ing-tabs__panel { font-family: 'Blauer Nue LT', sans-serif; font-weight: 300; font-size: 12px; line-height: 1.3; letter-spacing: -0.24px; color: rgba(40, 32, 31, 0.8); }
    /* .ing-tabs prefix outranks the description block's .rte p / .rte h* margins */
    .ing-tabs .ing-tabs__panel > * { margin: 0 0 12px; font-size: inherit; }
    .ing-tabs .ing-tabs__panel > *:last-child { margin-bottom: 0; }
    /* blank lines typed in the rich text editor save as empty paragraphs */
    .ing-tabs .ing-tabs__panel > p:empty,
    .ing-tabs .ing-tabs__panel > p:has(> br:only-child) { display: none; }
    .ing-tabs__panel :is(h1, h2, h3, h4, h5, h6),
    .ing-tabs__panel strong, .ing-tabs__panel b {
      font-family: 'Blauer Nue MD', sans-serif; font-weight: 500; font-size: 12px; line-height: normal; letter-spacing: -0.24px; color: #28201f; text-transform: none;
    }
    /* a heading or a bold-only line sits tight above its detail line */
    .ing-tabs .ing-tabs__panel > :is(h1, h2, h3, h4, h5, h6),
    .ing-tabs .ing-tabs__panel > p:has(> :is(strong, b):only-child) { margin: 0 0 4px; }
    .ing-tabs__panel ul, .ing-tabs__panel ol { padding-left: 18px; }
    .ing-tabs__panel a { color: #78563d; text-decoration: underline; }

    @media (min-width: 750px) {
      .ing-tabs__panel, .ing-tabs__panel :is(h1, h2, h3, h4, h5, h6), .ing-tabs__panel strong, .ing-tabs__panel b { font-size: 13px; }
    }
  </style>
{%- endif -%}
