{% if product.metafields.custom.product_benefit.value != blank %}
  <div class="benefits-strip">
    {% for benefit in product.metafields.custom.product_benefit.value %}
      <div class="benefit-item">
        <!-- Icon -->
        <span class="benefit-icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="9" cy="9" r="8.5" stroke="#28201F"/>
                <g clip-path="url(#clip0_327_122)">
                <path d="M11.5714 7.07178L8.03573 10.6075L6.42859 9.00035" stroke="#28201F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </g>
                <defs>
                <clipPath id="clip0_327_122">
                <rect width="7.71429" height="7.71429" fill="white" transform="translate(5.14288 5.14307)"/>
                </clipPath>
                </defs>
            </svg>
        </span>
        <!-- Text -->
        <span class="benefit-text">
          {{ benefit }}
        </span>
      </div>
    {% endfor %}
  </div>
{% endif %}
<style>
.benefits-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20px;
  padding: 16px 16px;
  border-top: 1px solid #28201F1A;
  border-bottom: 1px solid #28201F1A;
  margin-bottom: 20px;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 8px;
  position: relative;
}

.benefit-item:not(:last-child)::after {
  content: "";
  width: 1px;
  height: 18px;
  background: #28201F14;
  margin-left: 10px;
}

.benefit-icon {
  display: flex;
  align-items: center;
}

.benefit-text {
    font-family: 'Blauer Nue RG';
    font-weight: 400;
    font-size: 14px;
    line-height: 130%;
    letter-spacing: 0%;
    color: #28201F;
    white-space: nowrap;
}
@media (max-width: 1710px) and (min-width: 1440px) {
    .benefit-text {
      font-size: 12px;
    }
}
@media(max-width: 1470px){
  .benefits-strip {
    flex-wrap: nowrap;
    overflow-x: scroll;
  }
}
@media(max-width: 500px){
  .benefit-icon svg{
    height: 16px;
    width: 16px;
  }
  .benefits-strip{
    gap:16px;
    padding: 13px;
  }
  .benefit-item:not(:last-child)::after {
    margin-left: 6px;
}  
  .benefit-text {
      font-size: 12px;
  }
}
</style>