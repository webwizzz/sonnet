{% if product.metafields.custom.testimonials.value != blank %}
  <div class="pdp-testimonials">
    {% for item in product.metafields.custom.testimonials.value %}
      <div class="testimonial-card">
        <div class="testimonial-inner">
          <!-- Image -->
          <div class="testimonial-image">
            {% if item.image != blank %}
              <img src="{{ item.image | image_url }}"  alt="{{ item.name }}" loading="lazy" >
            {% endif %}
          </div>
          <!-- Content -->
          <div class="testimonial-content">
            <!-- Review -->
            <div class="testimonial-text">
              {{ item.reviews | metafield_tag  }}
            </div>
            <!-- Name + Rating -->
            <div class="testimonial-meta">
              <span class="testimonial-name">
                {{ item.name }}
              </span>
              {% if item.rating %}
                <span class="testimonial-rating">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_252_24)">
                    <path d="M11.9365 4.32043C11.86 4.10191 11.6556 3.95131 11.4207 3.94031H7.72845L6.5563 0.380964C6.47284 0.142334 6.23834 -0.0128633 5.98195 0.000839578C5.73096 -0.000932229 5.50787 0.157663 5.43104 0.392482L4.25889 3.95183H0.578337C0.331109 3.95016 0.110534 4.10415 0.0307584 4.33411C-0.0490175 4.56408 0.029908 4.81841 0.226692 4.96549L3.21567 7.18864L2.04352 10.771C1.96072 11.0062 2.04443 11.2669 2.24958 11.4128C2.45473 11.5587 2.73291 11.5554 2.93436 11.4046L6.064 9.10078L9.20536 11.4046C9.3032 11.4777 9.42235 11.5181 9.54529 11.5197C9.73242 11.5223 9.90911 11.4351 10.0188 11.2861C10.1284 11.1371 10.1573 10.9449 10.0962 10.771L8.92404 7.18864L11.8544 4.95397C12.0124 4.77976 12.045 4.52797 11.9365 4.32043Z" fill="#28201F"/>
                    </g>
                    <defs>
                    <clipPath id="clip0_252_24">
                    <rect width="12" height="12" fill="white"/>
                    </clipPath>
                    </defs>
                    </svg>
                     {{ item.rating }}
                </span>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}
<style>
.pdp-testimonials {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.testimonial-card {
  background: #FFFFFF;
  border-radius: 16px;
  padding: 24px;
}

.testimonial-inner {
  display: flex;
  gap: 14px;
  align-items: center;
}

.testimonial-image img {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  object-fit: cover;
}

.testimonial-content {
  flex: 1;
}
.testimonial-text strong{
    display: block;
    margin: 0;
}
.testimonial-text * {
    font-family: 'Blauer Nue LT';
    font-weight: 300;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: -2%;
    margin-bottom: 10px;
    color: #28201FB2;
}
    .testimonial-name{
        font-weight: 500;
        font-size: 12px;
        line-height: 100%;
        letter-spacing: -2%;
        text-transform: uppercase;
        color: #28201F;
        font-family: 'Blauer Nue MD';
        padding-right: 6px;
        border-right: 1px solid #28201F1A;
    }
.testimonial-rating {
    color: #28201F;
    display: flex;
    gap: 2px;
    align-items: center;
    font-family: 'Blauer Nue MD';
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: -2%;
}
.testimonial-meta {
  display: flex;
  align-items: center;
  gap: 6px;
}
</style>