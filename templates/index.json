    "faq_accordion_6XkTMJ": {
      "type": "faq-accordion",
      "blocks": {
        "faq_item_RUHxfb": {
          "type": "faq_item",
          "settings": {
            "question": "What is the skin microbiome?",
            "answer": "<p>The skin microbiome refers to the collection of microorganisms that naturally live on your skin and help support its barrier and overall function.</p>"
          }
        },
        "faq_item_cAeLqn": {
          "type": "faq_item",
          "settings": {
            "question": "What is the AM:PM Ritual and do I need all 5 products?",
            "answer": "<p>The AM:PM Ritual is a complete 5-step microbiome skincare system: Clean It Off (Face Wash) → Dab It On (Toner) → Rub It In (Serum) → Soak It In (Moisturiser) → Smear It On (Clay Mask, weekly). Each product works individually, but together they create a synergistic system where each step prepares your skin for the next — rebuilding your microbiome from cleanse to moisturise.</p>"
          }
        },
        "faq_item_bEQz4A": {
          "type": "faq_item",
          "settings": {
            "question": "Are Sonnet Wellness products vegan and cruelty-free?",
            "answer": "<p>Yes — 100%. All Sonnet Wellness products are completely vegan with no animal-derived ingredients, and we never test on animals. Every formulation is also free from parabens, GMO ingredients, phthalates, alcohol, mineral oil, petrolatum, and Propylene Glycol.</p>"
          }
        },
        "faq_item_kUdfnT": {
          "type": "faq_item",
          "settings": {
            "question": "Are Sonnet products suitable for sensitive skin?",
            "answer": "<p>The formulations are designed to be gentle and suitable for all skin types, including sensitive skin. However, a patch test is always recommended.</p>"
          }
        },
        "faq_item_fyixGT": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use these products if I have acne-prone skin?",
            "answer": "<p>Yes, the formulations are designed to support balanced skin, which may help improve the appearance of acne-prone skin.</p>"
          }
        },
        "faq_item_7HL9Dm": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to use the full routine?",
            "answer": "<p>Products can be used individually, but using them as a routine may provide more consistent results.</p>"
          }
        }
      },
