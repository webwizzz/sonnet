    "about_safety": {
      "type": "about-safety",
      "settings": {
        "heading": "<p>Safety</p>",
        "heading_size": 58,
        "feature_image": "shopify://shop_images/09-safety-all-products.webp",
        "feature_title": "All Products",
        "feature_text": "Patch test on the inner forearm 24 hours before first full use. Discontinue use if irritation occurs. For external use only. Keep out of reach of children.",
        "product_tag": "Product warnings",
        "product_image": "shopify://shop_images/09-safety-face-mask.webp",
        "product_title": "Smear It On Face Mask",
        "product_meta": "20% Kaolin Clay - Glycolic Acid | 45 ml",
        "tag_font": "montserrat_n5",
        "color_background": "#fffcf9",
        "color_text": "#28201f",
        "color_panel": "#f5eee6",
        "color_dark_card": "#2a1f19",
        "color_dark_text": "#f5eee6",
        "padding_top": 108,
        "padding_bottom": 100,
        "mobile_padding_top": 48,
        "mobile_padding_bottom": 48,
        "custom_class": ""
      },
      "blocks": {
        "warn_glycolic": {
          "type": "warning",
          "settings": {
            "column": "left",
            "text": "<p>Contains Glycolic Acid, an alpha hydroxy acid. Do not use on damaged or broken skin.</p>"
          }
        },
        "warn_sun": {
          "type": "warning",
          "settings": {
            "column": "left",
            "text": "<p><strong>Sun alert:</strong> this product contains an alpha hydroxy acid that may increase your skin’s sensitivity to the sun, and particularly the possibility of sunburn. Use sunscreen and limit sun exposure while using this product and for a week afterwards.</p>"
          }
        },
        "warn_combine": {
          "type": "warning",
          "settings": {
            "column": "left",
            "text": "<p>Do not use in combination with other products containing alpha or beta hydroxy acids in the same session.</p>"
          }
        },
        "warn_eyes": {
          "type": "warning",
          "settings": {
            "column": "right",
            "text": "<p>Avoid contact with the eyes. If contact occurs, rinse immediately with plenty of water.</p>"
          }
        },
        "warn_children": {
          "type": "warning",
          "settings": {
            "column": "right",
            "text": "<p>Not to be used on children.</p>"
          }
        },
        "warn_patch": {
          "type": "warning",
          "settings": {
            "column": "right",
            "text": "<p>Patch test before first use. For external use only. Keep out of reach of children.</p>"
          }
        }
      },
      "block_order": [
        "warn_glycolic",
        "warn_sun",
        "warn_combine",
        "warn_eyes",
        "warn_children",
        "warn_patch"
      ]
