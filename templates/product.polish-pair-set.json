          "type": "question",
          "settings": {
            "question": "Can I use a 2% toner with a 5% serum?",
            "answer": "<p>Yes, for most skin. If you are new to niacinamide, introduce one product at a time.</p>"
          }
        },
        "question_VdqUtz": {
          "type": "question",
          "settings": {
            "question": "Can I use the toner as a facial mist?",
            "answer": "<p>It is formulated as a toner. If you prefer a mist, decant it into a clean fine-mist spray bottle.</p>"
          }
        },
