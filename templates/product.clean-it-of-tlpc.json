    "faq_know_first_Ynncyf": {
      "type": "faq-know-first",
      "blocks": {
        "question_XjwAHp": {
          "type": "question",
          "settings": {
            "question": "Can I use Clean It Off twice a day?",
            "answer": "<p>Yes. It's formulated for morning and evening use across all skin types, including sensitive and blemish-prone skin.</p>"
          }
        },
        "question_iRmtFn": {
          "type": "question",
          "settings": {
            "question": "Does it remove sunscreen and makeup?",
            "answer": "<p>It helps remove sunscreen residue and daily impurities. For heavy or waterproof makeup, use a dedicated remover first, then Clean It Off as a second cleanse.</p>"
          }
        },
        "question_e7r8VH": {
          "type": "question",
          "settings": {
            "question": "Is it suitable for sensitive skin?",
            "answer": "<p>Yes. Its dual-surfactant system, including 17% Cocamidopropyl Betaine, is designed for a milder cleansing experience. Patch test before first use.</p>"
          }
        },
        "question_X6iaAV": {
          "type": "question",
          "settings": {
            "question": "Does it contain sulphates?",
            "answer": "<p>Yes. It contains Sodium Laureth Sulfate as its primary foaming surfactant, balanced with Cocamidopropyl Betaine, Glycerin and Aloe Vera.</p>"
          }
        },
        "question_4iJAeB": {
          "type": "question",
          "settings": {
            "question": "What is Lactobacillus Ferment Lysate?",
            "answer": "<p>A postbiotic made from an inactivated Lactobacillus ferment. It contains no live organisms and helps maintain a comfortable, conditioned skin surface.</p>"
          }
        },
        "question_bir9dW": {
          "type": "question",
          "settings": {
            "question": "Do I need the full ritual?",
            "answer": "<p>No. Clean It Off works as a standalone cleanser. For the full AM:PM ritual, follow with Dab It On Toner, Rub It In Serum and Soak It In Face Cream.</p>"
          }
        }
      },
