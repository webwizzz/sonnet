    "faq_know_first_rwdfL3": {
      "type": "faq-know-first",
      "blocks": {
        "question_Nkzwn7": {
          "type": "question",
          "settings": {
            "question": "How do I use the set?",
            "answer": "<p>Cleanse for 30 to 60 seconds. Then press in 2 to 3 drops of serum. Morning and evening.</p>"
          }
        },
        "question_zcAym6": {
          "type": "question",
          "settings": {
            "question": "Why cleanse before the serum?",
            "answer": "<p>An active serum works best on clean skin.</p>"
          }
        },
        "question_GyjbH9": {
          "type": "question",
          "settings": {
            "question": "How long until I see results?",
            "answer": "<p>Changes are typically seen over several weeks of twice-daily use. Results vary.</p>"
          }
        },
        "question_Xy6WJB": {
          "type": "question",
          "settings": {
            "question": "Is 5% niacinamide too strong for sensitive skin?",
            "answer": "<p>5% is a widely used concentration. If your skin is reactive, start once daily in the evening. Patch test first.</p>"
          }
        },
        "question_6gnMAw": {
          "type": "question",
          "settings": {
            "question": "Can I use it with vitamin C?",
            "answer": "<p>Yes. If your skin is easily irritated, apply them at different times of day.</p>"
          }
        },
        "question_YXzpAm": {
          "type": "question",
          "settings": {
            "question": "Do I still need moisturiser and sunscreen?",
            "answer": "<p>Yes. Moisturiser goes over the serum. Finish mornings with SPF 30 to 50, which is not included in the Sonnet range.</p>"
          }
        },
        "question_VnKNPz": {
          "type": "question",
          "settings": {
            "question": "Does the face wash contain sulphates?",
            "answer": "<p>Yes. Sodium Laureth Sulfate is its main foaming surfactant, buffered with glycerin, aloe and betaine.</p>"
          }
        },
        "question_kYVNK3": {
          "type": "question",
          "settings": {
            "question": "What is Lactobacillus Ferment Lysate?",
            "answer": "<p>A postbiotic ingredient made by fermentation. It contains no live organisms.</p>"
          }
        }
      },
