    "faq_know_first_rwdfL3": {
      "type": "faq-know-first",
      "blocks": {
        "question_Nkzwn7": {
          "type": "question",
          "settings": {
            "question": "Do I use all five products every day?",
            "answer": "<p>No. Use four daily, morning and night: face wash, toner, serum, cream. The mask is only for two to three evenings a week.</p>"
          }
        },
        "question_zcAym6": {
          "type": "question",
          "settings": {
            "question": "Is it suitable for sensitive skin?",
            "answer": "<p>It's formulated for all skin types. Patch test each product first, and start the mask with a shorter five-minute wear time.</p>"
          }
        },
        "question_GyjbH9": {
          "type": "question",
          "settings": {
            "question": "Can I use the 2% toner and 5% serum together?",
            "answer": "<p>Yes, layering them is common. If your skin is new to niacinamide, introduce one product at a time.</p>"
          }
        },
        "question_Xy6WJB": {
          "type": "question",
          "settings": {
            "question": "How often should I use the mask?",
            "answer": "<p>Two to three evenings a week, in place of the face wash. Leave it on 10 to 15 minutes, rinse, then tone.</p>"
          }
        },
        "question_6gnMAw": {
          "type": "question",
          "settings": {
            "question": "Do I need sunscreen with this set?",
            "answer": "<p>Yes. The mask contains glycolic acid, which can make skin more sun-sensitive. Use SPF 30 to 50 daily.</p>"
          }
        }
      },
      "block_order": [
        "question_Nkzwn7",
