    "why_section_pUQnp4": {
      "type": "Why_section",
      "blocks": {
        "block_XcXVRf": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/R1.webp",
            "t1": "Fades Dark Spots and Hyperpigmentation",
            "desc": "<p>Niacinamide inhibits the transfer of melanin to skin cells, the biological process responsible for dark spots, post-acne marks, and uneven tone. It works at the cellular level, not just on the surface.</p>",
            "title": "68%",
            "title1": "<p>improvement in hyperpigmentation visibility </p>"
          }
        },
        "block_6PeaDF": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/R2.webp",
            "t1": "Controls Sebum Without Drying SkiN",
            "desc": "<p>Niacinamide regulates sebaceous gland activity, reducing excess oil at the source. Jojoba Oil simultaneously mimics skin's natural sebum, signalling the skin to stop overproducing oil while keeping it moisturised.</p>",
            "title": "52%",
            "title1": "<p>reduction in sebum excretion rate </p>"
          }
        },
        "block_VF87Rr": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/R3.webp",
            "t1": "Delivers Antioxidant Protection Daily",
            "desc": "<p>Vitamin E neutralises free radicals generated by UV exposure and environmental pollution, the primary drivers of premature ageing, pigmentation, and barrier damage. Every application is an invisible shield against daily skin stress.</p>",
            "title": "50%",
            "title1": "<p>reduction in oxidative stress markers</p>"
          }
        },
        "block_PLceze": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/R4.webp",
            "t1": "Provides Deep, Lasting Hydration",
            "desc": "<p>Jojoba Oil and Aloe Vera Leaf Juice work together as a humectant-emollient pair, drawing moisture in and sealing it within the skin layers. The result is hydration that doesn't evaporate within hours.</p>",
            "title": "34–48%",
            "title1": "<p>increase in skin hydration levels</p>"
          }
        }
      },
