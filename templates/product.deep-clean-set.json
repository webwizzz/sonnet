    "faq_know_first_rwdfL3": {
      "type": "faq-know-first",
      "blocks": {
        "question_Nkzwn7": {
          "type": "question",
          "settings": {
            "question": "How often should I use the mask?",
            "answer": "<p>Two to three times a week. More often isn't advised because it contains 4% glycolic acid.</p>"
          }
        },
        "question_zcAym6": {
          "type": "question",
          "settings": {
            "question": "What order do I use them in?",
            "answer": "<p>Mask on clean, dry skin. Rinse, then toner straight after.</p>"
          }
        },
        "question_Xy6WJB": {
          "type": "question",
          "settings": {
            "question": "Is it suitable for sensitive skin?",
            "answer": "<p>Patch test on the inner forearm first. Start with a five-minute wear time. Not for damaged or broken skin.</p>"
          }
        },
        "question_YXzpAm": {
          "type": "question",
          "settings": {
            "question": "Do I need sunscreen?",
            "answer": "<p>Yes. Use broad-spectrum SPF 30 to 50 daily while using the mask and for a week afterwards.</p>"
          }
        },
        "question_638rff": {
          "type": "question",
          "settings": {
            "question": "Can I use other acid products in the same session?",
            "answer": "<p>No. Do not combine the mask with other products containing alpha or beta hydroxy acids in the same session.</p>"
          }
        },
        "question_g3bmmJ": {
          "type": "question",
          "settings": {
            "question": "Can I use the toner without the mask?",
            "answer": "<p>Yes. Use it daily after cleansing, morning and night.</p>"
          }
        },
        "question_dcc19": {
          "type": "question",
          "settings": {
            "question": "Is the toner alcohol-free?",
            "answer": "<p>Yes. No denatured alcohol, ethanol or isopropyl alcohol.</p>"
          }
        },
        "question_dcc20": {
          "type": "question",
          "settings": {
            "question": "Can I use the toner as a facial mist?",
            "answer": "<p>Yes. Decant it into a clean fine-mist spray bottle.</p>"
          }
        }
      },
