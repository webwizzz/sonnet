      {%- endif -%}
      {%- if section.settings.big_stat != blank -%}
        <p class="sm-big-stat js-counter" data-target="{{ section.settings.big_stat | remove: '%' }}">
        0%
        </p>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="sm-subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </div>

    <!-- RIGHT: stat pills -->
    <div class="sm-right">
      {%- for block in section.blocks -%}
        {%- assign bset = block.settings -%}
        <div class="sm-pill{% if bset.highlighted %} is-highlighted{% endif %}" {{ block.shopify_attributes }}>
          {%- if bset.value != blank -%}
            <span class="sm-pill-value">{{ bset.value }}</span>
          {%- endif -%}
          <div class="sm-pill-divider"></div>
          {%- if bset.description != blank -%}
            <span class="sm-pill-desc">{{ bset.description }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const counters = document.querySelectorAll(".js-counter");

  counters.forEach(counter => {
    const target = parseFloat(counter.getAttribute("data-target"));
    let count = 0;

    const duration = 1500; // animation speed
    const stepTime = 20;
    const increment = target / (duration / stepTime);

    function updateCounter() {
      count += increment;

      if (count < target) {
        counter.innerText = Math.floor(count) + "%";
        requestAnimationFrame(updateCounter);
      } else {
        counter.innerText = target + "%";
      }
    }

    // Optional: trigger when visible
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          updateCounter();
          observer.unobserve(counter);
        }
      });
    }, { threshold: 0.5 });

    observer.observe(counter);
  });
});
</script>
{% schema %}
{
  "name": "Stats Section",
  "tag": "section",
  "class": "stats-microbiome-section",
  "settings": [
    {
      "type": "text",
      "id": "add_class",
      "label": "Add Class"
    },
    {
      "type": "header",
      "content": "Left Column"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "image_picker",
      "id": "trusted_image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "trusetd_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "trusted_reviews",
      "label": "Reiews"
    },
    {
      "type": "text",
      "id": "big_stat",
      "label": "Big stat",
      "default": "73%"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Indians face skin issue from <em>disrupted Microbiome</em></p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#28201C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Left text color",
      "default": "#F5EDE4"
