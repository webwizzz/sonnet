{% comment %}
  /sections/stats-microbiome.liquid

  Two-column dark stats section:
  Left  → large % stat + subtitle
  Right → 4 stat pills (value + description)

  All content and colors are customizable via Theme Editor.
  Blocks = each stat pill on the right side.
{% endcomment %}

{%- liquid
  assign section_id  = 'sm-' | append: section.id
  assign bg_color    = section.settings.background_color
  assign pill_bg     = section.settings.pill_background_color
  assign pill_active_bg = section.settings.pill_active_background_color
  assign text_color  = section.settings.text_color
  assign pill_text   = section.settings.pill_text_color
  assign pt_desktop  = section.settings.padding_top_desktop
  assign pb_desktop  = section.settings.padding_bottom_desktop
  assign pt_mobile   = section.settings.padding_top_mobile
  assign pb_mobile   = section.settings.padding_bottom_mobile
  assign mt_desktop  = section.settings.margin_top_desktop
  assign mb_desktop  = section.settings.margin_bottom_desktop
  assign mt_mobile   = section.settings.margin_top_mobile
  assign mb_mobile   = section.settings.margin_bottom_mobile
  assign border_radius = section.settings.section_border_radius
-%}

<style>
  /* ── Section ────────────────────────────────── */
  #{{ section_id }} {
    background: {{ bg_color }};
    border-radius: {{ border_radius }}px;
    padding: {{ pt_desktop }}px 0 {{ pb_desktop }}px;
    margin-top: {{ mt_desktop }}px;
    margin-bottom: {{ mb_desktop }}px;
    overflow: hidden;
  }

  /* ── Two-column grid ─────────────────────────── */
  #{{ section_id }} .sm-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: 40px;
    max-width: 1520px;
    margin: 0 auto;

  }

  /* ── LEFT — big stat ─────────────────────────── */
  #{{ section_id }} .heading{
    font-family: 'Blauer Nue MD';
    font-weight: 500;
    font-size: 40px;
    line-height: 100%;
    letter-spacing: -2%;
    color: #28201F;
    margin: 0 0 24px;
  }
  #{{ section_id }} .heading em{
    font-family: 'Test Tiempos Fine Italic RG';
    font-style: italic;
  }
  #{{ section_id }} img.trusted_image {
      max-width: 106px;
      width: 100%;
  }
  #{{ section_id }} .trusted-reviews-wrapper {
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: flex-start;
  }
  #{{ section_id }} p.trusted-text {
    font-family: 'Blauer Nue TH';
    font-weight: 200;
    font-size: 16px;
    line-height: 130%;
    color: #28201F;
    letter-spacing: -2%;
    max-width: 200px;
    padding-right: 18px;
    border-right: 1px solid #28201F1A;
  }
  #{{ section_id }} .reviews-box {
      padding-left: 8px;
  }
  #{{ section_id }} .trusted_reviews{
    font-family: 'Blauer Nue TH';
    font-weight: 200;
    font-size: 16px;
    line-height: 130%;
    letter-spacing: -2%;
    color: #28201F;
  }
  #{{ section_id }} .sm-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }
  #{{ section_id }}.pdp-stats .sm-left:before {
    background: #28201F1A;
  }
  #{{ section_id }} .sm-left:before {
    content: '';
    position: absolute;
    height: 100%;
    width: 1px;
    background: #FFFFFF1A;
    right: 80px;   
    top: 0;
  }

  #{{ section_id }}.pdp-stats .sm-big-stat {
    font-size: 250px;
  } 
  #{{ section_id }} .sm-big-stat {
    font-family: 'Test Tiempos Fine Italic';
    font-size: 290px;
    font-weight: 500;
    font-style: italic;
    line-height: 100%;
    color: {{ text_color }};
    letter-spacing: -2%;
    margin: 0 0 30px;
  }

  #{{ section_id }}.pdp-stats .sm-subtitle {
    font-size: 18px;
    font-family: 'Blauer Nue TH';
    max-width: 580px;
  }
  #{{ section_id }} .sm-subtitle {
    font-family: 'Blauer Nue MD';
    font-size: 40px;
    font-weight: 400;
    color: {{ text_color }};
    line-height: 100%;
    letter-spacing: -2%;
    max-width: 520px;
  }

  #{{ section_id }} .sm-subtitle em {
    font-style: italic;
    font-family: 'Test Tiempos Fine Italic RG';
    font-weight: 400;
  }

  /* ── RIGHT — pill list ───────────────────────── */
  #{{ section_id }} .sm-right {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* ── Pill ────────────────────────────────────── */
  #{{ section_id }} .sm-pill {
    display: flex;
    align-items: center;
    gap: 30px;
    background: {{ pill_bg }};
    border-radius: 100px;
    padding: 16px 30px 16px 50px;
    transition: all 0.5s ease;
    border: 1px solid #FEEFEE;
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .sm-pill * {
    z-index: 1;
  }

  #{{ section_id }} .sm-pill::after {
    position: absolute;
    content: "";
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background: {{ pill_active_bg }};
    z-index: 0;
    border-radius: 999px 0 0 999px;
    transition: width 0.25s ease-in-out;
  }

  #{{ section_id }} .sm-pill::before {
    position: absolute;
    content: "";
    right: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background: {{ pill_active_bg }};
    z-index: 0;
    border-radius: 0 999px 999px 0;
    transition: width 0.25s ease-in-out;
  }


  #{{ section_id }} .sm-pill:hover::after,
  #{{ section_id }} .sm-pill:hover::before  {
    width: 50%;
  }

  {% comment %} #{{ section_id }} .sm-pill:hover {
    background: {{ pill_active_bg }};
  } {% endcomment %}

  #{{ section_id }}.pdp-stats .sm-pill-value {
    width: 100px;
  }
  #{{ section_id }} .sm-pill-value {
    font-family: 'Test Tiempos Fine Italic';
    font-size: 50px;
    font-weight: 500;
    font-style: italic;
    color: {{ pill_text }};
    white-space: nowrap;
    flex-shrink: 0;
    width: 175px;
  }
#{{ section_id }} .sm-pill:hover .sm-pill-value{
  color:#28201F;
}
#{{ section_id }}.pdp-stats .sm-pill:hover .sm-pill-value{
  color:#FFFFFF;
}
  #{{ section_id }}.pdp-stats .sm-grid{
    max-width: 1460px;
  } 
  #{{ section_id }} .sm-pill-divider {
    width: 40px;
    height: 1px;
    background: #FFFFFF1A;
    flex-shrink: 0;
  }
  #{{ section_id }}.pdp-stats .sm-pill-divider {
    background: #28201F1A;
  }
    
  #{{ section_id }} .sm-pill:hover .sm-pill-divider {
    background: #28201F1A;
  }
  #{{ section_id }}.pdp-stats .sm-pill:hover .sm-pill-divider {
    background: #FFFFFF1A;
  }

  #{{ section_id }}.pdp-stats .sm-pill-desc {
    max-width: 310px;
  }
  #{{ section_id }} .sm-pill-desc {
    font-family: 'Blauer Nue TH';
    font-size: 18px;
    font-weight: 200;
    color: {{ pill_text }};
    line-height: 130%;
    letter-spacing: -2%;
    max-width: 215px;
  }

  #{{ section_id }} .sm-pill:hover .sm-pill-desc {
    color: #28201FE5;
  }
  #{{ section_id }}.pdp-stats .sm-pill:hover .sm-pill-desc {
    color: #FFFFFFE5;
  }

  /* ── Mobile ─────────────────────────────────── */
  @media (max-width: 1520px) {
    #{{ section_id }} {
      padding-left: 30px;
      padding-right: 30px;
    }
  }
  @media (max-width: 1440px) {
   #{{ section_id }} .sm-big-stat {
      font-size: 250px;
   }
  }
  @media (max-width: 1200px) {
    #{{ section_id }}.pdp-stats .sm-big-stat,
    #{{ section_id }} .sm-big-stat {
       font-size: 200px;
    }
    #{{ section_id }} .heading, 
    #{{ section_id }} .sm-subtitle {
      max-width: 80%;
      font-size: 36px;
    }
    #{{ section_id }} .sm-left:before {
        right: 50px;
    }
    #{{ section_id }} .sm-pill {
        gap: 20px;
    }
    #{{ section_id }} .sm-pill-value {
        font-size: 30px;
        width: 110px;
    }
  }
  @media (max-width: 1025px) {
    #{{ section_id }} .sm-left:before {
        right: 20px;
    }
  }
  @media (max-width: 768px) {
    #{{ section_id }} .sm-subtitle {
      margin: 0 auto 36px;
    }
    #{{ section_id }} .sm-left {
        border-bottom: 1px solid #FFFFFF1A;
        text-align: center;
    }
    #{{ section_id }} .sm-left:before {
      content: none;
    }
    #{{ section_id }} {
      padding: {{ pt_mobile }}px 16px {{ pb_mobile }}px;
      margin-top: {{ mt_mobile }}px;
      margin-bottom: {{ mb_mobile }}px;
      border-radius: {{ border_radius | times: 0.6 | round }}px;
    }

    #{{ section_id }} .sm-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    #{{ section_id }}.pdp-stats .sm-big-stat {
      font-size: 160px;
    }
    #{{ section_id }} .sm-big-stat {
      font-size: 168px;
      margin-bottom: 16px;
    }

    #{{ section_id }} .sm-pill {
      padding: 14px 20px;
      gap: 30px;
    }

    #{{ section_id }} .sm-pill-value,
    #{{ section_id }}.pdp-stats .sm-pill-value {
      min-width: 80px;
      font-size: 24px;
    }
    #{{ section_id }}.pdp-stats .sm-pill-desc,
    #{{ section_id }} .sm-pill-desc {
        max-width: 100%;
        font-size: 12px;
    }

    #{{ section_id }} .sm-pill-divider {
      width: 20px;
    }
  }

  @media (max-width: 500px) {
    #{{ section_id }} .reviews-box {
      padding-left: 0;
      order: 1;
  }
  #{{ section_id }} p.trusted-text{
    padding-right: 0;
    border-right: none;
    text-align: start;
    order: 3;
    font-size: 12px;
  }
    #{{ section_id }} img.trusted_image {
      max-width: 80px;
      order: 2;
      padding-left: 13px;
      border-left: 1px solid #28201F1A;
    }
    #{{ section_id }} .trusted_reviews {
        font-size: 12px;
    }
    #{{ section_id }}.pdp-stats .sm-subtitle {
      font-size: 14px;
    }
    #{{ section_id }}.pdp-stats .sm-big-stat, 
    #{{ section_id }}.pdp-stats .sm-subtitle, #{{ section_id }} .heading {
      text-align: start;
    }
     #{{ section_id }} .heading{
      max-width: 70% !important;
    }
    #{{ section_id }}.pdp-stats .sm-left{
      border-color: #28201F1A;
    }
    #{{ section_id }} .sm-subtitle, #{{ section_id }} .heading {
        max-width: 100%;
        font-size: 28px;
    }
    #{{ section_id }} .sm-pill {
      gap: 22px;
    }
    #{{ section_id }} .sm-pill-value,
    #{{ section_id }}.pdp-stats .sm-pill-value{
      width:auto;
    }
  }
  @media (max-width: 400px) {
    #{{ section_id }} .sm-pill-value,
    #{{ section_id }}.pdp-stats .sm-pill-value {
      min-width: 70px;
    }
  }
</style>

<div id="{{ section_id }}" class="{{ section.settings.add_class }}">
  <div class="sm-grid">

    <!-- LEFT: big stat -->
    <div class="sm-left">
      {%- if section.settings.heading != blank -%}
        <div class="heading">{{ section.settings.heading }}</div>
      {%- endif -%}
      {%- if section.settings.trusetd_text != blank -%}
        <div class="trusted-reviews-wrapper">
          {%- if section.settings.trusted_image != blank -%}
            <img class="trusted_image" src="{{ section.settings.trusted_image | image_url }}">
          {%- endif -%}
          <p class="trusted-text">{{ section.settings.trusetd_text }}</p>
          {%- if section.settings.trusted_reviews != blank -%}
