{%- comment -%}
  Collection (TLPC): hero banner, category tiles, Filter / Sort bar, 4-column product grid, pagination.
  Design: Figma QvQ11convTbPladsyhAg96, node 249:660 ("collection page").
  Desktop 1920: hero 1820 × 500 (50px gutters, radius 16), "Shop *All*" (Blauer Nue MD 68 + Tiempos
  italic, #FFFCF9) 70px from the left and vertically centred, product group 339 × 453 200px from the right.
  80px below: tiles 260 × 180 (radius 10, #F6F3EE, 30px gaps, centred); the current collection's tile gets
  a 1px #78563D border and a 6px dot before its label (Blauer Nue LT 14 uppercase, 12px under the tile).
  80px below: Filter (142 × 50) left, "Sort by" (246 × 50) right — 1px #78563D pills on #FFFCF9.
  41px below: 4 columns of 422 (10px column gap, 20px row gap) built from snippets/product-card-custom.
  Filter opens a drawer with the collection's storefront filters (Search & Discovery); Sort is a native
  <select> laid over the pill. Both submit as normal GET parameters, so results stay shareable.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign hero_image = s.hero_image | default: collection.image
  assign active_filters = 0
  for filter in collection.filters
    assign active_filters = active_filters | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_filters = active_filters | plus: 1
      endif
    endif
  endfor
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign sort_label = ''
  for option in collection.sort_options
    if option.value == sort_by
      assign sort_label = option.name
    endif
  endfor
-%}

{% style %}
#shopify-section-{{ section.id }} {
  --ctl-u: clamp(0.5px, calc(100vw / 1920), 1px);
  --ctl-text: {{ s.color_text }};
  --ctl-accent: {{ s.color_accent }};
  --ctl-tile: {{ s.color_tile }};
  --ctl-h: {{ s.heading_size }};
  --ctl-title: {{ s.color_title }};
  background-color: {{ s.color_background }};
}
#shopify-section-{{ section.id }} .ctl {
  padding-top: max({{ s.mobile_padding_top }}px, calc({{ s.padding_top }} * var(--ctl-u)));
  padding-bottom: max({{ s.mobile_padding_bottom }}px, calc({{ s.padding_bottom }} * var(--ctl-u)));
}
@media screen and (max-width: 768px) {
  #shopify-section-{{ section.id }} .ctl {
    padding-top: {{ s.mobile_padding_top }}px;
    padding-bottom: {{ s.mobile_padding_bottom }}px;
  }
}
{% endstyle %}

{% style %}
.ctl *, .ctl *::before, .ctl *::after { box-sizing: border-box; }
.ctl { color: var(--ctl-text); }
.ctl a { color: inherit; text-decoration: none; }

/* ---------- Hero ---------- */
.ctl__hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: max(220px, calc(500 * var(--ctl-u)));
  margin: 0 max(16px, calc(50 * var(--ctl-u)));
  padding: 24px max(20px, calc(70 * var(--ctl-u)));
  border-radius: max(12px, calc(16 * var(--ctl-u)));
  overflow: hidden;
  background: #C9B49E;
  isolation: isolate;
}
.ctl__hero-bg { position: absolute; inset: 0; z-index: -2; }
.ctl__hero-bg img { display: block; width: 100%; height: 100%; object-fit: cover; }
.ctl .ctl__title {
  margin: 0;
  font-family: 'Blauer Nue MD', sans-serif;
  font-weight: 500;
  font-size: max(36px, calc(var(--ctl-h) * var(--ctl-u)));
  line-height: 1.206;
  letter-spacing: -0.02em;
  color: var(--ctl-title);
  text-transform: none;
}
.ctl .ctl__title p { margin: 0; font: inherit; color: inherit; letter-spacing: inherit; }
.ctl .ctl__title em,
.ctl .ctl__title i {
  font-family: 'Test Tiempos Fine Italic RG', 'Test Tiempos Fine Italic', serif;
  font-weight: 400;
  font-style: italic;
  line-height: 1;
}
.ctl__hero-products {
  position: absolute;
  right: calc(200 * var(--ctl-u));
  bottom: calc(16 * var(--ctl-u));
  z-index: -1;
  width: calc(339 * var(--ctl-u));
  height: calc(453 * var(--ctl-u));
}
.ctl__hero-products img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center bottom;
  filter: drop-shadow(0 18px 18px rgba(0, 0, 0, 0.22));
}

/* ---------- Category tiles ---------- */
.ctl__tiles {
  display: flex;
  justify-content: center;
  gap: max(12px, calc(30 * var(--ctl-u)));
  margin: max(32px, calc(80 * var(--ctl-u))) 0 0;
  padding: 0 16px;
  list-style: none;
}
.ctl__tiles li { margin: 0; flex: 0 1 260px; }
.ctl__tile { display: flex; flex-direction: column; align-items: center; gap: 12px; }
.ctl__tile-box {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 260 / 180;
  overflow: hidden;
  border: 1px solid transparent;
  border-radius: 10px;
  background: var(--ctl-tile);
  transition: border-color 200ms ease;
}
.ctl__tile:hover .ctl__tile-box,
.ctl__tile--active .ctl__tile-box { border-color: var(--ctl-accent); }
.ctl__tile-box img {
  position: absolute;
  top: 8%;
  left: 10%;
  display: block;
  width: 80%;
  height: 84%;
  max-width: none;
  object-fit: contain;
  filter: drop-shadow(4px 6px 6px rgba(0, 0, 0, 0.12));
  transition: transform 300ms ease;
}
.ctl__tile:hover .ctl__tile-box img { transform: translateY(-3px); }
.ctl__tile-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'Blauer Nue LT', sans-serif;
  font-weight: 300;
  font-size: 14px;
  line-height: normal;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: var(--ctl-text);
}
.ctl__tile--active .ctl__tile-label::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--ctl-accent);
}

/* ---------- Filter / sort bar ---------- */
.ctl__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: max(32px, calc(80 * var(--ctl-u)));
}
.ctl .ctl__pill {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  height: 50px;
  min-height: 0;
  margin: 0;
  padding: 0 25px 0 30px;
  border: 1px solid var(--ctl-accent);
  border-radius: 50px;
  background: #FFFCF9;
  font-family: 'Blauer Nue LT', sans-serif;
  font-weight: 300;
  font-size: 16px;
  line-height: normal;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: var(--ctl-text);
  cursor: pointer;
  transition: background-color 200ms ease;
}
.ctl .ctl__pill:hover { background: #F6F3EE; }
.ctl .ctl__pill svg { display: block; flex: none; }
.ctl__sort-text { white-space: nowrap; }
.ctl .ctl__pill--filter { padding-right: 30px; }
.ctl__count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  border-radius: 10px;
  background: var(--ctl-accent);
  color: #FFFFFF;
  font-size: 12px;
}
.ctl__sort select {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
  font-size: 16px;
}
.ctl__sort:focus-within { outline: 2px solid var(--ctl-accent); outline-offset: 2px; }

/* ---------- Grid ---------- */
.ctl__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px 10px;
  margin: 41px 0 0;
  padding: 0;
  list-style: none;
}
.ctl__grid > li { margin: 0; display: flex; }
.ctl__grid .pcc__card { max-width: none; height: 100%; }
.ctl__grid .pcc__image-wrap { height: auto; aspect-ratio: 422 / 428; background: var(--ctl-tile); }
.ctl__empty { margin: 60px 0; text-align: center; font-family: 'Blauer Nue LT', sans-serif; font-size: 18px; }
.ctl__empty a { text-decoration: underline; }

/* ---------- Pagination ---------- */
.ctl__pagination { display: flex; justify-content: center; gap: 10px; margin-top: max(32px, calc(50 * var(--ctl-u))); }
.ctl .ctl__page {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 50px;
  height: 50px;
  border: 1px solid var(--ctl-accent);
  border-radius: 50%;
  background: #FFFCF9;
  font-family: 'Blauer Nue RG', sans-serif;
  font-size: 24px;
  line-height: 1;
  color: var(--ctl-accent);
  opacity: 0.6;
}
.ctl .ctl__page:hover,
.ctl .ctl__page--current { opacity: 1; }
.ctl .ctl__page--arrow { border: 0; background: transparent; opacity: 1; }
.ctl .ctl__page--arrow svg { display: block; width: 50px; height: 50px; }
.ctl .ctl__page--prev svg { transform: scaleX(-1); }
.ctl .ctl__page--disabled { opacity: 0.35; pointer-events: none; }
.ctl .ctl__page--gap { border-color: transparent; background: transparent; }

/* ---------- Filter drawer ---------- */
.ctl__drawer[hidden] { display: none; }
.ctl__drawer { position: fixed; inset: 0; z-index: 100000; } /* above the theme's sticky header and drawers */
.ctl__drawer-overlay { position: absolute; inset: 0; background: rgba(40, 32, 31, 0.45); animation: ctl-fade 200ms ease; }
.ctl__drawer-panel {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  width: min(420px, 92vw);
  background: #FFFCF9;
  box-shadow: 10px 0 40px rgba(0, 0, 0, 0.15);
  animation: ctl-slide 260ms ease;
}
.ctl__drawer-head { display: flex; align-items: center; justify-content: space-between; padding: 24px 28px; border-bottom: 1px solid rgba(40, 32, 31, 0.1); }
.ctl .ctl__drawer-title { margin: 0; font-family: 'Blauer Nue MD', sans-serif; font-weight: 500; font-size: 22px; letter-spacing: -0.02em; text-transform: none; }
.ctl .ctl__close { width: 40px; height: 40px; min-height: 0; margin: 0; padding: 0; border: 1px solid var(--ctl-accent); border-radius: 50%; background: transparent; color: var(--ctl-accent); font-size: 22px; line-height: 1; cursor: pointer; }
.ctl__drawer-body { flex: 1; overflow-y: auto; padding: 8px 28px 24px; }
.ctl__group { border-bottom: 1px solid rgba(40, 32, 31, 0.1); }
.ctl__group summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
  font-family: 'Blauer Nue MD', sans-serif;
  font-weight: 500;
  font-size: 15px;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  cursor: pointer;
  list-style: none;
}
.ctl__group summary::-webkit-details-marker { display: none; }
.ctl__group summary::after { content: '+'; font-family: 'Blauer Nue LT', sans-serif; font-size: 20px; color: var(--ctl-accent); }
.ctl__group[open] summary::after { content: '−'; }
.ctl__options { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0 0 18px; list-style: none; }
.ctl__options li { margin: 0; }
.ctl__check { display: flex; align-items: center; gap: 10px; font-family: 'Blauer Nue LT', sans-serif; font-weight: 300; font-size: 15px; cursor: pointer; }
.ctl__check input { width: 18px; height: 18px; margin: 0; accent-color: var(--ctl-accent); }
.ctl__check--disabled { opacity: 0.45; cursor: not-allowed; }
.ctl__check small { margin-left: auto; color: rgba(40, 32, 31, 0.5); font-size: 13px; }
.ctl__price { display: flex; gap: 12px; padding-bottom: 18px; }
.ctl__price label { flex: 1; font-family: 'Blauer Nue LT', sans-serif; font-size: 13px; color: rgba(40, 32, 31, 0.7); }
.ctl__price input { display: block; width: 100%; margin-top: 6px; padding: 10px 12px; border: 1px solid rgba(40, 32, 31, 0.2); border-radius: 8px; background: #FFFFFF; font-size: 15px; }
.ctl__drawer-foot { display: flex; gap: 12px; padding: 18px 28px 24px; border-top: 1px solid rgba(40, 32, 31, 0.1); }
.ctl .ctl__btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 46px;
  min-height: 0;
  margin: 0;
  border: 1px solid var(--ctl-accent);
  border-radius: 50px;
  background: var(--ctl-accent);
  color: #FFFFFF;
  font-family: 'Blauer Nue RG', sans-serif;
  font-size: 15px;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  cursor: pointer;
}
.ctl .ctl__btn--ghost { background: transparent; color: var(--ctl-accent); }
@keyframes ctl-fade { from { opacity: 0; } }
@keyframes ctl-slide { from { transform: translateX(-100%); } }

@media screen and (max-width: 1100px) {
  .ctl__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media screen and (max-width: 768px) {
  .ctl__hero { min-height: 240px; align-items: flex-start; padding-top: 40px; }
  .ctl__hero-products { right: 12px; bottom: 8px; width: 42%; height: 80%; }
  .ctl__tiles { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; }
  .ctl__tiles::-webkit-scrollbar { display: none; }
  .ctl__tiles li { flex: 0 0 140px; }
  .ctl .ctl__pill { height: 44px; padding: 0 16px; font-size: 14px; }
  .ctl__sort-prefix { display: none; }
  .ctl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 8px; }
  .ctl .ctl__page { width: 40px; height: 40px; font-size: 18px; }
  .ctl .ctl__page--arrow svg { width: 40px; height: 40px; }
}
@media (prefers-reduced-motion: reduce) {
  .ctl__drawer-overlay, .ctl__drawer-panel { animation: none; }
}
{% endstyle %}

<div class="ctl {{ s.custom_class | escape }}" data-ctl>
  {%- if s.show_hero -%}
    <div class="ctl__hero">
      <div class="ctl__hero-bg">
        {%- if hero_image != blank -%}
          {{ hero_image | image_url: width: 3640 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 1820, 2400, 3640', alt: '' }}
        {%- endif -%}
      </div>
      <h1 class="ctl__title">
        {%- if s.heading != blank -%}
          {{ s.heading }}
        {%- else -%}
          {{ s.heading_prefix | escape }} <em>{{ collection.title | escape }}</em>
        {%- endif -%}
      </h1>
      {%- if s.hero_products != blank -%}
        <div class="ctl__hero-products">
          {{ s.hero_products | image_url: width: 680 | image_tag: loading: 'eager', sizes: '(min-width: 769px) 18vw, 42vw', widths: '340, 500, 680', alt: '' }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="ctl__tiles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign tile_col = b.collection
          assign is_active = false
          if tile_col != blank and tile_col.handle == collection.handle
            assign is_active = true
          endif
          assign tile_label = b.label | default: tile_col.title
          assign tile_url = tile_col.url
          if tile_col != blank and s.keep_template and tile_col.template_suffix != template.suffix and template.suffix != blank
            assign tile_url = tile_col.url | append: '?view=' | append: template.suffix
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="ctl__tile{% if is_active %} ctl__tile--active{% endif %}" href="{{ tile_url | default: '#' }}"{% if is_active %} aria-current="page"{% endif %}>
            <span class="ctl__tile-box">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 400 | image_tag: loading: 'eager', sizes: '200px', widths: '200, 300, 400', alt: '' }}
              {%- elsif tile_col.featured_image != blank -%}
                {{ tile_col.featured_image | image_url: width: 400 | image_tag: loading: 'eager', sizes: '200px', widths: '200, 300, 400', alt: '' }}
              {%- endif -%}
            </span>
            <span class="ctl__tile-label">{{ tile_label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="main-container">
    <div class="ctl__bar">
      {%- if s.show_filter and collection.filters.size > 0 -%}
        <button type="button" class="ctl__pill ctl__pill--filter" data-ctl-open aria-haspopup="dialog" aria-controls="ctl-drawer-{{ section.id }}">
          {{- 'collection-filter.svg' | inline_asset_content -}}
          <span>{{ s.filter_label | escape }}</span>
          {%- if active_filters > 0 -%}<span class="ctl__count">{{ active_filters }}</span>{%- endif -%}
        </button>
      {%- else -%}
        <span></span>
      {%- endif -%}

      {%- if s.show_sort -%}
        <label class="ctl__pill ctl__sort">
          <span class="ctl__sort-text"><span class="ctl__sort-prefix">{{ s.sort_label | escape }} </span>{{ sort_label | escape }}</span>
          {{- 'collection-chevron-down.svg' | inline_asset_content -}}
          <select data-ctl-sort aria-label="{{ s.sort_label | escape }}">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
        </label>
      {%- endif -%}
    </div>

    {%- paginate collection.products by s.per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="ctl__grid">
          {%- for product in collection.products -%}
            <li>
              {%- liquid
                assign eager = false
                if forloop.index <= 4
                  assign eager = true
                endif
                render 'product-card-custom', product: product, eagerload: eager
              -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="ctl__empty">
          {{ s.empty_text | escape }}
          {%- if active_filters > 0 %} <a href="{{ collection.url }}?view={{ template.suffix }}{% if collection.sort_by %}&sort_by={{ collection.sort_by }}{% endif %}">{{ s.clear_label | escape }}</a>{%- endif -%}
        </p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        {%- assign next_svg = 'blog-page-next.svg' | inline_asset_content -%}
        <nav class="ctl__pagination" aria-label="{{ s.pagination_label | escape }}">
          {%- if paginate.previous -%}
            <a class="ctl__page ctl__page--arrow ctl__page--prev" href="{{ paginate.previous.url }}" aria-label="Previous page">{{ next_svg }}</a>
          {%- else -%}
            <span class="ctl__page ctl__page--arrow ctl__page--prev ctl__page--disabled" aria-hidden="true">{{ next_svg }}</span>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="ctl__page" href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="ctl__page ctl__page--current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="ctl__page ctl__page--gap">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a class="ctl__page ctl__page--arrow" href="{{ paginate.next.url }}" aria-label="Next page">{{ next_svg }}</a>
          {%- else -%}
            <span class="ctl__page ctl__page--arrow ctl__page--disabled" aria-hidden="true">{{ next_svg }}</span>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>

  {%- if s.show_filter and collection.filters.size > 0 -%}
    <div class="ctl__drawer" id="ctl-drawer-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="ctl-drawer-title-{{ section.id }}" data-ctl-drawer hidden>
      <div class="ctl__drawer-overlay" data-ctl-close></div>
      <form class="ctl__drawer-panel" action="{{ collection.url }}" method="get">
        {%- if template.suffix != blank -%}<input type="hidden" name="view" value="{{ template.suffix }}">{%- endif -%}
        {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by | escape }}">{%- endif -%}
        <div class="ctl__drawer-head">
          <h2 class="ctl__drawer-title" id="ctl-drawer-title-{{ section.id }}">{{ s.filter_label | escape }}</h2>
          <button type="button" class="ctl__close" data-ctl-close aria-label="Close">×</button>
        </div>
        <div class="ctl__drawer-body">
          {%- for filter in collection.filters -%}
            {%- assign has_active = false -%}
            {%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign has_active = true -%}{%- endif -%}
            <details class="ctl__group"{% if forloop.first or has_active %} open{% endif %}>
              <summary>{{ filter.label | escape }}</summary>
              {%- if filter.type == 'price_range' -%}
                <div class="ctl__price">
                  <label>{{ s.price_from_label | escape }}
                    <input type="number" inputmode="numeric" min="0" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" placeholder="0">
                  </label>
                  <label>{{ s.price_to_label | escape }}
                    <input type="number" inputmode="numeric" min="0" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}">
                  </label>
                </div>
              {%- else -%}
                <ul class="ctl__options">
                  {%- for value in filter.values -%}
                    <li>
                      <label class="ctl__check{% if value.count == 0 and value.active == false %} ctl__check--disabled{% endif %}">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                        <span>{{ value.label | escape }}</span>
                        <small>{{ value.count }}</small>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </details>
          {%- endfor -%}
        </div>
        <div class="ctl__drawer-foot">
          <a class="ctl__btn ctl__btn--ghost" href="{{ collection.url }}{% if template.suffix != blank %}?view={{ template.suffix }}{% endif %}">{{ s.clear_label | escape }}</a>
          <button type="submit" class="ctl__btn">{{ s.apply_label | escape }}</button>
        </div>
      </form>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};

    function init(root) {
      if (!root || root._ctlInit) return;
      root._ctlInit = true;
      var drawer = root.querySelector('[data-ctl-drawer]');
      var opener = root.querySelector('[data-ctl-open]');
      var sort = root.querySelector('[data-ctl-sort]');

      function openDrawer() {
        if (!drawer) return;
        drawer.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        var first = drawer.querySelector('summary, input, button');
        if (first) first.focus();
      }
      function closeDrawer() {
        if (!drawer || drawer.hidden) return;
        drawer.hidden = true;
        document.documentElement.style.overflow = '';
        if (opener) opener.focus();
      }
      function onClick(e) {
        if (e.target.closest('[data-ctl-open]')) { openDrawer(); return; }
        if (e.target.closest('[data-ctl-close]')) closeDrawer();
      }
      function onKey(e) { if (e.key === 'Escape') closeDrawer(); }
      function onSort() {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', sort.value);
        url.searchParams.delete('page');
        window.location.href = url.toString();
      }
      root.addEventListener('click', onClick);
      document.addEventListener('keydown', onKey);
      if (sort) sort.addEventListener('change', onSort);

      root._ctlCleanup = function () {
        root.removeEventListener('click', onClick);
        document.removeEventListener('keydown', onKey);
        if (sort) sort.removeEventListener('change', onSort);
        document.documentElement.style.overflow = '';
        root._ctlInit = false;
      };
    }

    function rootFor(id) {
      var host = document.getElementById('shopify-section-' + id);
      return host && host.querySelector('[data-ctl]');
    }
    if (rootFor(SECTION_ID)) init(rootFor(SECTION_ID));
    else document.addEventListener('DOMContentLoaded', function () { init(rootFor(SECTION_ID)); });

    if (!window.__ctlEditorBound) {
      window.__ctlEditorBound = true;
      document.addEventListener('shopify:section:load', function (e) { init(rootFor(e.detail.sectionId)); });
      document.addEventListener('shopify:section:unload', function (e) {
        var r = rootFor(e.detail.sectionId);
        if (r && r._ctlCleanup) r._ctlCleanup();
      });
    }
  })();
</script>

