{% comment %}
  /sections/featured-collection.liquid
  
  Featured Collection section — 4 cards/slide desktop, 1.2 mobile
  Uses product-card-custom snippet for card rendering
  Swiper-powered slider with Pipeline 8.x compatibility
{% endcomment %}

{%- liquid
  assign section_id  = 'fc-' | append: section.id
  assign collection  = collections[section.settings.collection]
  assign heading     = section.settings.heading
  assign pt_desktop  = section.settings.padding_top_desktop    | default: 48
  assign pb_desktop  = section.settings.padding_bottom_desktop | default: 64
  assign pt_mobile   = section.settings.padding_top_mobile     | default: 32
  assign pb_mobile   = section.settings.padding_bottom_mobile  | default: 48
  assign products    = collection.products
-%}

<style>
  /* ── Section wrapper ────────────────────────── */
  #{{ section_id }} {
    padding-top:    {{ pt_desktop }}px;
    padding-bottom: {{ pb_desktop }}px;
    background: #FFFCF9;
  }

  /* ── Inner container ────────────────────────── */
  #{{ section_id }} .fc-inner {
    max-width: 1720px;
    margin: 0 auto;
    padding: 0;
  }


  /* ── Heading ────────────────────────────────── */
  #{{ section_id }} .fc-heading {
    font-family: 'Blauer Nue RG';
    font-size: 40px;
    font-weight: 400;
    letter-spacing: -2%;
    color: #1C1712;
    margin: 0 0 40px;
    line-height: 100%;
  }

  

  /* ── Swiper overrides ───────────────────────── */
  #{{ section_id }} .fc-swiper {
    overflow: visible;
  }

  /* Clip overflow only on the track itself */
  #{{ section_id }} .fc-swiper-clip {
    overflow: hidden;
  }

  #{{ section_id }} .swiper-slide {
    height: auto; /* let cards stretch equally */
  }

  /* Make each card fill its slide */
  #{{ section_id }} .swiper-slide .pcc__card {
    max-width: 100%;
    width: 100%;
    height: 100%;
  }

  /* ── Empty state ────────────────────────────── */
  #{{ section_id }} .fc-empty {
    font-family: 'Georgia', serif;
    font-size: 14px;
    color: #8A7D72;
    padding: 40px 0;
  }
  @media(max-width: 1720px){
    #{{ section_id }} .fc-inner {
        padding: 0 0 0 16px;
    }
}
@media (max-width: 1200px) {
    #{{ section_id }} .fc-heading {
      font-size: 36px;
    }
  }
@media (max-width: 768px) {
    #{{ section_id }} .fc-heading {
      margin-bottom: 28px;
      padding-right: 16px;
    }
    #{{ section_id }} .fc-inner {
      padding: 0 16px;
    }
    #{{ section_id }} {
      padding-top:    {{ pt_mobile }}px;
      padding-bottom: {{ pb_mobile }}px;
    }
  }
  @media (max-width: 500px) {
    #{{ section_id }} .fc-heading {
      font-size: 28px;
    }
  }
</style>

<div id="{{ section_id }}">
  <div class="fc-inner">

    {%- if heading != blank -%}
      <h2 class="fc-heading">{{ heading }}</h2>
    {%- endif -%}

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="fc-swiper-clip">
        <div class="swiper fc-swiper" id="{{ section_id }}-swiper">
          <div class="swiper-wrapper">
            {%- for product in products limit: section.settings.products_limit -%}
              <div class="swiper-slide">
                {% render 'product-card-custom', product: product, eagerload: forloop.first %}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- elsif collection == blank -%}
      <p class="fc-empty">{{ 'sections.featured_collection.no_collection' | t | default: 'Select a collection to display products.' }}</p>
    {%- else -%}
      <p class="fc-empty">{{ 'sections.featured_collection.empty' | t | default: 'This collection has no products yet.' }}</p>
    {%- endif -%}

  </div>
</div>

<script>
(function () {
  function initFeaturedCollection() {
    var swiperEl = document.getElementById('{{ section_id }}-swiper');
    if (!swiperEl || typeof Swiper === 'undefined') return;

    new Swiper(swiperEl, {
      /* Desktop: 4 full cards */
      slidesPerView: 4,
      spaceBetween: 10,

      /* No loop — clean UX for a finite product list */
      loop: false,

      /* Momentum-style touch */
      grabCursor: true,
      freeMode: {
        enabled: false,
      },

      breakpoints: {
        /* ≥1400px: 4 cards */
        1400: {
          slidesPerView: 4,
          spaceBetween: 10,
        },
        /* ≥1024px: 4 cards */
        1024: {
          slidesPerView: 3,
          spaceBetween: 10,
        },
        /* 768–1023px: 3 cards */
        768: {
          slidesPerView: 2.3,
          spaceBetween: 10,
        },
        /* 480–767px: 2 cards */
        480: {
          slidesPerView: 2.3,
          spaceBetween: 10,
        },
        /* <480px: 1.2 cards (peek effect) */
        0: {
          slidesPerView: 1.2,
          spaceBetween: 8,
        },
      },
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof Swiper !== 'undefined') {
        initFeaturedCollection();
      } else {
        /* Wait for deferred Swiper script */
        var scripts = document.querySelectorAll('script[src*="swiper"]');
        if (scripts.length) {
          scripts[scripts.length - 1].addEventListener('load', initFeaturedCollection);
        }
      }
    });
  } else {
    if (typeof Swiper !== 'undefined') {
      initFeaturedCollection();
    } else {
      var scripts = document.querySelectorAll('script[src*="swiper"]');
      if (scripts.length) {
        scripts[scripts.length - 1].addEventListener('load', initFeaturedCollection);
      }
    }
  }
})();
</script>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Maximum products to show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top — desktop (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom — desktop (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — mobile (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — mobile (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}