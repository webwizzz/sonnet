{% style %}
#shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.color_background != blank %}
        background-color: {{ section.settings.color_background }};
    {% endif %}
    {% if section.settings.color_text != blank %}
        color: {{ section.settings.color_text }};
    {% endif %}
    overflow: hidden;
}
img.topba_image {
    width: 100%;
    height: 100%;
}

.top-ba_wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 10px;
}

.test-slide {
    display: flex;
    flex-direction: column;
}

.test_is-wrap {
    width: 530px;
}

.test-wrapper {
    display: flex;
}
img.start_image {
    max-width: 96px;
}

span.rating-text {
    font-family: 'Blauer Nue MD';
    font-weight: 500;
    font-size: 16px;
    line-height: 130%;
    letter-spacing: 0;
    display: block;
}

.rating-div {
    display: flex;
    align-items: center;
    gap: 8px;
}

.skin-type {
    font-family: 'Blauer Nue RG';
    font-weight: 400;
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0;
    text-transform: uppercase;
}
.block_name {
    margin-top: 54px;
}

.block_name em {
    font-family: 'Blauer Nue LT';
    font-weight: 300;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;
    font-style: normal;
    text-transform: math-auto;
}
.top-rating-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px;
}

.block_description {
    font-family: 'Blauer Nue LT';
    font-weight: 400;
    font-size: 16px;
    line-height: 130%;
    letter-spacing: 0;
    color: #28201FCC;
}

.block_description strong {
    font-weight: 500;
    text-transform: uppercase;
    font-family: 'Blauer Nue MD';
    display: block;
    margin-bottom: 16px;color: #28201F;
}

.block_name {
    font-family: 'Blauer Nue RG';
    font-weight: 400;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;
    text-transform: uppercase;
}
.test_is-wrap {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 10px;
    height: 100%;
}
.block_name strong {
    font-family: 'Blauer Nue MD';
    font-weight: 500;
}

.block_name em {
    border-left: 1px solid #28201F1A;
    padding-left: 8px;
}
.top-ba_tag_wrap {
    display: flex;
    padding: 5px 12px;
    border-radius: 50px;
    font-family: 'BLAUER NUE RG';
    font-weight: 400;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0;
    text-transform: uppercase;
    position: absolute;
    top: 10px;
}

.top-ba_tag_wrap.is-1 {
    background: #28201F;
    color: #FFF;
    left: 10px;
}

.top-ba_tag_wrap.is-2 {
    color: #28201F;
    background: #FFF;
    min-width: 65px;
    right: 10px;
}
.block_name p {
    margin: 0;
}


.bottom_review-block p {
    margin: 0;
}

.bottom_review-block {
    padding: 24px;
    min-height: 200px;
    border-top: 1px  solid #28201F0F;
}
.testimonial_section .test-swiper {
    overflow: hidden;
    display: grid;
}
.test-bottom_wrap {
    border-radius: 10px;
    background: #F5EEE6;
    height: auto;
}
@media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
    .test_is-wrap {
        width: 100%;
        flex: none;
    }

    .test-slide {
        width: 100%;
        flex: none;
    }
    .top-rating-wrap {
    padding: 18px 16px 13px;
}

.bottom_review-block {
    padding: 16px;
}

.block_name {
    margin-top: 23px;
    font-size: 14px;
}

.block_description strong {
    margin-bottom: 10px;
}

.block_description {
    font-size: 14px;
}

.skin-type {
    font-size: 14px;
}

span.rating-text {
    font-size: 14px;
}

img.start_image {
    max-width: 82px;
}

.block_name em {
    font-size: 14px;
}
}
{% endstyle %}

<div class="relative{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}">
    <div class="main-container">
        <div class="title-wrap">
            <h2 class="class_h2">{{section.settings.title }}</h2>
            <div class="arrow-wrap">
                <div class="arrow-slider is-next">
                 {% render 'arrow-right' %}
                </div>
                <div class="arrow-slider is-prev">
                  {% render 'arrow-left' %}
                </div>
            </div>
        </div>
      <div class="test-{{ section.id }} test-swiper">
          <div class="test-wrapper">
            {% for block in section.blocks %}
                <div class="test-slide">
                    <div class="test_is-wrap">
                    <div class="top-ba_wrap">
                                <div class="top-ba_tag_wrap is-1">
                                     {{ section.settings.tag1 }}
                                </div>
                                {% if block.settings.image != blank %}
                                    <img class="topba_image" preload width="" height="" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.title }}">
                                {% endif %}
                                <div class="top-ba_tag_wrap is-2">
                                    {{ section.settings.tag2 }}
                                </div>
                    </div>
                    <div class="test-bottom_wrap">
                        <div class="top-rating-wrap">
                            <div class="rating-div">
                            {% if block.settings.image1 != blank %}
                                <img class="start_image" preload width="" height="" src="{{ block.settings.image1 | image_url }}" alt="{{ block.settings.title }}">
                            {% endif %}
                                <span class="rating-text">{{ block.settings.t1 }}</span>
                            </div>
                            <div class="skin-type">
                                {{ block.settings.t }}
                            </div>
                        </div>
                        <div class="bottom_review-block">
                            <div class="block_description">
                                {{ block.settings.t2 }}
                            </div>
                            <div class="block_name">
                                {{ block.settings.t3 }}
                            </div>
                        </div>
                    </div>   
                    </div>  
                </div>   
            {% endfor %}
              
          </div>
          {% comment %} <div class="slider-pagination pagination-{{ section.id }}"></div> {% endcomment %}
      </div>
    </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
      const test_swiper = new Swiper('.test-{{ section.id }}', {
          slidesPerView: "auto",
          spaceBetween: 10,
          speed: 500,
          wrapperClass:'test-wrapper',
          slideClass:'test-slide',
          {% if section.settings.check1 != false %}
          loop: true,
          autoplay: {
              delay: {{ section.settings.duration | times: 1000 }},
          },
          {% endif %}
          navigation: {
                nextEl: ".arrow-slider.is-next",
                prevEl: ".arrow-slider.is-prev",
          },
          pagination: {
              el: '.pagination-{{ section.id }}',
              clickable: true,
          },
          breakpoints: {
              0: {        
                  slidesPerView: 1.2
              },
              480: {     
                  slidesPerView: "auto"
              }
          }
      });
  });
</script>

{% schema %}
{
  "name": "Testimonial Section",
  "class": "index-section testimonial_section",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "tag1",
      "label": "Tag 1"
    },
      {
        "type": "text",
        "id": "tag2",
        "label": "Tag 2"
      },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "checkbox",
      "id": "check1",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "duration",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay delay",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background Color"
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Before After Image"
        },
        {
          "type": "image_picker",
          "id": "image1",
          "label": "Star Image"
        },
        {
          "type": "text",
          "id": "t1",
          "label": "Star Rating"
        },
        {
          "type": "text",
          "id": "t",
          "label": "Skin Type"
        },
        {
          "type": "richtext",
          "id": "t2",
          "label": "Review"
        },
        {
          "type": "richtext",
          "id": "t3",
          "label": "Name"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Section"
    }
  ]
}
{% endschema %}