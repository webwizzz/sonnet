{% style %}
#shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.color_background != blank %}
        background-color: {{ section.settings.color_background }};
    {% endif %}
    {% if section.settings.color_text != blank %}
        color: {{ section.settings.color_text }};
    {% endif %}
}
.title-center-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 40px;
}

.why_tag {
    font-style: italic;
    padding: 9px 20px;
    font-family: Blauer Nue MD;
    font-weight: 500;
    font-size: 16px;
    line-height: 140%;
    letter-spacing: 0;
    text-transform: uppercase;
    border-radius: 50px;
    background: #78563D;
    color: #FFF;
}

.inside-why {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 80px 50px 50px;
    border: 1px solid #28201F1A;
    border-radius: 16px;
}

.why-dec {
    font-family: Blauer Nue TH;
    font-weight: 200;
    font-size: 18px;
    line-height: 140%;
    letter-spacing: 0;
}

.why_bttom-tag {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 64px;
}

.inside-why p {
    margin: 0;
}

.why_number {
        font-family: 'Test Tiempos Fine Italic RG';
    font-weight: 500;
    font-size: 50px;
    line-height: 100%;
    color: #78563D;
    letter-spacing: 0;
}

.why_number-text {
    font-family: Blauer Nue TH;
    font-weight: 200;
    font-size: 16px;
    line-height: 130%;
    letter-spacing: 0;
}

.why-number-block {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 30px;
    border-top: 1px solid #28201F1A;
    width: 100%;
    margin-top: 30px;
}
.why-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 20px;
    overflow: hidden;
}

img.why_image {
    width: 100%;
    height: 100%;
    object-fit:cover;
}

.why-left {
    padding: 30px;
    background: #FFFFFF;
}
.why-block {
    position: sticky;
    top: 50px;
}

.alloftop {
    max-width: 1620px;
    padding: 0px 50px;
    margin:auto;
}
.why-block.is-4 {
    top: 170px;
}
.why-block.is-1 {
    margin-bottom: 140px;
}

.why-block.is-2 {
    margin-bottom: 110px;
    top: 90px;
}

.why-block.is-3 {
    margin-bottom: 60px;
    top: 130px;
}
@media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
    .alloftop {
        padding: 0px 16px;
    }

    .Why_Section .title-center-wrap {
        margin-bottom: 18px;
    }

    .Why_Section h2.class_h2 {
        max-width: 300px;
        line-height: 130%;
    }

    .why-block {
        display: flex;
        flex-direction: column-reverse;
    }
}
@media only screen and (max-width: 600px) {
.why-left {
    padding: 10px;
}

.inside-why {
    padding: 30px 20px 20px;
}

.why_tag {
    font-size: 11px;
    padding: 8px 12px;
}

.why_bttom-tag {
    margin-top: 54px;
}

.why-dec {
    font-size: 14px;
}

.why-number-block {
    padding-top: 20px;
    margin-top: 20px;
}

.why_number-text {
    font-size: 14px;
}

.why_number {
    font-size: 34px;
    flex: none;
}

.why-block.is-1 {
    top: 0;
    margin-bottom: 170px;
}

.why-block.is-2 {
    top: 50px;
    margin-bottom: 100px;
}

.why-block.is-3 {
    top: 110px;
    margin-bottom: 42px;
}

.why-block.is-4 {
    top: 130px;
}
}
{% endstyle %}

<div class="relative{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}">
    <div class="sticky-container">
        <div class="title-center-wrap">
            <h2 class="class_h2">{{section.settings.title }}</h2>
        </div>
        <div class="alloftop">
            {% for block in section.blocks %}
                <div class="why-block is-{{ forloop.index }}">
                    <div class="why-left">
                        <div class="inside-why">
                            <div class="why_tag">{{ block.settings.t1 }}</div>
                            <div class="why_bttom-tag">
                                <div class="why-dec">{{ block.settings.desc }}</div>
                                <div class="why-number-block">
                                    <div class="why_number">{{ block.settings.title }}</div>
                                    <div class="why_number-text">{{ block.settings.title1 }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="why-right">
                        {% if block.settings.image != blank %}
                            <img class="why_image" preload width="" height="" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.title }}">
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<script>
const cards = document.querySelectorAll('.why-block');

function handleScroll() {
  const viewportHeight = window.innerHeight;

  cards.forEach((card, index) => {
    const rect = card.getBoundingClientRect();

    const start = viewportHeight * 0.5;   // equivalent to 'top 80%'
    const end = -viewportHeight * 0.4;    // equivalent to 'bottom -40%'

    const progress = (start - rect.top) / (start - end);

    // Clamp between 0 and 1
    const clamped = Math.max(0, Math.min(1, progress));

    const scale = 1 - (cards.length - index) * 0.05 * clamped;

    card.style.transform = `scale(${scale})`;
  });
}

window.addEventListener('scroll', handleScroll);
window.addEventListener('load', handleScroll);
</script>

{% schema %}
{
  "name": "Why Section",
  "class": "index-section Why_Section",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background Color"
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Side Image"
        },
       {
          "type": "text",
          "id": "t1",
          "label": "Tag Line"
        },
        {
          "type": "richtext",
          "id": "desc",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Number"
        },
        {
          "type": "richtext",
          "id": "title1",
          "label": "Number Text"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Section"
    }
  ]
}
{% endschema %}