{%- comment -%}
  What's Inside Carousel + Tabs
  Same centre-mode, timer-driven ingredient carousel, split into pill tabs (e.g. FACE WASH / FACE CREAM).
  Block order in the editor decides the grouping:
    [Tab: Face wash] [Ingredient] [Ingredient] ... [Tab: Face cream] [Ingredient] ...
  Every ingredient belongs to the nearest Tab block above it (ingredients above the first tab join the first tab).
  With no Tab blocks it behaves exactly like the single carousel and the tab bar is hidden.
  Each tab panel is its own carousel instance; hidden panels pause automatically.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign color_text = s.color_text | default: '#28201F'
  assign active_size = s.active_size | default: 400
  assign speed = s.autoplay_speed | default: 5
  assign mobile_size = active_size | times: 0.55 | round
  assign ring_track = 'none'
  if s.color_ring_track != blank
    assign ring_track = s.color_ring_track
  endif

  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign tab_total = tab_blocks.size
  assign group_total = tab_total | at_least: 1
  assign ingredient_total = section.blocks | where: 'type', 'ingredient' | size

  assign wist_classes = 'wis wist'
  if s.custom_class != blank
    assign wist_classes = wist_classes | append: ' ' | append: s.custom_class
  endif

  assign image_sizes = '(min-width: 769px) ' | append: active_size | append: 'px, ' | append: mobile_size | append: 'px'
  assign image_widths = '220, 300, 400, 440, 600, 800, 960'
-%}

{% style %}
#shopify-section-{{ section.id }} {
  --wis-bg: {{ s.color_background | default: '#FFFCF9' }};
  --wis-text: {{ color_text }};
  --wis-text-85: {{ color_text | color_modify: 'alpha', 0.85 }};
  --wis-text-50: {{ color_text | color_modify: 'alpha', 0.5 }};
  --wis-text-12: {{ color_text | color_modify: 'alpha', 0.12 }};
  --wis-text-06: {{ color_text | color_modify: 'alpha', 0.06 }};
  --wis-accent: {{ s.color_accent | default: '#78563D' }};
  --wis-arrow-bg: {{ s.color_arrow_bg | default: '#F6F3EE' }};
  --wis-tab-bg: {{ s.color_tab_bg | default: '#FFFFFF' }};
  --wis-track: {{ ring_track }};
  --wis-s: {{ active_size }};
  --wis-h: {{ s.heading_size | default: 58 }};
  --wis-h-mobile: {{ s.heading_size_mobile | default: 28 }}px;
  background-color: var(--wis-bg);
}
#shopify-section-{{ section.id }} .wist {
  padding-top: {{ s.padding_top }}px;
  padding-bottom: {{ s.padding_bottom }}px;
}
@media only screen and (max-width: 768px) {
  #shopify-section-{{ section.id }} .wist {
    padding-top: {{ s.mobile_padding_top }}px;
    padding-bottom: {{ s.mobile_padding_bottom }}px;
  }
}

/* ---------- Shared rules (.wis) ---------- */
.wis {
  --wis-u: clamp(0.5px, calc(100vw / 1920), 1px);
  --wis-a: clamp(calc(var(--wis-s) * 0.75px), calc(var(--wis-s) * 0.75px + (100vw - 990px) * var(--wis-s) / 3720), calc(var(--wis-s) * 1px));
  --wis-pitch: calc(var(--wis-a) * 1.2);
  --wis-near: calc(var(--wis-pitch) * 1.0260417);
  --wis-outer: max(50vw, calc(var(--wis-a) * 2.16));
  --wis-ring-w: 6.15;
  --wis-move: 760ms;
  --wis-ease: cubic-bezier(0.65, 0, 0.35, 1);
  --wis-fade: 420ms;
  --wis-arrow: max(40px, calc(46 * var(--wis-u)));
  --wis-arrow-gap: max(24px, calc(50 * var(--wis-u)));
  --wis-desc-w: max(300px, calc(352 * var(--wis-u)));
  position: relative;
  overflow: hidden;
  overflow: clip;
  color: var(--wis-text);
  background-color: var(--wis-bg);
}
@supports (width: 1cqw) {
  .wis { --wis-outer: max(50cqw, calc(var(--wis-a) * 2.16)); }
}
.wis *,
.wis *::before,
.wis *::after { box-sizing: border-box; }
.wis[hidden] { display: none !important; }

.wis .wis__heading {
  margin: 0 auto;
  padding: 0 16px;
  max-width: 1720px;
  font-family: 'Blauer Nue MD', sans-serif;
  font-weight: 500;
  font-style: normal;
  font-size: max(32px, calc(var(--wis-h) * var(--wis-u)));
  line-height: 1.207;
  letter-spacing: -0.02em;
  text-align: center;
  text-transform: none;
  color: var(--wis-text);
  text-wrap: balance;
}
.wis .wis__heading p { margin: 0; font: inherit; letter-spacing: inherit; line-height: inherit; }
.wis .wis__heading em,
.wis .wis__heading i {
  font-family: 'Test Tiempos Fine Italic RG', 'Test Tiempos Fine Italic', serif;
  font-weight: 400;
  font-style: italic;
  letter-spacing: -0.02em;
  line-height: 1;
}

/* ---------- Tabs ---------- */
.wis .wis__tabs {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin: 0 auto;
  padding: 0 16px;
}
.wis__heading + .wis__tabs { margin-top: max(20px, calc(32 * var(--wis-u))); }
.wis .wis__tab {
  -webkit-appearance: none;
  appearance: none;
  margin: 0;
  padding: 12px 28px;
  min-width: 150px;
  border: 1px solid var(--wis-accent);
  border-radius: 999px;
  background-color: var(--wis-tab-bg);
  box-shadow: none;
  color: var(--wis-text);
  font-family: 'Blauer Nue MD', sans-serif;
  font-weight: 500;
  font-size: 14px;
  line-height: 1.2;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  white-space: nowrap;
  cursor: pointer;
  transition: background-color 0.3s ease, color 0.3s ease;
}
.wis .wis__tab.is-active {
  background-color: var(--wis-accent);
  color: #FFFFFF;
}
@media (hover: hover) {
  .wis .wis__tab:not(.is-active):hover { background-color: var(--wis-text-06); }
}
.wis .wis__tab:focus { outline: none; }
.wis .wis__tab:focus-visible { outline: 2px solid var(--wis-accent); outline-offset: 3px; }

/* ---------- Circle row ---------- */
.wis__carousel { position: relative; }
.wis__tabs ~ .wis__panel .wis__carousel,
.wist > .wis__heading ~ .wis__panel .wis__carousel { margin-top: max(28px, calc(50 * var(--wis-u))); }
.wis__stage {
  position: relative;
  height: calc(var(--wis-a) * 1.025);
  container-type: inline-size;
  touch-action: pan-y;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
  -webkit-user-select: none;
}
.wis__track { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
.wis__item {
  --o: 0;
  --step: calc((var(--wis-outer) + var(--wis-pitch)) / 3);
  --sc: 0.6;
  position: absolute;
  z-index: 0;
  top: calc(50% - var(--wis-a) / 2);
  left: calc(50% - var(--wis-a) / 2);
  width: var(--wis-a);
  height: var(--wis-a);
  border-radius: 50%;
  transform: translate3d(calc(var(--o) * var(--step)), 0, 0) scale(var(--sc));
  transform-origin: 50% 50%;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition:
    transform var(--wis-move) var(--wis-ease),
    opacity var(--wis-fade) ease,
    visibility 0s linear var(--wis-fade);
  will-change: transform;
}
.wis__item[data-slot="0"],
.wis__item[data-slot="1"],
.wis__item[data-slot="2"] {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition:
    transform var(--wis-move) var(--wis-ease),
    opacity var(--wis-fade) ease,
    visibility 0s linear 0s;
}
.wis__item[data-slot="0"] { --sc: 1; z-index: 3; pointer-events: none; }
.wis__item[data-slot="1"] { --sc: 0.75; --step: var(--wis-near); z-index: 2; }
.wis__item[data-slot="2"] { --sc: 0.6; --step: calc(var(--wis-outer) / 2); z-index: 1; }
.wis__item.is-jump,
.wis--instant .wis__item { transition: none !important; }

.wis__media {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border-radius: 50%;
  background-color: var(--wis-text-06);
  transform: translateZ(0);
}
.wis .wis__media img,
.wis .wis__media .wis__placeholder {
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  border-radius: 50%;
  pointer-events: none;
  -webkit-user-drag: none;
}
.wis .wis__media .wis__placeholder { fill: var(--wis-text-12); }
.wis .wis__hit {
  -webkit-appearance: none;
  appearance: none;
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  box-shadow: none;
  cursor: pointer;
}
.wis .wis__hit[hidden] { display: none; }
.wis .wis__hit:focus { outline: none; }
.wis .wis__hit:focus-visible { outline: 3px solid var(--wis-accent); outline-offset: 6px; }
@media (hover: hover) {
  .wis__item[data-slot="1"] .wis__media,
  .wis__item[data-slot="2"] .wis__media { transition: filter 0.3s ease; }
  .wis__item[data-slot="1"]:hover .wis__media,
  .wis__item[data-slot="2"]:hover .wis__media { filter: brightness(1.06); }
}

.wis__ring {
  position: absolute;
  z-index: 4;
  top: 0;
  left: calc(50% - var(--wis-a) * 0.5125);
  display: block;
  width: calc(var(--wis-a) * 1.025);
  height: calc(var(--wis-a) * 1.025);
  overflow: visible;
  transform: rotate(-90deg);
  pointer-events: none;
  opacity: 1;
  transition: opacity 240ms ease;
}
.wis__ring.is-hidden { opacity: 0; transition-duration: 200ms; }
.wis__ring--invisible { visibility: hidden; }
.wis__ring circle { fill: none; stroke-width: var(--wis-ring-w); }
.wis__ring-track { stroke: var(--wis-track); }
.wis__ring-bar { stroke: var(--wis-accent); stroke-dasharray: 100 100; stroke-dashoffset: 100; }
.wis__ring.is-full .wis__ring-bar { stroke-dashoffset: 0; }
.wis--instant .wis__ring { transition: none !important; }

/* ---------- Title / description ---------- */
.wis__body {
  display: grid;
  grid-template-columns: var(--wis-arrow) var(--wis-desc-w) var(--wis-arrow);
  grid-template-areas:
    "title title title"
    "prev desc next";
  column-gap: var(--wis-arrow-gap);
  row-gap: max(10px, calc(14 * var(--wis-u)));
  justify-content: center;
  align-items: center;
  margin-top: max(20px, calc(30 * var(--wis-u)));
  padding: 0 16px;
}
.wis__body--single { grid-template-columns: var(--wis-desc-w); grid-template-areas: "title" "desc"; }
.wis__slide { display: contents; }
.wis .wis__title,
.wis .wis__desc {
  min-width: 0;
  margin: 0;
  text-align: center;
  opacity: 0;
  visibility: hidden;
  transform: translate3d(0, 16px, 0);
  transition: opacity 300ms ease, transform 300ms ease, visibility 0s linear 300ms;
}
.wis .wis__title {
  grid-area: title;
  align-self: end;
  font-family: 'Blauer Nue MD', sans-serif;
  font-weight: 500;
  font-style: normal;
  font-size: max(20px, calc(24 * var(--wis-u)));
  line-height: 1.4;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: var(--wis-text);
}
.wis .wis__desc {
  grid-area: desc;
  align-self: start;
  justify-self: center;
  width: 100%;
  font-family: 'Blauer Nue TH', sans-serif;
  font-weight: 200;
  font-style: normal;
  font-size: max(16px, calc(18 * var(--wis-u)));
  line-height: 1.4;
  letter-spacing: -0.02em;
  color: var(--wis-text-85);
}
.wis__slide.is-active .wis__title,
.wis__slide.is-active .wis__desc {
  opacity: 1;
  visibility: visible;
  transform: none;
  transition:
    opacity 480ms ease 160ms,
    transform 620ms cubic-bezier(0.22, 1, 0.36, 1) 160ms,
    visibility 0s linear 0s;
}
.wis__slide.is-active .wis__desc { transition-delay: 250ms, 250ms, 0s; }
.wis__slide.is-leaving .wis__title,
.wis__slide.is-leaving .wis__desc { transform: translate3d(0, -12px, 0); }
.wis__slide.is-leaving .wis__desc { transition-delay: 40ms, 40ms, 340ms; }
.wis--instant .wis__title,
.wis--instant .wis__desc { transition: none !important; }

.wis .wis__arrow {
  -webkit-appearance: none;
  appearance: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--wis-arrow);
  height: var(--wis-arrow);
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  box-shadow: none;
  cursor: pointer;
  background-color: var(--wis-arrow-bg);
  color: var(--wis-text);
  transition: background-color 0.3s ease, color 0.3s ease, opacity 0.3s ease;
}
.wis .wis__arrow svg { display: block; width: 18px; height: 18px; flex: none; }
.wis .wis__arrow--prev { grid-area: prev; }
.wis .wis__arrow--next { grid-area: next; background-color: var(--wis-accent); color: #FFFFFF; }
@media (hover: hover) {
  /* Hover moves the filled state to the hovered arrow, so only one is ever dark (same as the other sliders) */
  .wis .wis__arrow--prev:hover ~ .wis__arrow--next { background-color: var(--wis-arrow-bg); color: var(--wis-text); }
  .wis .wis__arrow:hover { background-color: var(--wis-accent); color: #FFFFFF; }
}
.wis .wis__arrow:focus { outline: none; }
.wis .wis__arrow:focus-visible { outline: 2px solid var(--wis-accent); outline-offset: 3px; }

.wis .wis__toggle {
  -webkit-appearance: none;
  appearance: none;
  position: absolute;
  z-index: 6;
  top: 8px;
  left: 50%;
  margin: 0;
  padding: 8px 16px;
  border: 0;
  border-radius: 30px;
  background-color: var(--wis-accent);
  color: #FFFFFF;
  font-family: 'Blauer Nue RG', sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 1.2;
  letter-spacing: -0.02em;
  white-space: nowrap;
  cursor: pointer;
  transform: translateX(-50%);
  clip-path: inset(50%);
  opacity: 0;
}
.wis .wis__toggle:focus { outline: none; }
.wis .wis__toggle:focus-visible { clip-path: none; opacity: 1; outline: 2px solid var(--wis-accent); outline-offset: 3px; }

.wis__sr {
  position: absolute !important;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
.wis__empty {
  margin: 24px auto 0;
  padding: 0 16px;
  font-family: 'Blauer Nue LT', sans-serif;
  font-weight: 300;
  font-size: 16px;
  line-height: 1.5;
  text-align: center;
  color: var(--wis-text-50);
}

@media only screen and (max-width: 990px) {
  .wis__item[data-slot="2"] { opacity: 0; visibility: hidden; pointer-events: none; }
}

@media only screen and (max-width: 768px) {
  .wis {
    --wis-a: calc(var(--wis-s) * 0.55px);
    --wis-pitch: min(calc(50vw + 40px), calc(var(--wis-a) * 1.2));
    --wis-near: var(--wis-pitch);
    --wis-ring-w: 7.3;
    --wis-arrow: 40px;
    --wis-desc-w: min(280px, 100%);
  }
  .wis .wis__heading { font-size: var(--wis-h-mobile); }
  .wis .wis__tabs { gap: 8px; }
  .wis .wis__tab { min-width: 0; padding: 10px 20px; font-size: 13px; }
  .wis__tabs ~ .wis__panel .wis__carousel,
  .wist > .wis__heading ~ .wis__panel .wis__carousel { margin-top: 28px; }
  .wis__body {
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "title title" "desc desc" "prev next";
    column-gap: 8px;
    row-gap: 10px;
    margin-top: 20px;
  }
  .wis__body--single { grid-template-columns: 1fr; grid-template-areas: "title" "desc"; }
  .wis .wis__title { font-size: 18px; line-height: 1.3; text-wrap: balance; }   /* long names break evenly, not one word on line 2 */
  .wis .wis__desc { max-width: 280px; font-size: 16px; }
  .wis .wis__arrow--prev { justify-self: end; margin-top: 10px; }
  .wis .wis__arrow--next { justify-self: start; margin-top: 10px; }
}

@media (prefers-reduced-motion: reduce) {
  .wis__item,
  .wis__item[data-slot="0"],
  .wis__item[data-slot="1"],
  .wis__item[data-slot="2"] { transition: opacity 200ms ease, visibility 0s linear 0s; }
  .wis .wis__title,
  .wis .wis__desc,
  .wis__slide.is-leaving .wis__title,
  .wis__slide.is-leaving .wis__desc,
  .wis__slide.is-active .wis__title,
  .wis__slide.is-active .wis__desc { transform: none; transition: opacity 200ms ease, visibility 0s linear 0s; }
  .wis .wis__arrow,
  .wis .wis__tab { transition: none; }
}
{% endstyle %}

{%- if ingredient_total > 0 or request.design_mode -%}
<div class="{{ wist_classes | escape }}" data-wist="{{ section.id }}">
  {%- if s.heading != blank -%}
    <h2 class="wis__heading class_h2" id="wis-heading-{{ section.id }}">{{ s.heading }}</h2>
  {%- endif -%}

  {%- if ingredient_total == 0 -%}
    <p class="wis__empty">Add a Tab block, then Ingredient blocks under it.</p>
  {%- else -%}

    {%- if tab_total > 1 -%}
      <div class="wis__tabs" role="tablist" aria-label="Products">
        {%- for tab in tab_blocks -%}
          <button
            type="button"
            class="wis__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            id="wis-tab-{{ section.id }}-{{ forloop.index }}"
            aria-controls="wis-panel-{{ section.id }}-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {% unless forloop.first %}tabindex="-1"{% endunless %}
            data-wist-tab
            data-block-id="{{ tab.id }}"
            {{ tab.shopify_attributes }}
          >{{ tab.settings.label | default: 'Tab' | escape }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for g in (1..group_total) -%}
      {%- liquid
        # Count this tab's ingredients (ingredient -> nearest Tab block above it; before the first tab -> tab 1)
        assign block_count = 0
        assign seen = 0
        for block in section.blocks
          if block.type == 'tab'
            assign seen = seen | plus: 1
          else
            assign grp = seen | at_least: 1
            if grp == g
              assign block_count = block_count | plus: 1
            endif
          endif
        endfor

        assign reach = 1
        if block_count >= 4
          assign reach = 2
        endif
        assign reach_park = reach | plus: 1
        assign reach_park_neg = 0 | minus: reach_park
        assign half = block_count | divided_by: 2

        assign timer_on = false
        if s.autoplay and block_count > 1
          assign timer_on = true
        endif

        assign panel_classes = 'wis wis__panel'
        if block_count < 2
          assign panel_classes = panel_classes | append: ' wis--static'
        endif

        assign gi = g | minus: 1
        assign tab_label = 'Ingredients'
        if tab_total > 0
          assign tab_label = tab_blocks[gi].settings.label | default: 'Ingredients'
        endif
      -%}
      <div
        class="{{ panel_classes }}"
        id="wis-panel-{{ section.id }}-{{ g }}"
        data-wis
        data-wist-panel
        data-section-id="{{ section.id }}"
        data-wis-key="{{ section.id }}--{{ g }}"
        data-autoplay="{{ timer_on }}"
        data-speed="{{ speed }}"
        data-reach="{{ reach }}"
        {% if tab_total > 1 %}role="tabpanel" aria-labelledby="wis-tab-{{ section.id }}-{{ g }}"{% endif %}
        {% if g > 1 %}hidden{% endif %}
      >
        {%- if block_count == 0 -%}
          <p class="wis__empty">Add Ingredient blocks under this tab.</p>
        {%- else -%}
          <div
            class="wis__carousel"
            data-wis-carousel
            role="region"
            aria-roledescription="carousel"
            aria-label="{{ tab_label | escape }} ingredients"
          >
            {%- if timer_on -%}
              <button type="button" class="wis__toggle" data-wis-toggle aria-pressed="false">Pause ingredient rotation</button>
            {%- endif -%}

            <div class="wis__stage" data-wis-stage>
              <div class="wis__track" data-wis-track>
                {%- assign seen = 0 -%}
                {%- assign i = 0 -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tab' -%}
                    {%- assign seen = seen | plus: 1 -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- assign grp = seen | at_least: 1 -%}
                  {%- if grp != g -%}{%- continue -%}{%- endif -%}
                  {%- liquid
                    assign b = block.settings
                    assign pos = i
                    if i > half
                      assign pos = i | minus: block_count
                    endif
                    assign apos = pos | abs
                    assign slot = 'x'
                    if apos <= reach
                      assign slot = apos
                    endif
                    assign off = pos
                    if pos > reach_park
                      assign off = reach_park
                    elsif pos < reach_park_neg
                      assign off = reach_park_neg
                    endif
                    assign name = b.name | default: 'Ingredient'
                    assign img_alt = b.image.alt | default: name
                    assign img_loading = 'lazy'
                    if i == 0 and g == 1
                      assign img_loading = 'eager'
                    endif
                  -%}
                  <div
                    class="wis__item"
                    data-wis-item
                    data-index="{{ i }}"
                    data-block-id="{{ block.id }}"
                    data-slot="{{ slot }}"
                    style="--o: {{ off }};"
                    {% if slot == 'x' or slot == 2 %}aria-hidden="true"{% endif %}
                    {% if slot == 'x' %}inert{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <div class="wis__media">
                      {%- if b.image != blank -%}
                        {%- liquid
                          assign fp_style = ''
                          if b.image.presentation.focal_point != blank
                            assign fp_style = 'object-position: ' | append: b.image.presentation.focal_point
                          endif
                        -%}
                        {{-
                          b.image
                          | image_url: width: 960
                          | image_tag:
                            widths: image_widths,
                            sizes: image_sizes,
                            loading: img_loading,
                            alt: img_alt,
                            style: fp_style,
                            draggable: 'false'
                        -}}
                      {%- else -%}
                        {{- 'image' | placeholder_svg_tag: 'wis__placeholder' -}}
                      {%- endif -%}
                    </div>
                    {%- if block_count > 1 -%}
                      <button
                        type="button"
                        class="wis__hit"
                        data-wis-hit
                        aria-label="Show {{ name | escape }}"
                        {% if slot != 1 %}tabindex="-1"{% endif %}
                        {% if slot == 0 %}hidden{% endif %}
                      ></button>
                    {%- endif -%}
                  </div>
                  {%- assign i = i | plus: 1 -%}
                {%- endfor -%}
              </div>

              <svg
                class="wis__ring{% if timer_on == false %} is-full{% endif %}{% unless s.show_progress_ring %} wis__ring--invisible{% endunless %}"
                data-wis-ring
                viewBox="0 0 410 410"
                aria-hidden="true"
                focusable="false"
              >
                {%- if ring_track != 'none' -%}<circle class="wis__ring-track" cx="205" cy="205" r="201.925"/>{%- endif -%}
                <circle class="wis__ring-bar" data-wis-bar cx="205" cy="205" r="201.925" pathLength="100"/>
              </svg>
            </div>

            <div class="wis__body{% if block_count < 2 %} wis__body--single{% endif %}">
              {%- assign seen = 0 -%}
              {%- assign i = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'tab' -%}
                  {%- assign seen = seen | plus: 1 -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign grp = seen | at_least: 1 -%}
                {%- if grp != g -%}{%- continue -%}{%- endif -%}
                {%- assign b = block.settings -%}
                <div
                  class="wis__slide{% if i == 0 %} is-active{% endif %}"
                  data-wis-slide
                  data-block-id="{{ block.id }}"
                  {% unless i == 0 %}aria-hidden="true" inert{% endunless %}
                >
                  {%- if b.name != blank -%}
                    <h3 class="wis__title">{{ b.name | escape }}</h3>
                  {%- endif -%}
                  {%- if b.description != blank -%}
                    <p class="wis__desc">{{ b.description | escape | newline_to_br }}</p>
                  {%- endif -%}
                </div>
                {%- assign i = i | plus: 1 -%}
              {%- endfor -%}

              {%- if block_count > 1 -%}
                <button type="button" class="wis__arrow wis__arrow--prev" data-wis-prev aria-label="Previous ingredient">
                  {{- 'cio-arrow-left.svg' | inline_asset_content -}}
                </button>
                <button type="button" class="wis__arrow wis__arrow--next" data-wis-next aria-label="Next ingredient">
                  {{- 'cio-arrow-right.svg' | inline_asset_content -}}
                </button>
              {%- endif -%}
            </div>

            <div class="wis__sr" data-wis-live aria-live="polite" aria-atomic="true"></div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- endif -%}
</div>

<script>
  (function () {
    if (!window.WhatsInsideTabs) {
      var reduceMotion = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : { matches: false };
      var MIN_NODES = 10;
      var MOVE_MS = 760;
      var SWIPE_PX = 40;

      var mod = function (a, n) { return ((a % n) + n) % n; };

      var WIS = function (root) {
        this.root = root;
        this.ac = typeof AbortController !== 'undefined' ? new AbortController() : null;
        this.cleanups = [];
        this.carousel = root.querySelector('[data-wis-carousel]');
        this.stage = root.querySelector('[data-wis-stage]');
        this.track = root.querySelector('[data-wis-track]');
        this.ring = root.querySelector('[data-wis-ring]');
        this.bar = root.querySelector('[data-wis-bar]');
        this.live = root.querySelector('[data-wis-live]');
        this.toggleBtn = root.querySelector('[data-wis-toggle]');
        this.items = Array.prototype.slice.call(root.querySelectorAll('[data-wis-item]:not([data-wis-clone])'));
        this.slides = Array.prototype.slice.call(root.querySelectorAll('[data-wis-slide]'));
        this.count = this.items.length;
        this.reach = parseInt(root.getAttribute('data-reach'), 10) || 1;
        this.delay = Math.min(10, Math.max(3, parseFloat(root.getAttribute('data-speed')) || 5)) * 1000;
        this.reduce = reduceMotion.matches;
        this.timerOn = root.getAttribute('data-autoplay') === 'true' && this.count > 1 && !this.reduce;
        this.index = 0;
        this.v = 0;
        this.nodes = [];
        this.pos = [];
        this.pauses = {};
        this.anim = null;
        this.settleTimer = null;
        this.leaveTimers = [];
        this.init();
      };

      WIS.prototype.on = function (el, type, fn, opts) {
        var o = opts || {};
        if (this.ac) {
          o.signal = this.ac.signal;
          el.addEventListener(type, fn, o);
        } else {
          el.addEventListener(type, fn, o);
          this.cleanups.push(function () { el.removeEventListener(type, fn, o); });
        }
      };

      WIS.prototype.init = function () {
        var self = this;
        var copies = Math.ceil(MIN_NODES / this.count);
        this.nodes = this.items.slice();
        for (var c = 1; c < copies; c++) {
          for (var k = 0; k < this.count; k++) {
            var clone = this.items[k].cloneNode(true);
            clone.removeAttribute('data-shopify-editor-block');
            clone.setAttribute('data-wis-clone', '');
            var img = clone.querySelector('img');
            if (img) img.setAttribute('loading', 'lazy');
            this.track.appendChild(clone);
            this.nodes.push(clone);
          }
        }
        this.N = this.nodes.length;
        this.layout(0, false);

        var prev = this.root.querySelector('[data-wis-prev]');
        var next = this.root.querySelector('[data-wis-next]');
        if (prev) this.on(prev, 'click', function () { self.goBy(-1, { user: true }); });
        if (next) this.on(next, 'click', function () { self.goBy(1, { user: true }); });

        this.on(this.track, 'click', function (e) {
          if (self.swallowClick) { self.swallowClick = false; e.preventDefault(); return; }
          var hit = e.target.closest ? e.target.closest('[data-wis-item]') : null;
          if (!hit) return;
          var n = self.nodes.indexOf(hit);
          if (n < 0 || !self.pos[n]) return;
          var wasFocus = document.activeElement && hit.contains(document.activeElement);
          self.goBy(self.pos[n], { user: true });
          if (wasFocus && self.carousel) {
            var nextBtn = self.root.querySelector('[data-wis-next]');
            if (nextBtn) nextBtn.focus({ preventScroll: true });
          }
        });

        var sx = 0, sy = 0, pid = null;
        this.on(this.stage, 'pointerdown', function (e) {
          if (e.pointerType === 'mouse' || pid !== null) return;
          pid = e.pointerId; sx = e.clientX; sy = e.clientY;
          self.pause('touch');
        });
        var end = function (e) {
          if (e.pointerId !== pid) return;
          pid = null;
          self.resume('touch');
          if (e.type !== 'pointerup') return;
          var dx = e.clientX - sx;
          var dy = e.clientY - sy;
          if (Math.abs(dx) > SWIPE_PX && Math.abs(dx) > Math.abs(dy) * 1.2) {
            self.swallowClick = true;
            setTimeout(function () { self.swallowClick = false; }, 400);
            self.goBy(dx < 0 ? 1 : -1, { user: true });
          }
        };
        this.on(this.stage, 'pointerup', end);
        this.on(this.stage, 'pointercancel', end);
        this.on(this.stage, 'dragstart', function (e) { e.preventDefault(); });

        if (this.carousel) {
          this.on(this.carousel, 'keydown', function (e) {
            if (e.altKey || e.ctrlKey || e.metaKey) return;
            if (e.key === 'ArrowLeft' || e.key === 'Left') { e.preventDefault(); self.goBy(-1, { user: true }); }
            else if (e.key === 'ArrowRight' || e.key === 'Right') { e.preventDefault(); self.goBy(1, { user: true }); }
          });
        }

        if (this.timerOn) {
          var hoverZone = this.carousel || this.root;
          this.on(hoverZone, 'pointerenter', function (e) { if (e.pointerType === 'mouse') self.pause('hover'); });
          this.on(hoverZone, 'pointerleave', function (e) { if (e.pointerType === 'mouse') self.resume('hover'); });
          this.on(this.root, 'focusin', function (e) {
            var kb = true;
            try { kb = e.target.matches(':focus-visible'); } catch (err) {}
            if (kb) self.pause('focus');
          });
          this.on(this.root, 'focusout', function (e) {
            if (!e.relatedTarget || !self.root.contains(e.relatedTarget)) self.resume('focus');
          });
          // Also fires "not intersecting" while the panel's tab is hidden, so hidden tabs never advance.
          if ('IntersectionObserver' in window) {
            this.io = new IntersectionObserver(function (entries) {
              entries.forEach(function (en) { en.isIntersecting ? self.resume('offscreen') : self.pause('offscreen'); });
            });
            this.io.observe(this.root);
          }
          this.on(document, 'visibilitychange', function () {
            document.hidden ? self.pause('hidden') : self.resume('hidden');
          });
          if (document.hidden) this.pauses.hidden = true;
          if (this.toggleBtn) {
            this.on(this.toggleBtn, 'click', function () {
              var off = !self.pauses.user;
              off ? self.pause('user') : self.resume('user');
              self.toggleBtn.setAttribute('aria-pressed', off ? 'true' : 'false');
              self.toggleBtn.textContent = off ? 'Play ingredient rotation' : 'Pause ingredient rotation';
            });
          }
          this.startRing();
        } else {
          this.showStaticRing();
          if (this.toggleBtn) this.toggleBtn.hidden = true;
        }
      };

      WIS.prototype.posOf = function (k) {
        var p = mod(k - this.v, this.N);
        return p >= this.N / 2 ? p - this.N : p;
      };

      WIS.prototype.applyNode = function (node, p) {
        var reach = this.reach;
        var a = Math.abs(p);
        var park = reach + 1;
        var slot = a <= reach ? String(a) : 'x';
        node.style.setProperty('--o', Math.max(-park, Math.min(park, p)));
        node.setAttribute('data-slot', slot);
        if (slot === 'x') node.setAttribute('inert', '');
        else node.removeAttribute('inert');
        if (slot === 'x' || slot === '2') node.setAttribute('aria-hidden', 'true');
        else node.removeAttribute('aria-hidden');
        var hit = node.querySelector('[data-wis-hit]');
        if (hit) {
          hit.hidden = slot === '0';
          if (slot === '1') hit.removeAttribute('tabindex');
          else hit.setAttribute('tabindex', '-1');
        }
      };

      WIS.prototype.layout = function (delta, animate) {
        var self = this;
        var next = [];
        var jumps = [];
        for (var k = 0; k < this.N; k++) {
          var p = this.posOf(k);
          next.push(p);
          if (!animate || this.pos[k] === undefined || p !== this.pos[k] - delta) jumps.push(k);
        }
        if (!animate) this.root.classList.add('wis--instant');
        jumps.forEach(function (k) {
          self.nodes[k].classList.add('is-jump');
          self.applyNode(self.nodes[k], next[k]);
        });
        if (jumps.length) void this.track.offsetWidth;
        jumps.forEach(function (k) { self.nodes[k].classList.remove('is-jump'); });
        if (!animate) this.root.classList.remove('wis--instant');
        if (animate) {
          for (var j = 0; j < this.N; j++) {
            if (jumps.indexOf(j) === -1) this.applyNode(this.nodes[j], next[j]);
          }
        }
        this.pos = next;
      };

      WIS.prototype.setSlide = function (n, animate) {
        var self = this;
        this.leaveTimers.forEach(clearTimeout);
        this.leaveTimers = [];
        if (!animate) this.root.classList.add('wis--instant');
        this.slides.forEach(function (s, k) {
          if (k === n) {
            s.classList.remove('is-leaving');
            s.classList.add('is-active');
            s.removeAttribute('aria-hidden');
            s.removeAttribute('inert');
          } else {
            if (s.classList.contains('is-active') && animate) s.classList.add('is-leaving');
            s.classList.remove('is-active');
            s.setAttribute('aria-hidden', 'true');
            s.setAttribute('inert', '');
          }
        });
        if (!animate) {
          this.slides.forEach(function (s) { s.classList.remove('is-leaving'); });
          void this.root.offsetWidth;
          this.root.classList.remove('wis--instant');
        } else {
          this.leaveTimers.push(setTimeout(function () {
            self.slides.forEach(function (s) { if (!s.classList.contains('is-active')) s.classList.remove('is-leaving'); });
          }, 700));
        }
      };

      WIS.prototype.goTo = function (n, opts) {
        var d = mod(mod(n, this.count) - this.index, this.count);
        if (d > this.count / 2) d -= this.count;
        return this.goBy(d, opts);
      };

      WIS.prototype.goBy = function (delta, opts) {
        var o = opts || {};
        if (this.count < 2 || !delta) {
          if (o.user) this.restartTimer();
          return;
        }
        var self = this;
        var animate = !o.instant && Math.abs(delta) <= 2;
        this.v += delta;
        this.index = mod(this.index + delta, this.count);
        this.layout(delta, animate);
        this.setSlide(this.index, animate && !this.reduce);
        if (o.user) this.announce();

        this.freezeRing();
        clearTimeout(this.settleTimer);
        var wait = animate && !this.reduce ? MOVE_MS : 0;
        this.ring.classList.add('is-hidden');
        this.settleTimer = setTimeout(function () {
          self.settleTimer = null;
          if (self.timerOn) self.startRing();
          else self.showStaticRing();
        }, wait);
      };

      WIS.prototype.announce = function () {
        if (!this.live) return;
        var slide = this.slides[this.index];
        var title = slide && slide.querySelector('.wis__title');
        var name = title ? title.textContent.trim() : 'Ingredient';
        var live = this.live;
        var msg = name + ', ingredient ' + (this.index + 1) + ' of ' + this.count;
        live.textContent = '';
        clearTimeout(this.liveTimer);
        this.liveTimer = setTimeout(function () { live.textContent = msg; }, 60);
      };

      WIS.prototype.stopRing = function () {
        [this.anim, this.frozen].forEach(function (a) {
          if (a) { a.onfinish = null; a.cancel(); }
        });
        this.anim = null;
        this.frozen = null;
      };

      WIS.prototype.freezeRing = function () {
        if (!this.anim) return;
        this.anim.onfinish = null;
        if (this.anim.playState === 'running') this.anim.pause();
        if (this.frozen && this.frozen !== this.anim) this.frozen.cancel();
        this.frozen = this.anim;
        this.anim = null;
      };

      WIS.prototype.showStaticRing = function () {
        this.stopRing();
        this.ring.classList.add('is-full');
        this.ring.classList.remove('is-hidden');
      };

      WIS.prototype.startRing = function () {
        var self = this;
        this.stopRing();
        this.ring.classList.remove('is-full');
        this.ring.classList.remove('is-hidden');
        if (!this.bar.animate) {
          this.ring.classList.add('is-full');
          return;
        }
        this.anim = this.bar.animate(
          [{ strokeDashoffset: 100 }, { strokeDashoffset: 0 }],
          { duration: this.delay, easing: 'linear', fill: 'forwards' }
        );
        this.anim.onfinish = function () {
          self.anim = null;
          self.goBy(1, { auto: true });
        };
        if (this.isPaused()) this.anim.pause();
      };

      WIS.prototype.restartTimer = function () {
        if (!this.timerOn || this.settleTimer) return;
        this.startRing();
      };

      WIS.prototype.isPaused = function () {
        for (var k in this.pauses) if (this.pauses[k]) return true;
        return false;
      };

      WIS.prototype.pause = function (reason) {
        this.pauses[reason] = true;
        if (this.anim && this.anim.playState === 'running') this.anim.pause();
      };

      WIS.prototype.resume = function (reason) {
        delete this.pauses[reason];
        if (this.anim && !this.isPaused() && this.anim.playState === 'paused') this.anim.play();
      };

      WIS.prototype.selectBlock = function (blockId) {
        var idx = -1;
        this.items.forEach(function (it, k) { if (it.getAttribute('data-block-id') === blockId) idx = k; });
        if (idx < 0) return; // block lives in another tab
        this.pause('editor');
        if (idx !== this.index) {
          var d = mod(idx - this.index, this.count);
          if (d > this.count / 2) d -= this.count;
          this.goBy(d, { instant: Math.abs(d) > 2 });
        }
      };

      WIS.prototype.jump = function (i) {
        this.goTo(i, { instant: true });
      };

      WIS.prototype.destroy = function () {
        this.stopRing();
        clearTimeout(this.settleTimer);
        clearTimeout(this.liveTimer);
        this.leaveTimers.forEach(clearTimeout);
        if (this.ac) this.ac.abort();
        this.cleanups.forEach(function (fn) { fn(); });
        this.cleanups = [];
        if (this.io) this.io.disconnect();
        this.nodes.forEach(function (n) { if (n.hasAttribute('data-wis-clone') && n.parentNode) n.parentNode.removeChild(n); });
      };

      var api = {
        instances: {}, // key: "<sectionId>--<tab number>"
        last: {},
        each: function (sectionId, fn) {
          var self = this;
          Object.keys(this.instances).forEach(function (k) {
            if (k.indexOf(sectionId + '--') === 0) fn(self.instances[k], k);
          });
        },
        drop: function (key) {
          var c = this.instances[key];
          if (!c) return;
          this.last[key] = c.index;
          c.destroy();
          delete this.instances[key];
        },
        mount: function (sectionId) {
          var self = this;
          this.each(sectionId, function (inst, k) {
            if (!document.documentElement.contains(inst.root)) self.drop(k);
          });
          var roots = document.querySelectorAll('[data-wis][data-section-id="' + sectionId + '"]');
          Array.prototype.forEach.call(roots, function (root) {
            var key = root.getAttribute('data-wis-key');
            var cur = self.instances[key];
            if (cur && cur.root === root) return;
            if (cur) self.drop(key);
            if (!root.querySelector('[data-wis-track]') || root.querySelectorAll('[data-wis-item]:not([data-wis-clone])').length < 2) return;
            var inst = new WIS(root);
            self.instances[key] = inst;
            if (self.last[key] != null && window.Shopify && window.Shopify.designMode) {
              inst.jump(Math.min(self.last[key], inst.count - 1));
            }
          });
          this.bindTabs(sectionId);
        },
        unmount: function (sectionId) {
          var self = this;
          this.each(sectionId, function (inst, k) { self.drop(k); });
        },
        wrap: function (sectionId) {
          return document.querySelector('[data-wist="' + sectionId + '"]');
        },
        activateTab: function (sectionId, n, focus) {
          var wrap = this.wrap(sectionId);
          if (!wrap) return;
          var tabs = wrap.querySelectorAll('[data-wist-tab]');
          var panels = wrap.querySelectorAll('[data-wist-panel]');
          if (!panels[n]) return;
          Array.prototype.forEach.call(panels, function (p, k) { p.hidden = k !== n; });
          Array.prototype.forEach.call(tabs, function (t, k) {
            var on = k === n;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
            if (on) t.removeAttribute('tabindex');
            else t.setAttribute('tabindex', '-1');
          });
          if (focus && tabs[n]) tabs[n].focus();
          var inst = this.instances[panels[n].getAttribute('data-wis-key')];
          if (inst) inst.restartTimer(); // newly shown tab starts its ring from 0
        },
        bindTabs: function (sectionId) {
          var self = this;
          var wrap = this.wrap(sectionId);
          if (!wrap || wrap.hasAttribute('data-wist-bound')) return;
          wrap.setAttribute('data-wist-bound', '');
          var tabs = Array.prototype.slice.call(wrap.querySelectorAll('[data-wist-tab]'));
          tabs.forEach(function (t, k) {
            t.addEventListener('click', function () { self.activateTab(sectionId, k); });
            t.addEventListener('keydown', function (e) {
              var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
              if (!d) return;
              e.preventDefault();
              self.activateTab(sectionId, mod(k + d, tabs.length), true);
            });
          });
        },
        // Theme editor: selecting a Tab or Ingredient block opens its tab.
        showBlock: function (sectionId, blockId) {
          var wrap = this.wrap(sectionId);
          if (!wrap) return;
          var el = wrap.querySelector('[data-block-id="' + blockId + '"]');
          if (!el) return;
          var panels = Array.prototype.slice.call(wrap.querySelectorAll('[data-wist-panel]'));
          var tabs = Array.prototype.slice.call(wrap.querySelectorAll('[data-wist-tab]'));
          var panel = el.closest('[data-wist-panel]');
          var n = panel ? panels.indexOf(panel) : tabs.indexOf(el);
          if (n > -1) this.activateTab(sectionId, n);
        }
      };
      window.WhatsInsideTabs = api;

      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId) api.mount(e.detail.sectionId);
      });
      document.addEventListener('shopify:section:unload', function (e) {
        if (e.detail && e.detail.sectionId) api.unmount(e.detail.sectionId);
      });
      document.addEventListener('shopify:block:select', function (e) {
        if (!e.detail) return;
        api.showBlock(e.detail.sectionId, e.detail.blockId);
        api.each(e.detail.sectionId, function (inst) { inst.selectBlock(e.detail.blockId); });
      });
      document.addEventListener('shopify:block:deselect', function (e) {
        if (!e.detail) return;
        api.each(e.detail.sectionId, function (inst) { inst.resume('editor'); });
      });
    }

    var sectionId = {{ section.id | json }};
    var boot = function () { window.WhatsInsideTabs.mount(sectionId); };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "What's Inside Tabs",
  "tag": "section",
  "class": "index-section wis-section",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "custom_class", "label": "Custom class" },
    { "type": "header", "content": "Heading" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Use italic for the serif accent words.",
      "default": "<p>What's inside, <em>and exactly why.</em></p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 30,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading size (desktop)",
      "info": "Size at 1920px wide; scales down on smaller screens.",
      "default": 58
