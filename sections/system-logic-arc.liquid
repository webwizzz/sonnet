{%- comment -%}
  System Logic Arc: sticky, scroll-driven card carousel on a large circular arc.
  Design: design-specs/clean-it-off/sections/14-system-logic.md (Figma node 203:6168), 1920 × 960 band.

  How it works
  - The section is a tall scroll track: sticky viewport + (cards - 1 + 0.4) x scroll_per_card vh (0.2 card of dwell
    at each end, so the smoothed motion lands before the band pins / unpins). A position: sticky
    viewport inside it holds the band while the page scrolls past it.
  - Scroll progress p = 0 .. cards-1. Card i sits at angle θ = (i - p) x angle_step on a circle of radius R
    whose top point is the centre slot: x = R·sin θ, y = R·(1 - cos θ), rotated by θ. At p = 0 card 1 is upright
    in the centre and the next cards wait lower right; scrolling moves every card left along the arc, and the
    section unpins when the last card reaches the centre. Cards fade out as they leave the screen.
  - Layout comes from the 1920 × 960 Figma frame, scaled by u = min(100vw / 1920, viewport height / 960)
    (0.5 to 1). R scales with the card size, so phones keep the same arc with smaller cards.
  - Reduced motion, short landscape phones and single-card sections show a static, swipeable row instead.
  - Benefit cards can open a video in a <dialog> lightbox; cards can link to a product or URL.
  All CSS is scoped to .sla / #shopify-section-{{ section.id }}; JS is vanilla and per instance
  (scroll engine shared with sections/why-love.liquid).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign block_count = section.blocks.size
  assign text_color = s.text_color | default: '#28201F'
  assign subtitle_color = text_color | color_modify: 'alpha', 0.8
  assign guide_alpha = s.guide_opacity | default: 15 | times: 0.01
  assign guide_color = s.guide_color | default: '#28201F' | color_modify: 'alpha', guide_alpha
  assign overlay_alpha = s.overlay_opacity | times: 0.01
  assign benefit_overlay = s.benefit_overlay | default: '#28201F'
  assign product_overlay = s.product_overlay | default: '#FFFFFF'
  assign benefit_overlay_0 = benefit_overlay | color_modify: 'alpha', 0
  assign product_overlay_0 = product_overlay | color_modify: 'alpha', 0
  assign subtitle_font = s.subtitle_font
  assign label_font = s.label_font
  assign pill_font = s.pill_font
  comment
    Plain heading text for aria-label. strip_html keeps richtext entities, so decode them once (&amp; last)
    and escape exactly once where printed.
  endcomment
  assign heading_text = s.heading | strip_html | strip | replace: '&#39;', "'" | replace: '&#039;', "'" | replace: '&quot;', '"' | replace: '&nbsp;', ' ' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'

  assign is_arc = false
  if block_count > 1
    assign is_arc = true
  endif
  assign steps = block_count | minus: 1
  if steps < 0
    assign steps = 0
  endif

  assign offset_css = 'var(--menu-height-sticky, 0px)'
  if s.sticky_offset_mode == 'custom'
    assign offset_css = s.sticky_offset | default: 0 | append: 'px'
  endif
-%}

{% style %}
{%- if subtitle_font != blank -%}{{ subtitle_font | font_face: font_display: 'swap' }}{%- endif -%}
{%- if label_font != blank -%}{{ label_font | font_face: font_display: 'swap' }}{%- endif -%}
{%- if pill_font != blank -%}{{ pill_font | font_face: font_display: 'swap' }}{%- endif -%}
#shopify-section-{{ section.id }} {
  --sla-band: {{ s.color_band | default: '#F6F3EE' }};
  --sla-text: {{ text_color }};
  --sla-text-80: {{ subtitle_color }};
  --sla-label: {{ s.label_color | default: '#FFFFFF' }};
  --sla-pill: {{ s.pill_color | default: '#28201F' }};
  --sla-play: {{ s.play_bg | default: '#FFFFFF' }};
  --sla-play-icon: {{ s.play_icon | default: '#78563D' }};
  --sla-ov-benefit: {{ benefit_overlay }};
  --sla-ov-benefit-0: {{ benefit_overlay_0 }};
  --sla-ov-product: {{ product_overlay }};
  --sla-ov-product-0: {{ product_overlay_0 }};
  --sla-ov-op: {{ overlay_alpha }};
  --sla-guide: {{ guide_color }};
  --sla-top: {{ offset_css }};
  --sla-steps: {{ steps }};
  --sla-len: {{ s.scroll_per_card | default: 70 }};
  --sla-R: {{ s.arc_radius | default: 2440 }};
  --sla-h-num: {{ s.heading_size | default: 58 }};
  --sla-hm: {{ s.heading_size_mobile | default: 28 }}px;
  --sla-sub-font: {% if subtitle_font != blank %}{{ subtitle_font.family }}, {{ subtitle_font.fallback_families }}{% else %}'Montserrat', sans-serif{% endif %};
  --sla-sub-weight: {% if subtitle_font != blank %}{{ subtitle_font.weight }}{% else %}400{% endif %};
  --sla-label-font: {% if label_font != blank %}{{ label_font.family }}, {{ label_font.fallback_families }}{% else %}'Montserrat', sans-serif{% endif %};
  --sla-label-weight: {% if label_font != blank %}{{ label_font.weight }}{% else %}600{% endif %};
  --sla-pill-font: {% if pill_font != blank %}{{ pill_font.family }}, {{ pill_font.fallback_families }}{% else %}'Montserrat', sans-serif{% endif %};
  --sla-pill-weight: {% if pill_font != blank %}{{ pill_font.weight }}{% else %}500{% endif %};
}
#shopify-section-{{ section.id }} .sla {
  padding-top: {{ s.padding_top }}px;
  padding-bottom: {{ s.padding_bottom }}px;
}
{%- unless s.show_decor_mobile %}
@media only screen and (max-width: 768px) {
  #shopify-section-{{ section.id }} .sla__decor { display: none; }
}
{%- endunless %}
{% endstyle %}

{% style %}
/* ---------- System Logic Arc (.sla) : shared rules for every instance ---------- */
.sla {
  /* Sticky viewport height: the screen minus the sticky header (or the custom offset) */
  --sla-vh: calc(100vh - var(--sla-top));
  /* 1 design px of the 1920 x 960 frame; scales with the viewport width AND height (0.5px .. 1.5px) */
  --sla-u: clamp(0.5px, min(calc(100vw / 1920), calc(var(--sla-vh) / 960)), 1.5px);
  /* Card size; 1 card px (--sla-cu) scales the card's own type, the play button and the arc radius */
  --sla-cw: calc(345 * var(--sla-u));
  --sla-cu: calc(var(--sla-cw) / 345);
  --sla-ch: calc(var(--sla-cw) * 420 / 345);
  /* Card 1 centre: frame y 484 = 4 px below the frame's vertical centre */
  --sla-ay: calc(4 * var(--sla-u));
  /* Arc radius factor: phones use a slightly tighter curve so the neighbouring cards peek in */
  --sla-rk: 1;
  /* Dwell at each end of the track (fraction of one card's scroll): the smoothed motion finishes there,
     so the band pins / unpins only once card 1 / the last card sits exactly in the centre slot. */
  --sla-hk: 0.2;
  color: var(--sla-text);
}
@supports (height: 100svh) {
  .sla { --sla-vh: calc(100svh - var(--sla-top)); }
}
.sla *,
.sla *::before,
.sla *::after { box-sizing: border-box; }

/* ---------- Scroll track + sticky viewport ---------- */
.sla__track { position: relative; }
.sla__sticky {
  position: relative;
  background-color: var(--sla-band);
  isolation: isolate;
}
.sla--arc:not(.sla--list) .sla__track {
  height: calc(var(--sla-vh) + (var(--sla-steps) + 2 * var(--sla-hk)) * var(--sla-len) * 1vh);
  /* Paints the strip under the sticky band when the mobile address bar collapses (viewport > 100svh) */
  background-color: var(--sla-band);
}
.sla--arc:not(.sla--list) .sla__sticky {
  position: -webkit-sticky;
  position: sticky;
  top: var(--sla-top);
  height: var(--sla-vh);
  overflow: hidden;
  overflow: clip; /* not a scroll container, so focusing an off-screen card cannot scroll it sideways */
}
/* Header set to "sticky only when scrolling up" (auto offset): pin at the top and move down with the header
   while it is shown (same timing as theme.css). Only `top` changes; the progress maths stay the same. */
.sla--hdr-dir .sla__sticky { transition: top 0.2s linear; }
.sla--hdr-dir.sla--hdr-in .sla__sticky {
  top: calc(var(--sla-top) + var(--menu-height, 0px));
  transition: top 0.2s cubic-bezier(0.215, 0.61, 0.355, 1);
}

/* ---------- Decorative model photo (behind the cards, bleeds off the left edge) ---------- */
.sla__decor {
  position: absolute;
  z-index: 0;
  left: calc(-161 * var(--sla-u));
  bottom: 0;
  width: calc(821 * var(--sla-u));
  height: calc(856 * var(--sla-u));
  pointer-events: none;
  user-select: none;
}
.sla .sla__decor img {
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: contain;
  object-position: left bottom;
}

/* ---------- Heading + subtitle (frame y 100 and 190, centred) ---------- */
.sla__head {
  position: absolute;
  z-index: 3;
  left: 0;
  right: 0;
  top: calc(50% - 380 * var(--sla-u));
  padding: 0 16px;
  text-align: center;
  pointer-events: none;
}
.sla__head a { pointer-events: auto; }
.sla .sla__heading {
  margin: 0;
  font-family: 'Blauer Nue MD', sans-serif;
  font-weight: 500;
  font-style: normal;
  font-size: max(var(--sla-hm), calc(var(--sla-h-num) * var(--sla-u)));
  line-height: 1.2;
  letter-spacing: -0.02em;
  text-transform: none;
  color: var(--sla-text);
}
.sla .sla__heading p { margin: 0; font: inherit; letter-spacing: inherit; color: inherit; }
.sla .sla__heading em {
  font-family: 'Test Tiempos Fine Italic RG', serif;
  font-style: italic;
  font-weight: 400;
  line-height: 1.212;
}
.sla .sla__sub {
  margin: max(10px, calc(20 * var(--sla-u))) auto 0;
  max-width: max(900px, calc(900 * var(--sla-u)));
  font-family: var(--sla-sub-font);
  font-weight: var(--sla-sub-weight);
  font-style: normal;
  font-size: max(13px, calc(16 * var(--sla-u)));
  line-height: 1.4;
  letter-spacing: -0.02em;
  color: var(--sla-text-80);
}

/* ---------- Arc area + cards ---------- */
.sla__arc {
  position: absolute;
  z-index: 1;
  inset: 0;
}
.sla__cards {
  position: absolute;
  inset: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}
.sla .sla__card {
  position: absolute;
  left: 50%;
  top: calc(50% + var(--sla-ay));
  width: var(--sla-cw);
  height: var(--sla-ch);
  margin: calc(var(--sla-ch) / -2) 0 0 calc(var(--sla-cw) / -2);
  padding: 0;
  list-style: none;
  transform-origin: 50% 50%;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}
.sla .sla__card::before { content: none; } /* theme list bullets */
/* Before the script positions them, only card 1 shows (in the centre slot). */
.sla--arc:not(.sla--ready):not(.sla--list) .sla__card + .sla__card { opacity: 0; }
.sla--moving .sla__card { will-change: transform, opacity; }
.sla__card.is-far { pointer-events: none; }
.sla__card:focus { outline: none; }
.sla__card:focus-visible .sla__inner { outline: 2px solid var(--sla-text); outline-offset: 3px; }

.sla__inner {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: max(10px, calc(16 * var(--sla-cu)));
  overflow: hidden;
  isolation: isolate;
  background-color: #E8E1D7;
}
.sla .sla__inner img,
.sla .sla__inner .sla__ph {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  -webkit-user-drag: none;
  user-select: none;
}
.sla .sla__inner .sla__ph { fill: rgba(40, 32, 31, 0.18); }
/* Bottom gradient: transparent at 82.86 % of the height -> solid at 100 %, layer opacity 30 % */
.sla__ov {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, var(--sla-ov-benefit-0) 82.857%, var(--sla-ov-benefit) 100%);
  opacity: var(--sla-ov-op);
  pointer-events: none;
}
.sla__card--product .sla__ov {
  background: linear-gradient(180deg, var(--sla-ov-product-0) 82.857%, var(--sla-ov-product) 100%);
}

/* Whole-card link (empty overlay; its name comes from the label) */
.sla .sla__hit {
  position: absolute;
  inset: 0;
  z-index: 2;
  border-radius: inherit;
  -webkit-tap-highlight-color: transparent;
}
.sla .sla__hit:focus { outline: none; }
.sla .sla__hit:focus-visible { outline: 2px solid var(--sla-text); outline-offset: -5px; }
.sla__card--benefit .sla__hit:focus-visible { outline-color: var(--sla-label); }

/* Product label: outlined pill, 18px from the bottom, Montserrat 500 16 / 19.5 uppercase */
.sla .sla__pill {
  position: absolute;
  z-index: 3;
  left: 50%;
  bottom: calc(18 * var(--sla-cu));
  max-width: calc(100% - 24 * var(--sla-cu));
  margin: 0;
  padding: calc(5 * var(--sla-cu)) calc(10 * var(--sla-cu));
  border-radius: 30px;
  box-shadow: inset 0 0 0 1px var(--sla-pill); /* Figma: 1px inside stroke */
  transform: translateX(-50%);
  font-family: var(--sla-pill-font);
  font-weight: var(--sla-pill-weight);
  font-style: normal;
  font-size: max(12px, calc(16 * var(--sla-cu)));
  line-height: 1.219;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--sla-pill);
  pointer-events: none;
}
/* Benefit label: centred, 22px from the bottom, Montserrat 600 20 / 24.38 */
.sla .sla__label {
  position: absolute;
  z-index: 3;
  left: 0;
  right: 0;
  bottom: calc(22 * var(--sla-cu));
  margin: 0;
  padding: 0 calc(16 * var(--sla-cu));
  font-family: var(--sla-label-font);
  font-weight: var(--sla-label-weight);
  font-style: normal;
  font-size: max(14px, calc(20 * var(--sla-cu)));
  line-height: 1.219;
  letter-spacing: -0.02em;
  text-transform: none;
  text-align: center;
  color: var(--sla-label);
  pointer-events: none;
}

/* Play: 30px white circle at the card centre, #78563D triangle 9.6 x 9.6 at (10.2, 10.2) */
.sla .sla__play {
  -webkit-appearance: none;
  appearance: none;
  position: absolute;
  z-index: 4;
  left: 50%;
  top: 50%;
  width: max(26px, calc(30 * var(--sla-cu)));
  height: max(26px, calc(30 * var(--sla-cu)));
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--sla-play);
  box-shadow: none;
  transform: translate(-50%, -50%);
  cursor: pointer;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  -webkit-tap-highlight-color: transparent;
}
.sla .sla__play::before {
  content: '';
  position: absolute;
  left: 34%;
  top: 34%;
  width: 32%;
  height: 32%;
  margin: 0;
  border: 0;
  background: var(--sla-play-icon);
  -webkit-clip-path: polygon(0 0, 100% 50%, 0 100%);
  clip-path: polygon(0 0, 100% 50%, 0 100%);
}
/* Hit area grows to 44px without changing the visual size */
.sla .sla__play::after {
  content: '';
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  border: 1.5px solid var(--sla-play);
  opacity: 0;
  transform: scale(0.65);
  animation: sla-pulse 2.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
}
@keyframes sla-pulse {
  0% { transform: scale(0.65); opacity: 0.8; }
  70%, 100% { transform: scale(1.35); opacity: 0; }
}
.sla--moving .sla__play::after { animation-play-state: paused; }
@media (hover: hover) and (pointer: fine) {
  .sla .sla__play:hover { transform: translate(-50%, -50%) scale(1.12); }
}
.sla .sla__play:focus { outline: none; }
.sla .sla__play:focus-visible { outline: 2px solid var(--sla-play); outline-offset: 3px; }

/* ---------- Optional orbit guides (thin lines, like the motion reference) ---------- */
.sla__guides {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}
.sla__ring,
.sla__orbit {
  position: absolute;
  left: 50%;
  border: 1px solid var(--sla-guide);
  border-radius: 50%;
}
.sla__ring {
  top: calc(50% + var(--sla-ay));
  width: calc(var(--sla-cw) * 1.2);
  height: calc(var(--sla-ch) * 1.2); /* stays below the subtitle */
  transform: translate(-50%, -50%);
}
/* Circle through every card centre: radius R, top point in the centre slot */
.sla__orbit {
  top: calc(50% + var(--sla-ay));
  width: calc(2 * var(--sla-R) * var(--sla-rk) * var(--sla-cu));
  height: calc(2 * var(--sla-R) * var(--sla-rk) * var(--sla-cu));
  margin-left: calc(-1 * var(--sla-R) * var(--sla-rk) * var(--sla-cu));
}

/* ---------- Compact layout (phones, tablets held upright): heading on top, arc below ---------- */
@media only screen and (max-width: 768px), only screen and (max-width: 1100px) and (orientation: portrait) {
  .sla {
    --sla-cw: min(46vw, 345px, calc(var(--sla-vh) * 0.36));
    --sla-ay: 0px;
    --sla-rk: 0.8;
  }
  .sla--arc:not(.sla--list) .sla__sticky {
    display: flex;
    flex-direction: column;
  }
  .sla--arc:not(.sla--list) .sla__head {
    position: relative;
    top: auto;
    flex: none;
    padding: clamp(28px, 7svh, 64px) 16px 0;
  }
  .sla .sla__heading { font-size: max(var(--sla-hm), calc(var(--sla-h-num) * 0.75px)); }
  .sla .sla__sub { margin-top: 10px; font-size: 15px; }
  .sla--arc:not(.sla--list) .sla__arc {
    position: relative;
    inset: auto;
    flex: 1 1 auto;
    min-height: 0;
  }
}
@media only screen and (max-width: 768px) {
  .sla { --sla-cw: min(62vw, 300px, calc(var(--sla-vh) * 0.36)); }
  .sla .sla__heading { font-size: var(--sla-hm); }
  .sla .sla__sub { font-size: 14px; }
}

/* ---------- Static row: reduced motion, short landscape phones, a single card ---------- */
.sla--list {
  --sla-cw: min(345px, 72vw, calc(var(--sla-vh) * 0.62));
  --sla-ay: 0px;
}
.sla--list .sla__sticky {
  padding: clamp(48px, 5.2vw, 100px) 0 clamp(48px, 5.2vw, 100px);
}
.sla--list .sla__head {
  position: relative;
  top: auto;
  z-index: 1;
}
.sla--list .sla__heading { font-size: clamp(var(--sla-hm), calc(var(--sla-h-num) * 100vw / 1920), calc(var(--sla-h-num) * 1px)); }
.sla--list .sla__sub { font-size: clamp(14px, 0.84vw, 16px); }
.sla--list .sla__decor,
.sla--list .sla__guides { display: none; }
.sla--list .sla__arc { position: relative; inset: auto; }
.sla--list .sla__cards {
  position: relative;
  inset: auto;
  display: flex;
  gap: 20px;
  margin-top: clamp(24px, 2.6vw, 50px);
  padding: 8px 16px;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scroll-snap-type: x mandatory;
  scroll-padding: 0 16px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.sla--list .sla__cards::-webkit-scrollbar { display: none; }
.sla.sla--list .sla__card {
  position: relative;
  left: auto;
  top: auto;
  flex: 0 0 var(--sla-cw);
  margin: 0;
  transform: none !important;
  opacity: 1 !important;
  z-index: auto !important;
  scroll-snap-align: center;
}
/* Centred while the row fits, starts at the left edge once it scrolls */
.sla.sla--list .sla__card:first-child { margin-left: auto; }
.sla.sla--list .sla__card:last-child { margin-right: auto; }
.sla--list .sla__card.is-far { pointer-events: auto; }
.sla--list .sla__play::after { animation: none; }

/* ---------- Video lightbox ---------- */
.sla__dialog {
  width: -moz-fit-content;
  width: fit-content;
  max-width: none;
  height: -moz-fit-content;
  height: fit-content;
  max-height: none;
  margin: auto;
  padding: 0;
  border: 0;
  background: transparent;
  color: #fff;
  overflow: visible;
}
.sla__dialog::backdrop { background: rgba(20, 16, 15, 0.86); }
.sla__dialog[open] { animation: sla-dlg-in 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
@keyframes sla-dlg-in { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: none; } }
.sla__dlg-box { position: relative; }
.sla__dlg-media {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 200px;
  min-height: 120px;
  background: #000;
  border-radius: 12px;
  overflow: hidden;
}
.sla__dlg-media video {
  display: block;
  width: auto;
  height: auto;
  max-width: min(92vw, 1200px);
  max-height: calc(100svh - 120px);
}
.sla__dlg-media iframe {
  display: block;
  width: min(92vw, 1200px, calc((100svh - 120px) * 16 / 9));
  aspect-ratio: 16 / 9;
  height: auto;
  border: 0;
}
.sla .sla__close,
.sla__dialog .sla__close {
  -webkit-appearance: none;
  appearance: none;
  position: absolute;
  top: -48px;
  right: 0;
  width: 40px;
  height: 40px;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  cursor: pointer;
  transition: background-color 0.2s ease;
}
.sla__close::before,
.sla__close::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18px;
  height: 1.5px;
  margin: -0.75px 0 0 -9px;
  background: currentColor;
  transform: rotate(45deg);
}
.sla__close::after { transform: rotate(-45deg); }
@media (hover: hover) { .sla__dialog .sla__close:hover { background: rgba(255, 255, 255, 0.26); } }
.sla__dialog .sla__close:focus { outline: none; }
.sla__dialog .sla__close:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

.sla__empty {
  margin: 0;
  padding: 80px 16px;
  font-family: var(--sla-sub-font);
  font-size: 16px;
  text-align: center;
  color: var(--sla-text-80);
}

@media (prefers-reduced-motion: reduce) {
  .sla .sla__play,
  .sla__dialog[open] { transition: none; animation: none; }
  .sla .sla__play::after { animation: none; }
}
{% endstyle %}

{%- liquid
  assign sla_classes = 'sla'
  if is_arc
    assign sla_classes = sla_classes | append: ' sla--arc'
  else
    assign sla_classes = sla_classes | append: ' sla--list sla--single'
  endif
  if s.custom_class != blank
    assign sla_classes = sla_classes | append: ' ' | append: s.custom_class
  endif
  assign card_sizes = '(max-width: 768px) 62vw, (max-width: 1100px) and (orientation: portrait) 46vw, (min-width: 1921px) 18vw, 345px'
  assign card_widths = '240, 345, 480, 690, 1035'
-%}

{%- if block_count > 0 or request.design_mode -%}
<div
  class="{{ sla_classes | escape }}"
  data-sla
  data-section-id="{{ section.id }}"
  data-step="{{ s.angle_step | default: 10 }}"
  data-radius="{{ s.arc_radius | default: 2440 }}"
  data-offset-mode="{{ s.sticky_offset_mode | default: 'auto' | escape }}"
  {% if is_arc %}role="region" aria-roledescription="carousel" aria-label="{{ heading_text | default: 'Cards' | escape }}"{% endif %}
>
  <div class="sla__track" data-sla-track>
    <div class="sla__sticky" data-sla-sticky>
      {%- if s.decor_image != blank and block_count > 0 -%}
        <div class="sla__decor" aria-hidden="true">
          {{- s.decor_image | image_url: width: 1642 | image_tag: widths: '410, 616, 821, 1232, 1642', sizes: '(max-width: 768px) 60vw, 43vw', loading: 'lazy', alt: '', draggable: 'false' -}}
        </div>
      {%- endif -%}

      {%- if s.heading != blank or s.subtitle != blank -%}
        <div class="sla__head">
          {%- if s.heading != blank -%}
            <h2 class="sla__heading">{{ s.heading }}</h2>
          {%- endif -%}
          {%- if s.subtitle != blank -%}
            <p class="sla__sub">{{ s.subtitle | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="sla__arc">
        {%- if s.show_guides and is_arc -%}
          <div class="sla__guides" aria-hidden="true">
            <span class="sla__orbit"></span>
            <span class="sla__ring"></span>
          </div>
        {%- endif -%}

        {%- if block_count > 0 -%}
          <ul class="sla__cards" role="list" data-sla-list>
            {%- for block in section.blocks -%}
              {%- liquid
                assign b = block.settings
                assign style = b.style | default: 'benefit'
                assign label = b.label | strip
                if label == blank and b.product != blank
                  assign label = b.product.title
                endif
                assign link = b.link
                if link == blank and b.product != blank
                  assign link = b.product.url
                endif
                assign has_video = false
                if style == 'benefit'
                  if b.video != blank or b.video_url != blank
                    assign has_video = true
                  endif
                endif
                assign shot = b.image
                if shot == blank and b.product != blank and b.product.featured_image != blank
                  assign shot = b.product.featured_image
                endif
                if shot == blank and b.video != blank
                  assign shot = b.video.preview_image
                endif
                assign alt_text = b.image_alt | default: shot.alt | default: label
                assign label_id = 'SlaLabel-' | append: block.id
                assign focusable = false
                if link == blank and has_video == false
                  assign focusable = true
                endif
                assign fp_style = ''
                if shot.presentation.focal_point != blank
                  assign fp_style = 'object-position: ' | append: shot.presentation.focal_point
                endif
              -%}
              <li
                class="sla__card sla__card--{{ style | escape }}"
                data-sla-card
                data-block-id="{{ block.id }}"
                {% if focusable %}tabindex="0"{% endif %}
                {{ block.shopify_attributes }}
              >
                <div class="sla__inner">
                  {%- if shot != blank -%}
                    {{-
                      shot
                      | image_url: width: 1035
                      | image_tag:
                        widths: card_widths,
                        sizes: card_sizes,
                        loading: 'lazy',
                        alt: alt_text,
                        style: fp_style,
                        draggable: 'false'
                    -}}
                  {%- else -%}
                    {{- 'lifestyle-1' | placeholder_svg_tag: 'sla__ph' -}}
                  {%- endif -%}
                  <span class="sla__ov" aria-hidden="true"></span>
                  {%- if link != blank -%}
                    <a class="sla__hit" href="{{ link }}" {% if label != blank %}aria-labelledby="{{ label_id }}"{% else %}aria-label="{{ alt_text | default: 'View details' | escape }}"{% endif %}></a>
                  {%- endif -%}
                  {%- if label != blank -%}
                    {%- if style == 'product' -%}
                      <p class="sla__pill" id="{{ label_id }}">{{ label | escape }}</p>
                    {%- else -%}
                      <p class="sla__label" id="{{ label_id }}">{{ label | escape }}</p>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if has_video -%}
                    <button type="button" class="sla__play" data-sla-play aria-haspopup="dialog" aria-label="{{ s.play_label | default: 'Play video' | escape }}{% if label != blank %}: {{ label | escape }}{% endif %}"></button>
                    <template data-sla-tpl>
                      {%- if b.video != blank -%}
                        {{- b.video | video_tag: autoplay: true, controls: true, playsinline: true, preload: 'auto', image_size: '1200x' -}}
                      {%- elsif b.video_url.type == 'youtube' -%}
                        <iframe src="https://www.youtube-nocookie.com/embed/{{ b.video_url.id }}?autoplay=1&rel=0&playsinline=1" title="{{ label | default: s.dialog_label | escape }}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
                      {%- elsif b.video_url.type == 'vimeo' -%}
                        <iframe src="https://player.vimeo.com/video/{{ b.video_url.id }}?autoplay=1&dnt=1" title="{{ label | default: s.dialog_label | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                      {%- endif -%}
                    </template>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="sla__empty">Add card blocks to build the arc. Each card can be a product (outlined label) or a benefit (white label and an optional video).</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if block_count > 0 -%}
    <dialog class="sla__dialog" data-sla-dialog aria-label="{{ s.dialog_label | default: 'Video' | escape }}">
      <div class="sla__dlg-box">
        <button type="button" class="sla__close" data-sla-close aria-label="{{ s.close_label | default: 'Close video' | escape }}"></button>
        <div class="sla__dlg-media" data-sla-media></div>
      </div>
    </dialog>
  {%- endif -%}
</div>

{%- if block_count > 0 -%}
<script>
  (function () {
    if (!window.SystemLogicArc) {
      var W = window;
      var D = document;
      var mql = function (q) { return W.matchMedia ? W.matchMedia(q) : null; };
      var onMq = function (m, fn) {
        if (!m) return function () {};
        if (m.addEventListener) { m.addEventListener('change', fn); return function () { m.removeEventListener('change', fn); }; }
        if (m.addListener) { m.addListener(fn); return function () { m.removeListener(fn); }; }
        return function () {};
      };
      var clamp = function (v, a, b) { return v < a ? a : v > b ? b : v; };
      var scrollY = function () { return W.pageYOffset || D.documentElement.scrollTop || 0; };
      var RAD = Math.PI / 180;

      var SLA = function (root) {
        var self = this;
        this.root = root;
        this.track = root.querySelector('[data-sla-track]');
        this.sticky = root.querySelector('[data-sla-sticky]');
        this.list = root.querySelector('[data-sla-list]');
        this.cards = Array.prototype.map.call(root.querySelectorAll('[data-sla-card]'), function (el) {
          return { el: el, key: '', z: '', far: false };
        });
        this.dialog = root.querySelector('[data-sla-dialog]');
        this.media = root.querySelector('[data-sla-media]');
        this.count = this.cards.length;
        this.stepDeg = clamp(parseFloat(root.getAttribute('data-step')) || 10, 1, 45);
        this.radius = Math.max(200, parseFloat(root.getAttribute('data-radius')) || 2440);
        this.autoOffset = root.getAttribute('data-offset-mode') !== 'custom';
        this.rp = 0; // rendered progress
        this.target = 0; // progress from the scroll position
        this.raf = 0;
        this.inView = !('IntersectionObserver' in W);
        this.mode = '';
        this.m = { offset: 0, top: 0, th: 0, sh: 0, step: 1, hold: 0, R: 0, max: 90, fade: 5 };
        this.edge = 0; // 0 .. 1: how far the scroll is into the dwell at either end (1 = at the pin edge)
        this.offs = [];
        this.ac = typeof AbortController !== 'undefined' ? new AbortController() : null;
        this.tick = function (now) { self.frame(now); };
        this.onScroll = function () { self.scrolled(); };
        if (!this.count || !this.track || !this.sticky) return;
        this.isArc = root.classList.contains('sla--arc') && this.count > 1;
        // Phones held sideways (and very short windows): the pinned arc cannot fit, so show the row instead.
        this.mqShort = mql('(max-width: 990px) and (max-height: 540px) and (orientation: landscape), (max-height: 420px)');
        this.mqReduce = mql('(prefers-reduced-motion: reduce)');
        this.init();
      };

      SLA.prototype.on = function (el, type, fn, opts) {
        var o = opts || {};
        if (this.ac) {
          o.signal = this.ac.signal;
          el.addEventListener(type, fn, o);
        } else {
          el.addEventListener(type, fn, o);
          this.offs.push(function () { el.removeEventListener(type, fn, o); });
        }
      };

      SLA.prototype.init = function () {
        var self = this;
        this.initDialog();
        if (!this.isArc) {
          this.mode = 'list';
          return;
        }
        this.applyMode();
        this.on(W, 'scroll', this.onScroll, { passive: true });
        this.on(W, 'resize', function () { self.remeasure(); }, { passive: true });
        this.on(D, 'theme:resize', function () { self.remeasure(); });
        this.on(W, 'load', function () { self.remeasure(); });
        if (D.fonts && D.fonts.ready) D.fonts.ready.then(function () { self.remeasure(); });
        if ('ResizeObserver' in W) {
          // Track / sticky size (offset, viewport, layout changes) and body size (content above us loading in).
          this.ro = new ResizeObserver(function () { self.remeasure(); });
          this.ro.observe(this.track);
          this.ro.observe(this.sticky);
          this.ro.observe(D.body);
        }
        if ('IntersectionObserver' in W) {
          this.io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { self.setInView(en.isIntersecting); });
          }, { rootMargin: '25% 0px 25% 0px' });
          this.io.observe(this.track);
          // Load and decode every card image before the section scrolls into view.
          this.pio = new IntersectionObserver(function (entries) {
            if (!entries.some(function (en) { return en.isIntersecting; })) return;
            self.preload();
            self.pio.disconnect();
            self.pio = null;
          }, { rootMargin: '150% 0px 150% 0px' });
          this.pio.observe(this.track);
        } else {
          this.preload();
        }
        this.offs.push(onMq(this.mqReduce, function () { self.applyMode(); }));
        this.offs.push(onMq(this.mqShort, function () { self.applyMode(); }));
        // Keyboard: focusing a card brings it to the centre slot (pointer focus does not scroll).
        this.on(this.list, 'pointerdown', function () { self.ptrAt = Date.now(); }, { passive: true });
        this.on(this.list, 'focusin', function (e) { self.focused(e); });
        // Theme editor: sections moved / another section re-rendered can shift us without a resize.
        var relayout = function () { self.hookHeader(); self.remeasure(); };
        this.on(D, 'shopify:section:reorder', relayout);
        this.on(D, 'shopify:section:load', relayout);
        this.on(D, 'shopify:section:unload', relayout);
        this.hookLenis();
        this.hookHeader();
      };

      // Directional header ("sticky only when scrolling up"): follow its shown / hidden class.
      SLA.prototype.hookHeader = function () {
        var self = this;
        if (this.hmo) { this.hmo.disconnect(); this.hmo = null; }
        var hdr = this.autoOffset ? D.querySelector('[data-header-sticky="directional"]') : null;
        this.hdr = hdr;
        this.root.classList.toggle('sla--hdr-dir', !!hdr);
        this.syncHeader();
        if (hdr && 'MutationObserver' in W) {
          this.hmo = new MutationObserver(function () { self.syncHeader(); });
          this.hmo.observe(hdr, { attributes: true, attributeFilter: ['class'] });
        }
      };

      SLA.prototype.syncHeader = function () {
        var shown = !!(this.hdr && this.mode === 'arc' && this.hdr.classList.contains('js__header__stuck--trigger-animation'));
        this.root.classList.toggle('sla--hdr-in', shown);
      };

      // window.lenis is created by a deferred script in layout/theme.liquid, possibly after we boot.
      SLA.prototype.hookLenis = function () {
        var self = this;
        var tries = 0;
        var attempt = function () {
          if (self.dead) return true;
          var L = W.lenis;
          if (!L || typeof L.on !== 'function') return false;
          var fn = function () { self.scrolled(); };
          var un = L.on('scroll', fn);
          self.offs.push(function () {
            if (typeof un === 'function') un();
            else if (typeof L.off === 'function') L.off('scroll', fn);
          });
          self.lenis = L;
          return true;
        };
        if (attempt()) return;
        var stop = function () { clearInterval(self.lenisPoll); self.lenisPoll = 0; };
        this.lenisPoll = setInterval(function () { if (attempt() || ++tries > 40) stop(); }, 250);
        this.on(W, 'load', function () { if (self.lenisPoll && attempt()) stop(); });
      };

      SLA.prototype.preload = function () {
        this.cards.forEach(function (c) {
          var img = c.el.querySelector('img');
          if (!img) return;
          if (img.getAttribute('loading') === 'lazy') img.setAttribute('loading', 'eager');
          if (img.decode) img.decode().catch(function () {});
        });
        var decor = this.root.querySelector('.sla__decor img');
        if (decor && decor.getAttribute('loading') === 'lazy') decor.setAttribute('loading', 'eager');
      };

      SLA.prototype.measure = function () {
        var cs = W.getComputedStyle(this.root);
        var top = parseFloat(W.getComputedStyle(this.sticky).top);
        if (this.root.classList.contains('sla--hdr-dir')) {
          // Progress uses the resting offset, not the (possibly transitioning) one of the directional header.
          top = parseFloat(cs.getPropertyValue('--sla-top'));
        }
        var r = this.track.getBoundingClientRect();
        var th = this.track.offsetHeight;
        var sh = this.sticky.offsetHeight;
        var vw = this.sticky.clientWidth;
        var c0 = this.cards[0].el;
        var w = c0.offsetWidth || 345;
        var h = c0.offsetHeight || 420;
        var rk = parseFloat(cs.getPropertyValue('--sla-rk')) || 1;
        // Track = sticky viewport + (cards - 1 + 2 x hk) card lengths; hk card lengths of dwell at each end.
        var hk = Math.max(0, parseFloat(cs.getPropertyValue('--sla-hk')) || 0);
        var step = Math.max(1, (th - sh) / (this.count - 1 + 2 * hk));
        var R = this.radius * rk * (w / 345);
        // Card centre (the centre slot) inside the sticky viewport.
        var ay = c0.offsetTop + h / 2 + (this.list ? this.list.offsetTop : 0) + (this.list && this.list.parentNode ? this.list.parentNode.offsetTop : 0);
        // Angle at which a card has fully left the screen (sideways or through the bottom).
        var max = 90;
        for (var a = 0; a <= 90; a += 0.25) {
          var sn = Math.sin(a * RAD);
          var cn = Math.cos(a * RAD);
          var hw = (w * cn + h * sn) / 2;
          var hh = (w * sn + h * cn) / 2;
          if (R * sn - hw > vw / 2 + 2 || ay + R * (1 - cn) - hh > sh + 2) { max = a; break; }
        }
        this.m = {
          offset: isNaN(top) ? 0 : top,
          top: r.top + scrollY(),
          th: th,
          sh: sh,
          step: step,
          hold: hk * step,
          R: R,
          max: max,
          // Soft fade only over the last stretch before a card leaves the screen, so nothing pops
          // (never more than 15% of the visible range: peeking neighbours on phones stay solid)
          fade: Math.max(0.5, Math.min(this.stepDeg * 0.5, max * 0.15))
        };
        for (var i = 0; i < this.cards.length; i++) this.cards[i].key = '';
      };

      SLA.prototype.remeasure = function () {
        var self = this;
        if (this.mrq || this.dead) return;
        this.mrq = requestAnimationFrame(function () {
          self.mrq = 0;
          if (self.dead || self.mode !== 'arc') return;
          self.measure();
          self.render(!!self.raf);
          self.scrolled();
        });
      };

      SLA.prototype.progress = function () {
        var m = this.m;
        var px = scrollY() + m.offset - m.top - m.hold;
        var end = (this.count - 1) * m.step;
        // Position inside the end dwells: 0 at the inner edge, 1 where the band pins / unpins.
        var out = px < 0 ? -px : px > end ? px - end : 0;
        this.edge = out <= 0 ? 0 : m.hold > 0 ? Math.min(1, out / m.hold) : 1;
        return clamp(px / m.step, 0, this.count - 1);
      };

      SLA.prototype.scrolled = function () {
        if (this.dead || this.mode !== 'arc') return;
        this.target = this.progress();
        if (!this.inView) return;
        // Lenis can update the scroll after this frame's tick: apply the dwell limit right away.
        if (this.raf && this.bound()) this.render(true);
        this.kick();
      };

      // Inside the end dwells the allowed lag shrinks from 1 card to 0, so card 1 / the last card is exactly
      // centred by the time the band pins / unpins, whatever the scroll speed. Returns true if rp changed.
      SLA.prototype.bound = function () {
        if (this.edge <= 0) return false;
        var maxLag = 1 - this.edge;
        var rp = this.rp;
        if (this.target - rp > maxLag) rp = this.target - maxLag;
        else if (rp - this.target > maxLag) rp = this.target + maxLag;
        if (Math.abs(this.target - rp) < 0.0005) rp = this.target;
        if (rp === this.rp) return false;
        this.rp = rp;
        return true;
      };

      SLA.prototype.kick = function () {
        if (this.raf || this.target === this.rp) return;
        this.last = 0;
        this.root.classList.add('sla--moving');
        this.raf = requestAnimationFrame(this.tick);
      };

      // One rAF loop per instance: it runs only while the rendered progress is catching up with the
      // scroll position, and stops when it settles (or when the section leaves the viewport).
      SLA.prototype.frame = function (now) {
        this.raf = 0;
        if (this.dead || this.mode !== 'arc') return;
        var dt = this.last ? Math.min(64, now - this.last) : 16.667;
        this.last = now;
        var d = this.target - this.rp;
        if (Math.abs(d) < 0.0005) {
          this.rp = this.target;
          this.settle();
          return;
        }
        // Lenis already smooths the scroll, so follow it more tightly when it is active.
        var f = this.lenis ? 0.24 : 0.12;
        if (this.edge > 0) f = Math.max(f, 0.3); // the target is clamped: close the gap within the dwell
        this.rp += d * (1 - Math.pow(1 - f, dt / 16.667));
        if (this.bound() && this.rp === this.target) {
          this.settle();
          return;
        }
        this.render(true);
        this.raf = requestAnimationFrame(this.tick);
      };

      // Resting state: plain 2D transforms (no compositor layers), so rotated cards repaint crisp.
      SLA.prototype.settle = function () {
        this.root.classList.remove('sla--moving');
        this.render(false);
      };

      // Writes only (transform / opacity / z-index), cached per card.
      SLA.prototype.render = function (moving) {
        var m = this.m;
        var rp = this.rp;
        var step = this.stepDeg;
        var R = m.R;
        var max = m.max;
        var fade = m.fade;
        for (var i = 0; i < this.count; i++) {
          var c = this.cards[i];
          var th = (i - rp) * step;
          var a = th < 0 ? -th : th;
          var op;
          if (a >= max) op = 0;
          else if (a <= max - fade) op = 1;
          else { op = (max - a) / fade; op = op * op * (3 - 2 * op); }
          var x = R * Math.sin(th * RAD);
          var y = R * (1 - Math.cos(th * RAD));
          var tr = (moving ? 'translate3d(' + x.toFixed(2) + 'px, ' + y.toFixed(2) + 'px, 0)' : 'translate(' + x.toFixed(2) + 'px, ' + y.toFixed(2) + 'px)') + ' rotate(' + th.toFixed(3) + 'deg)';
          var o = op >= 0.999 ? '1' : op.toFixed(3);
          var key = tr + '|' + o;
          if (key !== c.key) {
            c.key = key;
            c.el.style.transform = tr;
            c.el.style.opacity = o;
          }
          // Nearest the centre on top
          var z = String(1000 - Math.round(a * 4));
          if (z !== c.z) { c.z = z; c.el.style.zIndex = z; }
          var far = op < 0.35;
          if (far !== c.far) { c.far = far; c.el.classList.toggle('is-far', far); }
        }
      };

      SLA.prototype.setInView = function (v) {
        this.inView = v;
        if (this.mode !== 'arc') return;
        if (v) {
          // Re-measure once per entry: the section may have moved without any size change.
          this.measure();
          this.target = this.progress();
          if (Math.abs(this.target - this.rp) > 1.5) {
            // Coming back after a jump (anchor link, fast fling): snap instead of sweeping through every card.
            if (this.raf) { cancelAnimationFrame(this.raf); this.raf = 0; }
            this.rp = this.target;
            this.settle();
          }
          this.kick();
          return;
        }
        // Off screen: stop the loop and snap to the resting state so it is right when we come back.
        if (this.raf) { cancelAnimationFrame(this.raf); this.raf = 0; }
        this.target = this.rp = this.progress();
        this.settle();
      };

      SLA.prototype.resetCards = function () {
        this.cards.forEach(function (c) {
          c.key = c.z = '';
          c.far = false;
          c.el.style.transform = '';
          c.el.style.opacity = '';
          c.el.style.zIndex = '';
          c.el.classList.remove('is-far');
        });
      };

      SLA.prototype.applyMode = function () {
        var reduce = !!(this.mqReduce && this.mqReduce.matches);
        var short = !!(this.mqShort && this.mqShort.matches);
        var mode = reduce || short ? 'list' : 'arc';
        this.root.classList.toggle('sla--list', mode === 'list');
        this.mode = mode;
        this.syncHeader();
        if (this.raf) { cancelAnimationFrame(this.raf); this.raf = 0; }
        this.root.classList.remove('sla--moving');
        this.resetCards();
        if (mode === 'list') return;
        this.measure();
        this.target = this.rp = this.progress();
        this.render(false);
        this.root.classList.add('sla--ready');
      };

      SLA.prototype.restY = function (i) {
        var m = this.m;
        if (i >= this.count) return m.top + m.th - m.offset; // past the end of the section
        return m.top - m.offset + m.hold + i * m.step;
      };

      SLA.prototype.scrollToY = function (y, instant) {
        y = Math.max(0, Math.round(y));
        var L = W.lenis;
        if (L && typeof L.scrollTo === 'function') {
          try {
            L.scrollTo(y, instant ? { immediate: true, force: true } : { duration: 1.2, force: true });
            return;
          } catch (e) {}
        }
        if (instant) {
          var h = D.documentElement;
          var prev = h.style.scrollBehavior;
          h.style.scrollBehavior = 'auto'; // the theme sets html { scroll-behavior: smooth }
          W.scrollTo(0, y);
          h.style.scrollBehavior = prev;
          return;
        }
        try { W.scrollTo({ top: y, behavior: 'smooth' }); } catch (e) { W.scrollTo(0, y); }
      };

      SLA.prototype.indexOf = function (el) {
        for (var i = 0; i < this.count; i++) if (this.cards[i].el === el || this.cards[i].el.contains(el)) return i;
        return -1;
      };

      SLA.prototype.focused = function (e) {
        if (this.mode !== 'arc' || this.noFocusScroll) return;
        // The sticky viewport is overflow: clip, but reset it anyway in case a browser scrolled it.
        if (this.sticky.scrollLeft || this.sticky.scrollTop) { this.sticky.scrollLeft = 0; this.sticky.scrollTop = 0; }
        if (this.ptrAt && Date.now() - this.ptrAt < 800) return; // mouse / touch focus: no scroll
        var i = this.indexOf(e.target);
        if (i < 0) return;
        this.measure();
        var y = this.restY(i);
        if (Math.abs(this.target - i) < 0.02 && Math.abs(scrollY() - y) < 2) return;
        this.scrollToY(y, false);
      };

      SLA.prototype.selectBlock = function (blockId) {
        var idx = -1;
        this.cards.forEach(function (c, k) { if (c.el.getAttribute('data-block-id') === blockId) idx = k; });
        if (idx < 0) return;
        if (this.mode !== 'arc') {
          var card = this.cards[idx].el;
          var y = this.root.getBoundingClientRect().top + scrollY() - 60;
          this.scrollToY(y, true);
          if (this.list && this.list.scrollWidth > this.list.clientWidth) {
            this.list.scrollLeft = card.offsetLeft - (this.list.clientWidth - card.offsetWidth) / 2;
          }
          return;
        }
        this.measure();
        this.scrollToY(this.restY(idx), true);
        if (this.raf) { cancelAnimationFrame(this.raf); this.raf = 0; }
        this.target = this.rp = idx;
        this.settle();
      };

      // ---------- Video lightbox ----------
      SLA.prototype.initDialog = function () {
        var self = this;
        var dlg = this.dialog;
        if (!dlg) return;
        this.on(this.root, 'click', function (e) {
          var btn = e.target.closest ? e.target.closest('[data-sla-play]') : null;
          if (!btn || !self.root.contains(btn)) return;
          e.preventDefault();
          self.openVideo(btn);
        });
        var closeBtn = dlg.querySelector('[data-sla-close]');
        if (closeBtn) this.on(closeBtn, 'click', function () { self.closeVideo(); });
        // Click on the backdrop (outside the box) closes.
        this.on(dlg, 'click', function (e) { if (e.target === dlg) self.closeVideo(); });
        this.on(dlg, 'cancel', function (e) { e.preventDefault(); self.closeVideo(); });
        this.on(dlg, 'close', function () { self.afterClose(); });
      };

      // Page scroll lock while the video is open: the theme's own lock first (touch scrolling + scrollbar gap),
      // a plain overflow lock with scrollbar compensation only when no theme lock answers.
      SLA.prototype.lock = function (on) {
        var self = this;
        var h = D.documentElement;
        var L = W.lenis;
        if (on) {
          clearTimeout(this.lockT);
          this.fallback = null;
          (this.dialog || D).dispatchEvent(new CustomEvent('theme:scroll:lock', { bubbles: true, detail: this.dialog }));
          // The theme applies its lock in a timeout and marks <html data-scroll-locked>.
          this.lockT = setTimeout(function () {
            if (!self.locked || h.hasAttribute('data-scroll-locked')) return;
            var gap = W.innerWidth - h.clientWidth;
            self.fallback = { overflow: h.style.overflow, pad: h.style.paddingRight };
            if (gap > 0) h.style.paddingRight = gap + 'px';
            h.style.overflow = 'hidden';
          }, 30);
          this.lenisWasStopped = !!(L && L.isStopped);
          if (L && typeof L.stop === 'function' && !this.lenisWasStopped) { try { L.stop(); } catch (e) {} }
        } else {
          clearTimeout(this.lockT);
          if (this.fallback) {
            h.style.overflow = this.fallback.overflow || '';
            h.style.paddingRight = this.fallback.pad || '';
            this.fallback = null;
          }
          D.dispatchEvent(new CustomEvent('theme:scroll:unlock', { bubbles: true }));
          if (L && typeof L.start === 'function' && !this.lenisWasStopped) { try { L.start(); } catch (e) {} }
        }
      };

      SLA.prototype.openVideo = function (btn) {
        var dlg = this.dialog;
        var card = btn.closest('[data-sla-card]');
        var tpl = card && card.querySelector('template[data-sla-tpl]');
        if (!dlg || !tpl || !this.media) return;
        if (dlg.open) this.closeVideo();
        this.opener = btn;
        this.media.innerHTML = '';
        this.media.appendChild(tpl.content.cloneNode(true));
        var label = card.querySelector('.sla__label, .sla__pill');
        if (label) dlg.setAttribute('aria-describedby', label.id);
        else dlg.removeAttribute('aria-describedby');
        this.locked = true;
        this.lock(true);
        if (typeof dlg.showModal === 'function') {
          try { dlg.showModal(); } catch (e) { dlg.setAttribute('open', ''); }
        } else {
          dlg.setAttribute('open', '');
        }
        var v = this.media.querySelector('video');
        if (v) {
          v.setAttribute('controls', '');
          v.setAttribute('playsinline', '');
          var pr = v.play();
          if (pr && pr.catch) pr.catch(function () {});
        }
        var close = dlg.querySelector('[data-sla-close]');
        if (close) close.focus({ preventScroll: true });
      };

      SLA.prototype.closeVideo = function () {
        var dlg = this.dialog;
        if (!dlg) return;
        // The browser hands focus back to the play button while closing: that must not scroll the arc.
        this.noFocusScroll = true;
        if (dlg.open && typeof dlg.close === 'function') dlg.close();
        else { dlg.removeAttribute('open'); this.afterClose(); }
      };

      SLA.prototype.afterClose = function () {
        var self = this;
        if (this.media) {
          var v = this.media.querySelector('video');
          if (v) { try { v.pause(); } catch (e) {} }
          this.media.innerHTML = ''; // removes the video / iframe, which stops playback
        }
        if (this.dialog) this.dialog.removeAttribute('aria-describedby');
        if (this.locked) { this.lock(false); this.locked = false; }
        var btn = this.opener;
        this.opener = null;
        this.noFocusScroll = true;
        if (btn && D.contains(btn) && D.activeElement !== btn) {
          // Return focus without moving the page or the arc.
          try { btn.focus({ preventScroll: true }); } catch (e) { btn.focus(); }
        }
        setTimeout(function () { self.noFocusScroll = false; }, 0);
      };

      SLA.prototype.destroy = function () {
        this.dead = true;
        if (this.dialog && this.dialog.open) this.closeVideo();
        if (this.locked) { this.lock(false); this.locked = false; }
        if (this.raf) cancelAnimationFrame(this.raf);
        if (this.mrq) cancelAnimationFrame(this.mrq);
        clearInterval(this.lenisPoll);
        if (this.ac) this.ac.abort();
        this.offs.forEach(function (fn) { fn(); });
        this.offs = [];
        if (this.ro) this.ro.disconnect();
        if (this.io) this.io.disconnect();
        if (this.pio) this.pio.disconnect();
        if (this.hmo) this.hmo.disconnect();
        this.root.classList.remove('sla--hdr-in', 'sla--hdr-dir', 'sla--moving');
        this.raf = this.mrq = 0;
      };

      var api = {
        instances: {},
        mount: function (sectionId) {
          var root = document.querySelector('[data-sla][data-section-id="' + sectionId + '"]');
          var current = this.instances[sectionId];
          if (current) {
            if (current.root === root) return current;
            this.unmount(sectionId);
          }
          if (!root) return null;
          var inst = new SLA(root);
          this.instances[sectionId] = inst;
          return inst;
        },
        unmount: function (sectionId) {
          var current = this.instances[sectionId];
          if (current) {
            current.destroy();
            delete this.instances[sectionId];
          }
        }
      };
      window.SystemLogicArc = api;

      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId) api.mount(e.detail.sectionId);
      });
      document.addEventListener('shopify:section:unload', function (e) {
        if (e.detail && e.detail.sectionId) api.unmount(e.detail.sectionId);
      });
      document.addEventListener('shopify:block:select', function (e) {
        var inst = e.detail && api.instances[e.detail.sectionId];
        if (inst && inst.mode) inst.selectBlock(e.detail.blockId);
      });
    }

    // The markup is above this script, so mount right away (before first paint where possible).
    window.SystemLogicArc.mount({{ section.id | json }});
  })();
</script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "System Logic Arc",
  "tag": "section",
  "class": "sla-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "richtext", "id": "heading", "label": "Heading", "info": "Italic text uses the Tiempos italic font.", "default": "<p>The System <em>Logic</em></p>" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 30, "max": 80, "step": 1, "unit": "px", "default": 58 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 28 },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Shared base - 1% Lactobacillus Ferment Lysate (postbiotic) in both steps" },
    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "subtitle_font", "label": "Subtitle", "info": "Design: Montserrat Regular.", "default": "montserrat_n4" },
    { "type": "font_picker", "id": "label_font", "label": "Benefit card label", "info": "Design: Montserrat SemiBold.", "default": "montserrat_n6" },
    { "type": "font_picker", "id": "pill_font", "label": "Product card label", "info": "Design: Montserrat Medium.", "default": "montserrat_n5" },
    { "type": "header", "content": "Decorative image" },
    { "type": "image_picker", "id": "decor_image", "label": "Image", "info": "Sits behind the cards at the bottom left. 821 × 856 px with a transparent background works best." },
    { "type": "checkbox", "id": "show_decor_mobile", "label": "Show on mobile", "default": false },
    { "type": "header", "content": "Scroll animation" },
    { "type": "paragraph", "content": "The section pins while the cards travel along the arc, and moves on once the last card reaches the centre. Visitors who prefer reduced motion see a swipeable row." },
    { "type": "range", "id": "scroll_per_card", "label": "Scroll distance per card", "min": 40, "max": 150, "step": 5, "unit": "vh", "info": "100 = one screen height of scrolling per card.", "default": 70 },
    { "type": "range", "id": "arc_radius", "label": "Arc radius", "min": 1200, "max": 4000, "step": 40, "unit": "px", "info": "At desktop size. Smaller = tighter curve. Scales with the card size.", "default": 2440 },
    { "type": "range", "id": "angle_step", "label": "Angle between cards", "min": 6, "max": 20, "step": 1, "unit": "°", "default": 10 },
    {
      "type": "select",
      "id": "sticky_offset_mode",
      "label": "Pin below",
      "options": [
        { "value": "auto", "label": "Sticky header (automatic)" },
        { "value": "custom", "label": "Custom offset" }
      ],
      "default": "auto",
      "info": "Automatic pins below the header when it is sticky. With 'sticky only when scrolling up', the band moves down with the header while it is shown."
    },
    { "type": "range", "id": "sticky_offset", "label": "Custom offset", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Orbit guides" },
    { "type": "checkbox", "id": "show_guides", "label": "Show orbit lines", "info": "Thin lines around the centre card and along the arc.", "default": false },
    { "type": "color", "id": "guide_color", "label": "Line color", "default": "#28201F" },
    { "type": "range", "id": "guide_opacity", "label": "Line opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 15 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_band", "label": "Band background", "default": "#F6F3EE" },
    { "type": "color", "id": "text_color", "label": "Heading and subtitle", "default": "#28201F" },
    { "type": "color", "id": "benefit_overlay", "label": "Benefit card shade", "default": "#28201F" },
    { "type": "color", "id": "product_overlay", "label": "Product card shade", "default": "#FFFFFF" },
    { "type": "range", "id": "overlay_opacity", "label": "Card shade opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
    { "type": "color", "id": "label_color", "label": "Benefit label", "default": "#FFFFFF" },
    { "type": "color", "id": "pill_color", "label": "Product label and outline", "default": "#28201F" },
    { "type": "color", "id": "play_bg", "label": "Play button", "default": "#FFFFFF" },
    { "type": "color", "id": "play_icon", "label": "Play icon", "default": "#78563D" },
    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "play_label", "label": "Play button", "default": "Play video" },
    { "type": "text", "id": "close_label", "label": "Close button", "default": "Close video" },
    { "type": "text", "id": "dialog_label", "label": "Video window name", "default": "Video" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 12,
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "product", "label": "Product (outlined label)" },
            { "value": "benefit", "label": "Benefit (white label, video)" }
          ],
          "default": "benefit"
        },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "345 × 420 px in the design. Falls back to the product image." },
        { "type": "text", "id": "label", "label": "Label", "info": "Falls back to the product title." },
        { "type": "header", "content": "Video (benefit cards)" },
        { "type": "video", "id": "video", "label": "Video", "info": "Shows a play button that opens the video in a window." },
        { "type": "video_url", "id": "video_url", "label": "Or YouTube / Vimeo link", "accept": ["youtube", "vimeo"] },
        { "type": "header", "content": "Link" },
        { "type": "product", "id": "product", "label": "Product", "info": "Optional. The whole card links to it." },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional. Overrides the product link." },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "info": "Optional. Defaults to the image's alt text, then the label." }
      ]
    }
  ],
  "presets": [
    {
      "name": "System Logic Arc",
      "blocks": [
        { "type": "card", "settings": { "style": "product", "label": "Clean It Off Face Wash" } },
        { "type": "card", "settings": { "style": "benefit", "label": "Removes buildup" } },
        { "type": "card", "settings": { "style": "benefit", "label": "Won't strip skin" } },
        { "type": "card", "settings": { "style": "product", "label": "Soak It In Face Cream" } },
        { "type": "card", "settings": { "style": "benefit", "label": "Locks in moisture" } },
        { "type": "card", "settings": { "style": "benefit", "label": "Non-greasy finish" } }
      ]
    }
  ]
}
{% endschema %}
