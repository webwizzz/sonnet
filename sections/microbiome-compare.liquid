    }
    .before-label{
      left: 10px !important; 
    }
  } 

.comparison {
  position: relative;
  width: 100%;
  height: 580px;
  border-radius: 16px;
  overflow: hidden;
}
.after-image {
  position: absolute;
  inset: 0;
  background-size: cover;
  {% comment %} background-position: center; {% endcomment %}
}
.before-after-slider-input {
  position: absolute;
  inset: 0;
  width: 100%;
  background: transparent;
  -webkit-appearance: none;
  appearance: none;
  z-index: 4;
  cursor: ew-resize;

}
.before-after-slider-input {
  pointer-events: auto;
  touch-action: pan-x !important;
  -webkit-appearance: none;
}
.before-after-slider-input::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 26px;
  height: 46px;
  background: transparent;
}

.before-after-slider-input::-moz-range-thumb {
  width: 26px;
  height: 46px;
  background: transparent;
}
.handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 38px;
    height: 65px;
    background: #fff;
    border-radius: 50px;
    transform: translate(-50%, -50%);
    z-index: 3;
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: center;
    -webkit-box-shadow: none;
    box-shadow: none;
}
.handle svg{
  -webkit-box-shadow: none;
    box-shadow: none;
    background: transparent;
}
.before-label,
.after-label {
  position: absolute;
  top: 16px;
  padding: 5px 10px;
  background: #FFFFFF;
  color: #28201F;
  font-family: 'Blauer Nue RG';
  font-size: 12px;
  font-weight: 400;
  border-radius: 30px;
  z-index: 5;
  line-height:100%;
  letter-spacing: -2%;
  pointer-events: none;
  text-transform: uppercase;
}
.divisor {
  position: absolute;
  inset: 0 auto 0 0;
  width: 50%;
  background-size: cover;
  {% comment %} background-position: center; {% endcomment %}
  box-shadow: 2px 0 0 #fff;
}
.before-label {
  left: 16px;
}

.after-label {
    right: 16px;
    z-index: 0;
    background: #E5D5C2;
}

input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  box-shadow: none !important;
  border: none;
}
</style>

{%- comment -%}
  ─────────────────────────────────────────────────────────────
  CAPTURE: slider HTML (used twice — mobile + desktop)
  ─────────────────────────────────────────────────────────────
{%- endcomment -%}
{%- capture slider_html -%}
  <div class="before-after-card">
    <div class="compare-wrapper" data-before-after>
      <div class="comparison">
        <figure class="after-image" style="background-image:url('{{ mc_after_image | img_url: 'master' }}')">
          <div class="after-label">{{ mc_after_label }}</div>
          <div class="divisor" style="background-image:url('{{ mc_before_image | img_url: 'master' }}')">
            <div class="before-label">{{ mc_before_label }}</div>
          </div>
          <div class="handle">
            <svg width="15" height="9" viewBox="0 0 15 9" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10.8596 0.658508L14.2829 4.48199L10.8596 8.30548" stroke="#28201F" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M4.01294 0.658508L0.589661 4.48199L4.01294 8.30548" stroke="#28201F" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </figure>
        <input type="range" min="0" max="100" value="50" class="before-after-slider-input">
      </div>
    </div>
  </div>
  {%- if mc_quote != blank -%}
    <div class="mc__quote">{{ mc_quote }}</div>
  {%- endif -%}
{%- endcapture -%}

{%- comment -%}
  ─────────────────────────────────────────────────────────────
  CAPTURE: disrupted feature list items
  Handles both metaobject entries and section blocks uniformly.
  ─────────────────────────────────────────────────────────────
{%- endcomment -%}
{%- capture disrupted_items_html -%}
  {%- if use_meta_items -%}
    {%- for entry in mc_disrupted_items -%}
      {%- assign item_icon  = entry.icon.value -%}
      {%- assign item_title = entry.title.value -%}
      {%- assign item_desc  = entry.description.value -%}
      <li class="mc__feature">
        <div class="mc__feature-text_wrapper">
          {%- if item_icon != blank -%}
            <div class="mc__feature-num-wrap">
              <span class="mc__feature-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </div>
          {%- else -%}
            <span class="mc__feature-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          <div class="mc__feature-text">
            {%- if item_icon != blank -%}
              <img class="mc__feature-icon" src="{{ item_icon | image_url }}" alt="" loading="lazy">
            {%- endif -%}
            <p class="mc__feature-title">{{ item_title }}</p>
          </div>
        </div>
        <div class="mc__feature-desc_wrapper">
          <p class="mc__feature-desc">{{ item_desc }}</p>
        </div>
      </li>
    {%- endfor -%}
  {%- else -%}
    {%- for block in mc_disrupted_items -%}
      <li class="mc__feature" {{ block.shopify_attributes }}>
        <div class="mc__feature-text_wrapper">
          {%- if block.settings.icon != blank -%}
            <div class="mc__feature-num-wrap">
              <span class="mc__feature-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </div>
          {%- else -%}
            <span class="mc__feature-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          <div class="mc__feature-text">
            <img class="mc__feature-icon" src="{{ block.settings.icon | image_url }}" alt="" loading="lazy">
            <p class="mc__feature-title">{{ block.settings.title }}</p>
          </div>
        </div>
        <div class="mc__feature-desc_wrapper">
          <p class="mc__feature-desc">{{ block.settings.description }}</p>
        </div>
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- comment -%}
  ─────────────────────────────────────────────────────────────
  CAPTURE: balanced feature list items
  ─────────────────────────────────────────────────────────────
{%- endcomment -%}
{%- capture balanced_items_html -%}
  {%- if use_meta_items -%}
    {%- for entry in mc_balanced_items -%}
      {%- assign item_icon  = entry.icon.value -%}
      {%- assign item_title = entry.title.value -%}
      {%- assign item_desc  = entry.description.value -%}
      <li class="mc__feature" >
        <div class="mc__feature-text_wrapper">
          {%- if item_icon != blank -%}
            <div class="mc__feature-num-wrap">
              <span class="mc__feature-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </div>
          {%- else -%}
            <span class="mc__feature-index" style="background:rgba(80,140,80,0.15);color:#3a7a3a;">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          <div class="mc__feature-text">
            {%- if item_icon != blank -%}
              <img class="mc__feature-icon" src="{{ item_icon | image_url }}" alt="" loading="lazy">
            {%- endif -%}
            <p class="mc__feature-title">{{ item_title }}</p>
          </div>
        </div>
        <div class="mc__feature-desc_wrapper">
          <p class="mc__feature-desc">{{ item_desc }}</p>
        </div>
      </li>
    {%- endfor -%}
  {%- else -%}
    {%- for block in mc_balanced_items -%}
      <li class="mc__feature" {{ block.shopify_attributes }}>
        <div class="mc__feature-text_wrapper">
          {%- if block.settings.icon != blank -%}
            <div class="mc__feature-num-wrap">
              <span class="mc__feature-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </div>
          {%- else -%}
            <span class="mc__feature-index" style="background:rgba(80,140,80,0.15);color:#3a7a3a;">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          <div class="mc__feature-text">
            <img class="mc__feature-icon" src="{{ block.settings.icon | image_url }}" alt="" loading="lazy">
            <p class="mc__feature-title">{{ block.settings.title }}</p>
          </div>
        </div>
        <div class="mc__feature-desc_wrapper">
          <p class="mc__feature-desc">{{ block.settings.description }}</p>
        </div>
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div id="mc-{{ section.id }}" class="microbiome-compare">
  <div class="mc__inner">

    {%- comment -%} Heading ── {%- endcomment -%}
    <div class="mc__heading-wrap">
      {%- if mc_heading != blank -%}
        <div class="mc__heading">{{ mc_heading }}</div>
      {%- endif -%}
      {%- if mc_subheading != blank -%}
        <p class="mc__subheading">{{ mc_subheading }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Mobile slider (shown above panels on small screens) ── {%- endcomment -%}
    <div class="desktop-hide">
      <div class="mc__slider-col">
        {{ slider_html }}
      </div>
    </div>

    {%- comment -%} Desktop: 3-col grid ── {%- endcomment -%}
    <div class="mc__layout">

      {%- comment -%} Left panel — DISRUPTED ── {%- endcomment -%}
      <div class="mc__panel">
        <div class="mc__panel_inner">
          <div class="mc__panel-label">
            <span class="mc__panel-label-dot mc__panel-label-dot--disrupted"></span>
            {{ mc_left_label }}
          </div>
          <ul class="mc__feature-list">
            {{ disrupted_items_html }}
          </ul>
        </div>
      </div>

      {%- comment -%} Centre — slider (desktop) ── {%- endcomment -%}
      <div class="mc__slider-col mobile-hide">
        {{ slider_html }}
      </div>

      {%- comment -%} Right panel — BALANCED ── {%- endcomment -%}
      <div class="mc__panel">
        <div class="mc__panel_inner">
          <div class="mc__panel-label">
            <span class="mc__panel-label-dot mc__panel-label-dot--balanced"></span>
            {{ mc_right_label }}
          </div>
          <ul class="mc__feature-list">
            {{ balanced_items_html }}
          </ul>
        </div>
      </div>

    </div>
    {%- comment -%} end .mc__layout ── {%- endcomment -%}

  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

  document.querySelectorAll('[data-before-after]').forEach(wrapper => {
    const slider = wrapper.querySelector('.before-after-slider-input');
    const divisor = wrapper.querySelector('.divisor');
    const handle = wrapper.querySelector('.handle');
    const beforeLabel = wrapper.querySelector('.before-label');

    function move(val) {
      divisor.style.width = val + '%';
      handle.style.left = val + '%';

      // Hide before label when divisor is too small
      if (val < 10) {
        beforeLabel.style.opacity = '0';
      } else {
        beforeLabel.style.opacity = '1';
      }
    }

    // Default position
    slider.value = 50;
    move(slider.value);

    slider.addEventListener('input', e => {
      move(e.target.value);
    });

    slider.addEventListener('touchstart', e => {
      e.stopPropagation();
    }, { passive: true });

    slider.addEventListener('touchmove', e => {
      e.stopPropagation();
    }, { passive: true });

  });

});
</script>

