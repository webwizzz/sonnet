    }
    #mc-{{ section.id}} .mc__feature-title{
      font-size: 14px;
    }
    #mc-template--19513462456502__microbiome_compare_8HFKnW .mc__feature-desc {
      font-size: 12px;
    }
    #mc-{{ section.id }} .mc__heading {
      font-size: 28px;
      margin-bottom: 12px;
    }
    #mc-{{ section.id }} .mc__subheading{
