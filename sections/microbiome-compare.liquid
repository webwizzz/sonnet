{%- liquid
  comment
    ─────────────────────────────────────────────────────────────
    METAFIELD RESOLUTION
    ─────────────────────────────────────────────────────────────
    If this section is rendered on a product page and the product
    has metafields set, those values take priority over the
    section/customizer settings.

    Metafield namespace used: "microbiome_compare"

    Product metafields expected:
      microbiome_compare.heading          → richtext  (or single_line_text_field)
      microbiome_compare.subheading       → single_line_text_field
      microbiome_compare.before_image     → file_reference  (image)
      microbiome_compare.after_image      → file_reference  (image)
      microbiome_compare.before_label     → single_line_text_field
      microbiome_compare.after_label      → single_line_text_field
      microbiome_compare.quote            → single_line_text_field
      microbiome_compare.left_label       → single_line_text_field
      microbiome_compare.right_label      → single_line_text_field

    Metaobject type: "microbiome_compare_item"
    Fields on each entry:
      panel           → single_line_text_field  ("disrupted" | "balanced")
      icon            → file_reference          (image, optional)
      title           → single_line_text_field
      description     → multi_line_text_field

    Product metafields for item lists:
      microbiome_compare.disrupted_items  → list.metaobject_reference
      microbiome_compare.balanced_items   → list.metaobject_reference
    ─────────────────────────────────────────────────────────────
  endcomment

  assign mf = product.metafields.microbiome_compare

  comment — heading —
  endcomment
  if mf.heading != blank
    assign mc_heading = mf.headings | metafield_tag
  else
    assign mc_heading = section.settings.heading
  endif

  comment — subheading —
  endcomment
  if mf.subheading != blank
    assign mc_subheading = mf.subheading.value
  else
    assign mc_subheading = section.settings.subheading
  endif

  comment — images —
  endcomment
  if mf.before_image != blank
    assign mc_before_image = mf.before_image.value
  else
    assign mc_before_image = section.settings.before_image
  endif

  if mf.after_image != blank
    assign mc_after_image = mf.after_image.value
  else
    assign mc_after_image = section.settings.after_image
  endif

  comment — labels —
  endcomment
  if mf.before_label != blank
    assign mc_before_label = mf.before_label.value
  else
    assign mc_before_label = section.settings.before_label | default: 'Disrupted'
  endif

  if mf.after_label != blank
    assign mc_after_label = mf.after_label.value
  else
    assign mc_after_label = section.settings.after_label | default: 'Balanced'
  endif

  comment — quote —
  endcomment
  if mf.quote != blank
    assign mc_quote = mf.quote.value
  else
    assign mc_quote = section.settings.quote
  endif

  comment — panel labels —
  endcomment
  if mf.left_label != blank
    assign mc_left_label = mf.left_label.value
  else
    assign mc_left_label = section.settings.left_label | default: 'Microbiome Disrupted'
  endif

  if mf.right_label != blank
    assign mc_right_label = mf.right_label.value
  else
    assign mc_right_label = section.settings.right_label | default: 'Microbiome Balanced'
  endif

  comment
    ─── Feature items ───
    If the product has metaobject lists, use them.
    Otherwise fall back to section blocks (customizer).
  endcomment
  assign use_meta_items = false
  if mf.disrupted_items != blank or mf.balanced_items != blank
    assign use_meta_items = true
    assign mc_disrupted_items = mf.disrupted_items.value
    assign mc_balanced_items  = mf.balanced_items.value
  else
    assign mc_disrupted_items = section.blocks | where: 'type', 'disrupted_item'
    assign mc_balanced_items  = section.blocks | where: 'type', 'balanced_item'
  endif
-%}

<style>
