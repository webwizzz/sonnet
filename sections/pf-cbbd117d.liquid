    },
    {
      "type": "text",
      "id": "pf_872798cd_value",
      "label": "Text — Value",
      "default": "Vegan &amp; Cruelty Free: We have been passionate believers of making sure our products are vegan and cruelty free. We don’t involve any animals in our products or testing process. "
    },
    {
      "type": "text",
      "id": "pf_872798cd_placeholder",
