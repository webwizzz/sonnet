{%- comment -%}
  Set before / after: compare slider + "Before This Set / After This Set" checklist card.
  Design: design-specs/clean-it-off/sections/12-set-before-after.md (Figma 203:5492)
  Desktop: 850 + 20 + 850 (1720 content), both 700 tall, radius 16.
  Card: heading at +50, two #F5EEE6 boxes (331 × 396, gap 10) 40px below; each item =
  32 × 20 badge, 6px, Montserrat 400 18/25.2 text; 26px · 1px divider · 26px between items.
  Stacks at ≤1100px.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign text_color = s.text_color | default: '#28201F'
  assign divider = text_color | color_modify: 'alpha', 0.1
  assign compare_start = s.compare_start
  assign list_font = s.list_font
  assign before_count = 0
  assign after_count = 0
  for block in section.blocks
    if block.type == 'before_point'
      assign before_count = before_count | plus: 1
    elsif block.type == 'after_point'
      assign after_count = after_count | plus: 1
    endif
  endfor
  assign has_split = false
  if s.before_image != blank and s.after_image != blank
    assign has_split = true
  endif
-%}

{% style %}
{%- if list_font != blank -%}{{ list_font | font_face: font_display: 'swap' }}{%- endif -%}
#shopify-section-{{ section.id }} {
  --sba-text: {{ text_color }};
  --sba-divider: {{ divider }};
  --sba-card: {{ s.card_bg }};
  --sba-box: {{ s.box_bg }};
  --sba-no: {{ s.before_badge_color }};
  --sba-yes: {{ s.after_badge_color }};
  --sba-badge-icon: {{ s.badge_icon_color }};
  --sba-ui: {{ s.compare_ui_color }};
  --sba-start: {{ compare_start }}%;
  --sba-height: {{ s.desktop_height }}px;
  --sba-m-ratio: {{ s.mobile_aspect_ratio }};
  --sba-h-num: {{ s.heading_size }};
  --sba-h: {{ s.heading_size }}px;
  --sba-h-m: {{ s.heading_size_mobile }}px;
  --sba-list-font: {% if list_font != blank %}{{ list_font.family }}, {{ list_font.fallback_families }}{% else %}'Montserrat', sans-serif{% endif %};
  --sba-list-weight: {% if list_font != blank %}{{ list_font.weight }}{% else %}400{% endif %};
  background-color: {{ s.color_background }};
  padding-top: {{ s.padding_top }}px;
  padding-bottom: {{ s.padding_bottom }}px;
}
@media screen and (max-width: 768px) {
  #shopify-section-{{ section.id }} {
    padding-top: {{ s.mobile_padding_top }}px;
    padding-bottom: {{ s.mobile_padding_bottom }}px;
  }
}
{% endstyle %}

{% style %}
.sba *, .sba *::before, .sba *::after { box-sizing: border-box; }
.sba__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20px;
}
.sba--image-right .sba__media { order: 2; }

/* ---------- Compare (same mechanics as Honest Results) ---------- */
.sba__media {
  position: relative;
  min-height: var(--sba-height);
  border-radius: 16px;
  overflow: hidden;
  background: var(--sba-ui);
  isolation: isolate;
}
.sba__compare {
  --pos: var(--sba-start, 50%);
  position: absolute;
  inset: 0;
  overflow: hidden;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
}
.sba__compare.is-split { cursor: ew-resize; }
.sba__layer { position: absolute; inset: 0; overflow: hidden; }
.sba__layer--after { z-index: 1; clip-path: inset(0 0 0 var(--pos)); }
.sba .sba__layer img,
.sba .sba__layer .sba__ph {
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  pointer-events: none;
  -webkit-user-drag: none;
}
.sba .sba__layer .sba__ph { background: #E9E1D8; fill: rgba(40, 32, 31, 0.2); }
.sba__line {
  position: absolute;
  z-index: 2;
  top: 0;
  bottom: 0;
  left: var(--pos);
  width: 1.5px;
  transform: translateX(-50%);
  background: var(--sba-ui);
  pointer-events: none;
}
.sba__handle {
  position: absolute;
  z-index: 3;
  top: 50%;
  left: var(--pos);
  width: 38px;
  height: 65px;
  border-radius: 19px;
  transform: translate(-50%, -50%);
  background: var(--sba-ui);
  color: var(--sba-text);
  pointer-events: none;
  transition: box-shadow 0.2s ease;
}
.sba__handle svg { display: block; width: 100%; height: 100%; }
.sba .sba__label {
  position: absolute;
  z-index: 4;
  top: 14px;
  padding: 5px 12px;
  border-radius: 30px;
  font-family: 'Blauer Nue RG', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.2;
  letter-spacing: -0.02em;
  pointer-events: none;
}
.sba .sba__label--before { left: 14px; background: var(--sba-text); color: #FFFFFF; }
.sba .sba__label--after { right: 14px; background: #FFFFFF; color: var(--sba-text); }
.sba .sba__range {
  -webkit-appearance: none;
  appearance: none;
  position: absolute;
  z-index: 5;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  opacity: 0;
  background: transparent;
  pointer-events: none;
}
.sba .sba__range:focus-visible ~ .sba__handle { box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--sba-text); }

/* ---------- Card ---------- */
.sba__card {
  min-height: var(--sba-height);
  border-radius: 16px;
  background: var(--sba-card);
  padding: clamp(36px, calc(50 * 100vw / 1920), 50px) clamp(20px, calc(89 * 100vw / 1920), 89px) clamp(40px, calc(74 * 100vw / 1920), 74px);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sba .sba__heading {
  margin: 0 0 clamp(28px, calc(40 * 100vw / 1920), 40px);
  font-family: 'Blauer Nue MD', sans-serif;
  font-weight: 500;
  font-size: clamp(var(--sba-h-m), calc(var(--sba-h-num) * 100vw / 1920), var(--sba-h));
  line-height: 1.2;
  letter-spacing: -0.02em;
  text-align: center;
  text-transform: none;
  color: var(--sba-text);
}
.sba .sba__heading p { margin: 0; font: inherit; letter-spacing: inherit; color: inherit; }
.sba .sba__heading em {
  font-family: 'Test Tiempos Fine Italic RG', serif;
  font-style: italic;
  font-weight: 400;
  line-height: 1.212;
}
.sba--em-break .sba__heading em { display: block; }

.sba__lists {
  display: flex;
  justify-content: center;
  gap: 10px;
  width: 100%;
}
.sba__box {
  flex: 0 1 331px;
  min-width: 0;
  margin: 0;
  padding: 30px clamp(16px, calc(33 * 100vw / 1920), 33px) 34px;
  border-radius: 10px;
  background: var(--sba-box);
  list-style: none;
}
.sba__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  margin: 0;
  padding: 0;
  text-align: center;
}
/* 26px · 1px divider · 26px between items */
.sba__item + .sba__item {
  margin-top: 26px;
  padding-top: 25px;   /* 26 + 1px divider + 25 = Figma's 52px pitch */
  border-top: 1px solid var(--sba-divider);
}
.sba__badge {
  position: relative;
  flex: none;
  width: 32px;
  height: 20px;
  border-radius: 50px;
  color: var(--sba-badge-icon);
}
.sba__badge--no { background: var(--sba-no); }
.sba__badge--yes { background: var(--sba-yes); }
.sba__badge svg { position: absolute; left: 10px; display: block; }
.sba__badge--no svg { top: 4px; width: 12px; height: 12px; }
.sba__badge--yes svg { top: 5px; width: 12px; height: 10px; }
/* Montserrat 400 18/25.2 -0.02em, #28201F */
.sba__text {
  font-family: var(--sba-list-font);
  font-weight: var(--sba-list-weight);
  font-size: clamp(15px, calc(18 * 100vw / 1920), 18px);
  line-height: 1.4;
  letter-spacing: -0.02em;
  color: var(--sba-text);
  overflow-wrap: break-word;
}
.sba__sr {
  position: absolute !important;
  width: 1px; height: 1px;
  margin: -1px; padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
.sba__empty { margin: 0; font-family: 'Blauer Nue RG', sans-serif; font-size: 15px; color: var(--sba-text); }

/* ---------- Stacked (≤1100) ---------- */
@media screen and (max-width: 1100px) {
  .sba__grid { grid-template-columns: minmax(0, 1fr); }
  .sba--image-right .sba__media { order: 0; }
  .sba__media { min-height: 0; aspect-ratio: var(--sba-m-ratio); }
  .sba__card { min-height: 0; }
}
@media screen and (max-width: 768px) {
  .sba .sba__heading { font-size: var(--sba-h-m); margin-bottom: 24px; }
  .sba__card { padding: 32px 16px 24px; }
  .sba .sba__label { font-size: 12px; padding: 4px 10px; top: 10px; }
  .sba .sba__label--before { left: 10px; }
  .sba .sba__label--after { right: 10px; }
  .sba__handle { width: 32px; height: 54px; border-radius: 16px; }
  .sba__box { padding: 20px 12px 22px; }
  .sba__item + .sba__item { margin-top: 18px; padding-top: 18px; }
}
@media screen and (max-width: 560px) {
  .sba__lists { flex-direction: column; }
  .sba__box { flex: none; }
  .sba__text { font-size: 15px; }
}
{% endstyle %}

{%- capture handle_icon -%}{{ 'cio-compare-chevrons.svg' | inline_asset_content }}{%- endcapture -%}
{%- capture icon_no -%}<span class="sba__badge sba__badge--no" aria-hidden="true">{{ 'cio-badge-x-glyph.svg' | inline_asset_content }}</span>{%- endcapture -%}
{%- capture icon_yes -%}<span class="sba__badge sba__badge--yes" aria-hidden="true">{{ 'cio-badge-check-glyph.svg' | inline_asset_content }}</span>{%- endcapture -%}

<div class="sba{% if s.italic_new_line %} sba--em-break{% endif %}{% if s.image_position == 'right' %} sba--image-right{% endif %}{% if s.custom_class != blank %} {{ s.custom_class | escape }}{% endif %}" data-sba>
  <div class="main-container">
    <div class="sba__grid">

      <div class="sba__media">
        <div class="sba__compare{% if has_split %} is-split{% endif %}" data-sba-compare>
          <div class="sba__layer sba__layer--before">
            {%- if s.before_image != blank -%}
              {%- assign before_alt = s.before_image.alt | default: s.before_label | escape -%}
              {{- s.before_image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 1101px) 45vw, 100vw', loading: 'lazy', alt: before_alt, draggable: 'false' -}}
            {%- else -%}
              {{- 'lifestyle-1' | placeholder_svg_tag: 'sba__ph' -}}
            {%- endif -%}
          </div>
          {%- if s.after_image != blank -%}
            <div class="sba__layer sba__layer--after">
              {%- assign after_alt = s.after_image.alt | default: s.after_label | escape -%}
              {{- s.after_image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 1101px) 45vw, 100vw', loading: 'lazy', alt: after_alt, draggable: 'false' -}}
            </div>
          {%- endif -%}
          {%- if has_split -%}
            <div class="sba__line" aria-hidden="true"></div>
            <input
              class="sba__range"
              type="range"
              min="0"
              max="100"
              step="1"
              value="{{ compare_start }}"
              aria-label="{{ s.before_label | default: 'Before' | escape }} / {{ s.after_label | default: 'After' | escape }}"
              aria-valuetext="{{ compare_start }}%"
              data-sba-range
            >
            <div class="sba__handle" aria-hidden="true">{{ handle_icon }}</div>
          {%- endif -%}
          {%- if s.before_label != blank -%}
            <span class="sba__label sba__label--before" aria-hidden="true">{{ s.before_label | escape }}</span>
          {%- endif -%}
          {%- if s.after_label != blank and s.after_image != blank -%}
            <span class="sba__label sba__label--after" aria-hidden="true">{{ s.after_label | escape }}</span>
          {%- endif -%}
        </div>
      </div>

      <div class="sba__card">
        {%- if s.heading != blank -%}
          <h2 class="sba__heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if before_count > 0 or after_count > 0 -%}
          <div class="sba__lists">
            {%- if before_count > 0 -%}
              <ul class="sba__box" role="list" aria-label="{{ s.before_list_label | escape }}">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'before_point' and block.settings.text != blank -%}
                    <li class="sba__item" {{ block.shopify_attributes }}>
                      {{ icon_no }}
                      <span class="sba__text">{{ block.settings.text | escape | newline_to_br }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if after_count > 0 -%}
              <ul class="sba__box" role="list" aria-label="{{ s.after_list_label | escape }}">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'after_point' and block.settings.text != blank -%}
                    <li class="sba__item" {{ block.shopify_attributes }}>
                      {{ icon_yes }}
                      <span class="sba__text">{{ block.settings.text | escape | newline_to_br }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- elsif request.design_mode -%}
          <p class="sba__empty">Add "Before point" and "After point" blocks.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};

    function init(root) {
      if (!root || root._sbaInit) return;
      var compare = root.querySelector('[data-sba-compare]');
      var range = root.querySelector('[data-sba-range]');
      if (!compare || !range) return;
      root._sbaInit = true;
      var ac = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var offs = [];
      function on(el, type, fn, opts) {
        var o = opts || {};
        if (ac) { o.signal = ac.signal; el.addEventListener(type, fn, o); }
        else { el.addEventListener(type, fn, o); offs.push(function () { el.removeEventListener(type, fn, o); }); }
      }
      function setPos(v) {
        v = Math.round(Math.min(100, Math.max(0, v)) * 10) / 10;
        compare.style.setProperty('--pos', v + '%');
        range.value = v;
        range.setAttribute('aria-valuetext', Math.round(v) + '%');
      }
      function fromEvent(e) {
        var r = compare.getBoundingClientRect();
        if (r.width) setPos(((e.clientX - r.left) / r.width) * 100);
      }
      setPos(parseFloat(range.value));

      var dragging = false, pending = false, pointerId = null, startX = 0, startY = 0, stop;
      function begin(e) {
        dragging = true; pending = false;
        try { compare.setPointerCapture(pointerId); } catch (err) {}
        fromEvent(e);
      }
      on(compare, 'pointerdown', function (e) {
        if (pointerId !== null) return;
        if (e.pointerType === 'mouse') {
          if (e.button !== 0) return;
          pointerId = e.pointerId; e.preventDefault(); begin(e); return;
        }
        // Touch / pen: only start once the gesture is clearly horizontal, so vertical scroll still works
        pointerId = e.pointerId; pending = true; startX = e.clientX; startY = e.clientY;
      });
      on(compare, 'pointermove', function (e) {
        if (e.pointerId !== pointerId) return;
        if (dragging && e.pointerType === 'mouse' && !(e.buttons & 1)) { stop(e); return; }
        if (pending) {
          var dx = Math.abs(e.clientX - startX), dy = Math.abs(e.clientY - startY);
          if (dx > 6 && dx > dy) begin(e);
          return;
        }
        if (dragging) fromEvent(e);
      });
      stop = function (e) {
        if (pointerId === null || (e && e.pointerId !== pointerId)) return;
        if (pending && e && e.type === 'pointerup') fromEvent(e);   // a tap moves the divider there
        if (dragging) { try { compare.releasePointerCapture(pointerId); } catch (err) {} }
        dragging = false; pending = false; pointerId = null;
      };
      on(compare, 'pointerup', stop);
      on(compare, 'pointercancel', stop);
      on(compare, 'dragstart', function (e) { e.preventDefault(); });
      on(range, 'input', function () { setPos(parseFloat(range.value)); });

      root._sbaCleanup = function () {
        if (ac) ac.abort();
        offs.forEach(function (f) { f(); });
        root._sbaInit = false;
      };
    }

    function rootFor(id) {
      var host = document.getElementById('shopify-section-' + id);
      return host && host.querySelector('[data-sba]');
    }
    if (rootFor(SECTION_ID)) init(rootFor(SECTION_ID));
    else document.addEventListener('DOMContentLoaded', function () { init(rootFor(SECTION_ID)); });

    if (!window.__sbaEditorBound) {
      window.__sbaEditorBound = true;
      document.addEventListener('shopify:section:load', function (e) { init(rootFor(e.detail.sectionId)); });
      document.addEventListener('shopify:section:unload', function (e) {
        var r = rootFor(e.detail.sectionId);
        if (r && r._sbaCleanup) r._sbaCleanup();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Set Before After",
  "tag": "section",
  "class": "sba-section",
  "settings": [
    { "type": "header", "content": "Before / after images" },
    { "type": "image_picker", "id": "before_image", "label": "Before image", "info": "850 × 700 in the design." },
    { "type": "image_picker", "id": "after_image", "label": "After image", "info": "Same framing as the before image. The slider reveals it." },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "BEFORE" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "AFTER" },
    { "type": "range", "id": "compare_start", "label": "Slider start position", "min": 5, "max": 95, "step": 1, "unit": "%", "default": 50 },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ],
      "default": "left"
    },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 500, "max": 900, "step": 10, "unit": "px", "default": 700 },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Image shape on tablet and mobile",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "850 / 700", "label": "Design (850 × 700)" }
      ],
      "default": "1 / 1"
    },
    { "type": "header", "content": "Card" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Before This Set <em>After This Set</em></p>" },
    { "type": "checkbox", "id": "italic_new_line", "label": "Put italic text on its own line", "default": true },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 30, "max": 80, "step": 1, "unit": "px", "default": 58 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 28 },
    { "type": "font_picker", "id": "list_font", "label": "List font", "info": "Design uses Montserrat Regular.", "default": "montserrat_n4" },
    { "type": "text", "id": "before_list_label", "label": "Screen reader name: before list", "default": "Before this set" },
    { "type": "text", "id": "after_list_label", "label": "Screen reader name: after list", "default": "After this set" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_background", "label": "Section background", "default": "#FFFCF9" },
    { "type": "color", "id": "card_bg", "label": "Card", "default": "#FFFFFF" },
    { "type": "color", "id": "box_bg", "label": "List boxes", "default": "#F5EEE6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#28201F" },
    { "type": "color", "id": "before_badge_color", "label": "Before badge (cross)", "default": "#F00009" },
    { "type": "color", "id": "after_badge_color", "label": "After badge (check)", "default": "#228761" },
    { "type": "color", "id": "badge_icon_color", "label": "Badge icon", "default": "#FFFFFF" },
    { "type": "color", "id": "compare_ui_color", "label": "Slider line and handle", "default": "#F5EEE6" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class" }
  ],
  "blocks": [
    {
      "type": "before_point",
      "name": "Before point",
      "limit": 6,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "info": "Press Enter for a line break.", "default": "No consistent AM/PM\ncleanse" }
      ]
    },
    {
      "type": "after_point",
      "name": "After point",
      "limit": 6,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "info": "Press Enter for a line break.", "default": "2-step routine, morning\nand night" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Set Before After",
      "blocks": [
        { "type": "before_point", "settings": { "text": "No consistent AM/PM\ncleanse" } },
        { "type": "before_point", "settings": { "text": "No leave-on moisture\nstep" } },
